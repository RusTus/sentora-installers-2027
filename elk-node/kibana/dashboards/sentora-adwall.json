   "grid": {
    "h": 2,
    "w": 48,
    "x": 0,
    "y": 0
   },
   "type": "links"
  },
  {
   "config": {
    "breakdown_by": {
     "columns": 3,
     "fields": [
      "host.name"
     ],
     "label": "Machine",
     "limit": 3,
     "operation": "terms",
     "rank_by": {
      "direction": "asc",
      "type": "alphabetical"
     }
    },
    "data_source": {
     "ref_id": "sentora-windows",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "color": {
       "range": "absolute",
       "steps": [
        {
         "color": "#F2C94C",
         "lt": 1
        },
        {
         "color": "#24C28A",
         "gte": 1
        }
       ],
       "type": "dynamic"
      },
      "format": {
       "decimals": 0,
       "type": "number"
      },
      "formula": "count(kql='@timestamp >= \"now-1h\"')",
      "label": "events",
      "operation": "formula",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "host.name : *",
     "language": "kql"
    },
    "title": "Domain controllers (events in the last hour)",
    "type": "metric"
   },
   "grid": {
    "h": 7,
    "w": 48,
