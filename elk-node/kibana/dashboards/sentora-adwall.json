     "rank_by": {
      "direction": "desc",
      "metric_index": 0,
      "type": "metric"
     }
    },
    "data_source": {
     "ref_id": "sentora-windows",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "color": {
       "range": "absolute",
       "steps": [
        {
         "color": "#24C28A",
         "lt": 5
        },
        {
         "color": "#F2C94C",
         "gte": 5,
         "lt": 15
        },
        {
         "color": "#EB5757",
         "gte": 15
        }
       ],
       "type": "dynamic"
      },
      "label": "tries",
      "operation": "count",
      "type": "primary"
     },
     {
      "field": "windows.reason",
      "label": "",
      "operation": "last_value",
      "time_field": "@timestamp",
      "type": "secondary"
     }
    ],
    "query": {
     "expression": "event.outcome : \"failure\" and not event.action : \"locked-out\" and @timestamp >= \"now-1h\"",
     "language": "kql"
    },
