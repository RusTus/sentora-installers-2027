   },
   "grid": {
    "h": 15,
    "w": 24,
    "x": 24,
    "y": 15
   },
   "type": "vis"
  },
  {
   "config": {
    "layers": [
     {
      "breakdown_by": {
       "fields": [
        "event.action"
       ],
       "label": "What",
       "limit": 6,
       "operation": "terms"
      },
      "data_source": {
       "ref_id": "sentora-windows",
       "type": "data_view_reference"
      },
      "type": "area_stacked",
      "x": {
       "field": "@timestamp",
       "operation": "date_histogram"
      },
      "y": [
       {
        "label": "Events",
        "operation": "count"
       }
      ]
     }
    ],
    "legend": {
     "position": "right",
     "visibility": "visible"
    },
    "query": {
     "expression": "event.action : (\"logon\" or \"kerberos-logon\" or \"logon-failed\" or \"kerberos-failed\" or \"ntlm-failed\" or \"locked-out\")",
     "language": "kql"
    },
    "title": "Logons and failures over time",
    "type": "xy"
   },
   "grid": {
    "h": 11,
    "w": 32,
    "x": 0,
    "y": 30
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-windows",
     "type": "data_view_reference"
    },
    "group_by": [
     {
      "fields": [
       "windows.reason"
      ],
      "label": "Why",
      "limit": 6,
      "operation": "terms"
     }
    ],
    "metrics": [
     {
      "label": "Lines",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "event.outcome : \"failure\" and not event.action : \"locked-out\" and windows.reason : *",
     "language": "kql"
    },
    "styling": {
     "donut_hole": "m"
    },
    "title": "Why logons failed",
    "type": "pie"
   },
   "grid": {
    "h": 11,
    "w": 16,
    "x": 32,
    "y": 30
   },
   "type": "vis"
  }
 ],
 "refresh_interval": {
  "pause": false,
  "value": 30000
 },
 "time_range": {
  "from": "now-24h",
  "to": "now"
 },
 "title": "Sentora: AD wall"
}
