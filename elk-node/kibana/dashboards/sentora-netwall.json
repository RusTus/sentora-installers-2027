  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-fortigate",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "color": {
       "color": "#4FA3F7",
       "type": "static"
      },
      "format": {
       "suffix": "/s",
       "type": "bytes"
      },
      "formula": "sum(network.bytes) / 300",
      "label": "in and out",
      "operation": "formula",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "network.bytes : * and @timestamp >= \"now-5m\"",
     "language": "kql"
    },
    "title": "Internet now",
    "type": "metric"
   },
   "grid": {
    "h": 6,
    "w": 8,
    "x": 0,
