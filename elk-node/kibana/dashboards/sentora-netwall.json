       "type": "dynamic"
      },
      "label": "",
      "operation": "count",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "event.category : \"vpn\" and not fortigate.vpn.kind : \"site-to-site\" and event.outcome : \"failure\" and @timestamp >= \"now-1h\"",
