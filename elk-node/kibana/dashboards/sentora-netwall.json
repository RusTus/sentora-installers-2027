  {
   "config": {
    "breakdown_by": {
     "columns": 2,
     "fields": [
      "fortigate.vpn.name"
     ],
     "label": "Tunnel",
     "limit": 8,
     "operation": "terms",
     "rank_by": {
      "direction": "asc",
      "type": "alphabetical"
     }
    },
    "data_source": {
     "ref_id": "sentora-fortigate",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "color": {
       "range": "absolute",
       "steps": [
        {
         "color": "#EB5757",
         "lt": 1
        },
        {
         "color": "#24C28A",
         "gte": 1
        }
       ],
       "type": "dynamic"
      },
      "field": "fortigate.vpn.up",
      "format": {
       "decimals": 0,
       "type": "percent"
      },
      "label": "up",
      "operation": "last_value",
      "time_field": "@timestamp",
      "type": "primary"
     },
     {
      "field": "source.ip",
      "label": "other end",
      "operation": "last_value",
      "time_field": "@timestamp",
      "type": "secondary"
     }
    ],
    "query": {
     "expression": "event.category : \"vpn\" and fortigate.vpn.kind : \"site-to-site\" and fortigate.vpn.up : *",
     "language": "kql"
    },
    "title": "Tunnels to the other sites (up or down)",
    "type": "metric"
