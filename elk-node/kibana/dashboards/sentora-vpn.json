  {
   "config": {
    "data_source": {
     "ref_id": "sentora-fortigate",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "label": "Updates",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "event.category : \"vpn\" and not fortigate.vpn.kind : \"site-to-site\" and event.action : (\"tunnel-up\" or \"tunnel-stats\") and @timestamp >= \"now-15m\"",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "user.name"
      ],
      "label": "Name",
      "limit": 25,
      "operation": "terms"
     },
     {
      "fields": [
       "source.ip"
      ],
      "label": "Address",
      "limit": 25,
      "operation": "terms"
     }
    ],
    "title": "Connected in the last 15 minutes",
    "type": "data_table"
   },
   "grid": {
    "h": 14,
    "w": 24,
    "x": 0,
    "y": 7
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-fortigate",
     "type": "data_view_reference"
    },
    "metric": {
     "label": "Lines",
     "operation": "count"
    },
    "query": {
     "expression": "event.category : \"vpn\" and not fortigate.vpn.kind : \"site-to-site\"",
     "language": "kql"
    },
    "region": {
     "fields": [
      "source.geo.country_iso_code"
     ],
     "limit": 100,
     "operation": "terms"
    },
    "title": "Where VPN users connect from",
    "type": "region_map"
   },
   "grid": {
    "h": 14,
    "w": 24,
    "x": 24,
    "y": 7
   },
   "type": "vis"
  },
  {
   "config": {
    "layers": [
