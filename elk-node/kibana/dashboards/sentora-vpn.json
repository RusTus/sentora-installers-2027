       ],
       "label": "What",
       "limit": 2,
       "operation": "terms"
      },
      "data_source": {
       "ref_id": "sentora-fortigate",
       "type": "data_view_reference"
      },
      "type": "bar_stacked",
      "x": {
       "field": "@timestamp",
       "operation": "date_histogram"
      },
      "y": [
       {
        "label": "Times",
        "operation": "count"
       }
      ]
     }
    ],
    "legend": {
     "position": "right",
     "visibility": "visible"
    },
    "query": {
     "expression": "event.category : \"vpn\" and not fortigate.vpn.kind : \"site-to-site\" and event.action : (\"tunnel-up\" or \"tunnel-down\")",
     "language": "kql"
    },
    "title": "Connections over time",
    "type": "xy"
   },
   "grid": {
    "h": 12,
    "w": 24,
    "x": 0,
    "y": 21
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-fortigate",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "label": "Times",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "event.category : \"vpn\" and not fortigate.vpn.kind : \"site-to-site\" and event.outcome : \"failure\"",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "user.name"
      ],
      "label": "Name",
      "limit": 15,
      "operation": "terms"
     },
     {
      "fields": [
       "source.ip"
      ],
      "label": "Address",
      "limit": 15,
      "operation": "terms"
     }
    ],
    "title": "Failed VPN logins",
