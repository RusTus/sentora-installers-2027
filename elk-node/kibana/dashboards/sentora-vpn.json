   },
   "grid": {
    "h": 12,
    "w": 24,
    "x": 24,
    "y": 21
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-fortigate",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "field": "network.bytes",
      "format": {
       "type": "bytes"
      },
      "label": "Data",
      "operation": "sum"
     },
     {
      "label": "Lines",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "event.category : \"vpn\" and not fortigate.vpn.kind : \"site-to-site\" and event.action : \"tunnel-down\"",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "user.name"
      ],
      "label": "Name",
      "limit": 15,
      "operation": "terms",
      "rank_by": {
       "direction": "desc",
       "metric_index": 0,
       "type": "metric"
      }
     }
    ],
    "title": "Data over VPN, by person",
    "type": "data_table"
   },
   "grid": {
    "h": 12,
    "w": 24,
    "x": 0,
    "y": 33
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-fortigate",
     "type": "data_view_reference"
    },
    "group_by": [
     {
      "fields": [
       "fortigate.vpn.tunnel"
      ],
      "label": "Kind of tunnel",
      "limit": 4,
      "operation": "terms"
     }
    ],
    "metrics": [
     {
      "label": "Connections",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "event.category : \"vpn\" and not fortigate.vpn.kind : \"site-to-site\" and event.action : \"tunnel-up\"",
     "language": "kql"
    },
    "title": "Kind of tunnel",
    "type": "pie"
   },
   "grid": {
    "h": 12,
    "w": 24,
    "x": 24,
    "y": 33
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-fortigate",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "field": "@timestamp",
      "label": "Last seen up",
      "operation": "max"
     },
     {
      "field": "event.action",
      "label": "Last event",
      "operation": "last_value",
      "time_field": "@timestamp"
     }
    ],
    "query": {
     "expression": "event.category : \"vpn\" and fortigate.vpn.kind : \"site-to-site\"",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "fortigate.vpn.name"
      ],
      "label": "Tunnel",
      "limit": 30,
      "operation": "terms"
     },
     {
      "fields": [
       "source.ip"
      ],
      "label": "Other end",
      "limit": 3,
      "operation": "terms"
     }
    ],
    "title": "Site-to-site tunnels (to other offices)",
    "type": "data_table"
   },
   "grid": {
    "h": 12,
    "w": 48,
    "x": 0,
    "y": 45
   },
   "type": "vis"
  }
 ],
