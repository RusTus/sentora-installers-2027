    "metrics": [
     {
      "field": "user.name",
      "label": "",
      "operation": "unique_count",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "event.category : \"vpn\" and not fortigate.vpn.kind : \"site-to-site\" and event.action : \"tunnel-up\"",
