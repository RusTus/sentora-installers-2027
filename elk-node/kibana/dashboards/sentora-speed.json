{
 "description": "Made by the Sentora Elk node installer; a copy with another name keeps your own changes (an update replaces this one).",
 "panels": [
  {
   "config": {
    "layout": "horizontal",
    "links": [
     {
      "destination": "sentora-today",
      "label": "Today",
      "options": {
       "use_time_range": false
      },
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-serverwall",
      "label": "Server wall",
      "options": {
       "use_time_range": false
      },
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-overview",
      "label": "Overview",
      "options": {
       "use_time_range": false
      },
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-worldmap",
      "label": "World map",
      "options": {
       "use_time_range": false
      },
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-uptime",
      "label": "Uptime",
      "options": {
       "use_time_range": false
      },
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-websites",
      "label": "Websites",
      "options": {
       "use_time_range": false
      },
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-mail",
      "label": "Mail",
      "options": {
       "use_time_range": false
      },
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-delivery",
      "label": "Mail delivery",
      "options": {
       "use_time_range": false
      },
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-security",
      "label": "Security",
      "options": {
       "use_time_range": false
      },
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-attackers",
      "label": "Attackers",
      "options": {
       "use_time_range": false
      },
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-firewall",
      "label": "Web firewall",
      "options": {
       "use_time_range": false
      },
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-panel",
      "label": "Panel and server",
      "options": {
       "use_time_range": false
      },
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-health",
      "label": "Server health",
      "options": {
       "use_time_range": false
      },
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-speed",
      "label": "Website speed",
      "options": {
       "use_time_range": false
      },
      "type": "dashboardLink"
     }
    ]
   },
   "grid": {
    "h": 2,
    "w": 48,
    "x": 0,
    "y": 0
   },
   "type": "links"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "field": "sentora.response_ms",
      "format": {
       "decimals": 0,
       "type": "number"
      },
      "label": "ms",
      "operation": "median",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "sentora.log : \"web-timing\"",
     "language": "kql"
    },
    "title": "Half the pages within",
    "type": "metric"
   },
   "grid": {
    "h": 5,
    "w": 12,
    "x": 0,
    "y": 2
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "field": "sentora.response_ms",
      "format": {
       "decimals": 0,
       "type": "number"
      },
      "label": "ms",
      "operation": "percentile",
      "percentile": 95,
      "type": "primary"
     }
    ],
    "query": {
     "expression": "sentora.log : \"web-timing\"",
     "language": "kql"
    },
    "title": "95 in 100 pages within",
    "type": "metric"
   },
   "grid": {
    "h": 5,
    "w": 12,
    "x": 12,
    "y": 2
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "label": "",
      "operation": "count",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "sentora.log : \"web-timing\" and sentora.response_ms >= 2000",
     "language": "kql"
    },
    "title": "Slow pages (over 2 seconds)",
    "type": "metric"
   },
   "grid": {
    "h": 5,
    "w": 12,
    "x": 24,
    "y": 2
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "label": "",
      "operation": "count",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "sentora.log : \"web-timing\" and sentora.status_class : \"5xx\"",
     "language": "kql"
    },
    "title": "Server errors (5xx)",
    "type": "metric"
   },
   "grid": {
    "h": 5,
    "w": 12,
    "x": 36,
    "y": 2
   },
   "type": "vis"
  },
  {
   "config": {
    "layers": [
     {
      "breakdown_by": {
       "fields": [
        "sentora.domain"
       ],
       "label": "Website",
       "limit": 8,
       "operation": "terms",
       "rank_by": {
        "direction": "asc",
        "type": "alphabetical"
       }
      },
      "data_source": {
       "ref_id": "sentora-logs",
       "type": "data_view_reference"
      },
      "type": "line",
      "x": {
       "field": "@timestamp",
       "operation": "date_histogram"
      },
      "y": [
       {
        "field": "sentora.response_ms",
        "format": {
         "decimals": 0,
         "type": "number"
        },
        "label": "ms",
        "operation": "average"
       }
      ]
     }
    ],
    "legend": {
     "position": "right",
     "visibility": "visible"
    },
    "query": {
     "expression": "sentora.log : \"web-timing\"",
     "language": "kql"
    },
    "title": "How long pages take, by website (average, ms)",
    "type": "xy"
   },
   "grid": {
    "h": 12,
    "w": 48,
    "x": 0,
    "y": 7
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "field": "sentora.response_ms",
      "format": {
       "decimals": 0,
       "type": "number"
      },
      "label": "Average ms",
      "operation": "average"
     },
     {
      "field": "sentora.response_ms",
      "format": {
       "decimals": 0,
       "type": "number"
      },
      "label": "95% within ms",
      "operation": "percentile",
      "percentile": 95
     },
     {
      "label": "Requests",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "sentora.log : \"web-timing\"",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "url.path"
      ],
      "label": "Page",
      "limit": 15,
      "operation": "terms",
      "rank_by": {
       "direction": "desc",
       "metric_index": 0,
       "type": "metric"
      }
     }
    ],
    "title": "Slowest pages",
    "type": "data_table"
   },
   "grid": {
    "h": 14,
    "w": 24,
    "x": 0,
    "y": 19
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "field": "sentora.response_ms",
      "format": {
       "decimals": 0,
       "type": "number"
      },
      "label": "Average ms",
      "operation": "average"
     },
     {
      "field": "sentora.response_ms",
      "format": {
       "decimals": 0,
       "type": "number"
      },
      "label": "95% within ms",
      "operation": "percentile",
      "percentile": 95
     },
     {
      "label": "Requests",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "sentora.log : \"web-timing\"",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "sentora.domain"
      ],
      "label": "Website",
      "limit": 15,
      "operation": "terms",
      "rank_by": {
       "direction": "desc",
       "metric_index": 0,
       "type": "metric"
      }
     }
    ],
    "title": "Slowest websites",
    "type": "data_table"
   },
   "grid": {
    "h": 14,
    "w": 24,
    "x": 24,
    "y": 19
   },
   "type": "vis"
  },
  {
   "config": {
    "layers": [
     {
      "breakdown_by": {
       "fields": [
        "sentora.domain"
       ],
       "label": "Website",
       "limit": 6,
       "operation": "terms"
      },
      "data_source": {
       "ref_id": "sentora-logs",
       "type": "data_view_reference"
      },
      "type": "bar_stacked",
      "x": {
       "field": "@timestamp",
       "operation": "date_histogram"
      },
      "y": [
       {
        "label": "Pages",
        "operation": "count"
       }
      ]
     }
    ],
    "legend": {
     "position": "right",
     "visibility": "visible"
    },
    "query": {
     "expression": "sentora.log : \"web-timing\" and sentora.response_ms >= 2000",
     "language": "kql"
    },
    "title": "Slow pages over time (over 2 seconds)",
    "type": "xy"
   },
   "grid": {
    "h": 12,
    "w": 24,
    "x": 0,
    "y": 33
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "label": "Errors",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "sentora.log : \"web-timing\" and sentora.status_class : \"5xx\"",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "sentora.domain"
      ],
      "label": "Website",
      "limit": 15,
      "operation": "terms"
     },
     {
      "fields": [
       "url.path"
      ],
      "label": "Page",
      "limit": 15,
      "operation": "terms"
     }
    ],
    "title": "Pages with server errors (5xx)",
    "type": "data_table"
   },
   "grid": {
    "h": 12,
    "w": 24,
    "x": 24,
    "y": 33
   },
   "type": "vis"
  },
  {
   "config": {
    "content": "How long the server took for each request, from the panel's Apache (the time until the last byte went out). Pages are shown without what follows the ?, so no search words or tokens are kept. For a shop: the checkout and cart pages are the ones to watch."
   },
   "grid": {
    "h": 3,
    "w": 48,
    "x": 0,
    "y": 45
   },
   "type": "markdown"
  }
 ],
 "refresh_interval": {
  "pause": false,
  "value": 60000
 },
 "time_range": {
  "from": "now-24h",
  "to": "now"
 },
 "title": "Sentora: Website speed"
}
