        "label": "Today",
        "operation": "sum"
       }
      ]
     },
     {
      "data_source": {
       "ref_id": "sentora-shop",
       "type": "data_view_reference"
      },
      "type": "line",
      "x": {
       "field": "@timestamp",
       "operation": "date_histogram",
       "suggested_interval": "1h"
      },
      "y": [
       {
        "field": "sentora.shop.base_total",
        "format": {
         "decimals": 2,
         "type": "number"
        },
