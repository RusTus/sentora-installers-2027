    },
    "metrics": [
     {
      "field": "sentora.shop.popularity",
      "label": "Times",
      "operation": "max"
     }
    ],
    "query": {
     "expression": "sentora.shop.kind : \"search\" and sentora.shop.results : 0",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "sentora.shop.term"
      ],
      "label": "Searched for",
      "limit": 10,
      "operation": "terms",
      "rank_by": {
       "direction": "desc",
       "metric_index": 0,
       "type": "metric"
      }
     }
    ],
    "title": "Searches that found nothing",
    "type": "data_table"
   },
   "grid": {
    "h": 13,
    "w": 12,
    "x": 36,
    "y": 22
   },
   "type": "vis"
  }
 ],
