  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-shop",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "field": "@timestamp",
      "label": "When",
      "operation": "max"
     },
     {
      "field": "sentora.shop.base_total",
      "format": {
       "decimals": 2,
       "type": "number"
      },
      "label": "Total",
      "operation": "sum"
     },
     {
      "field": "sentora.shop.status",
      "label": "Status",
      "operation": "last_value",
      "time_field": "@timestamp"
     },
     {
      "field": "sentora.shop.country",
      "label": "Country",
      "operation": "last_value",
      "time_field": "@timestamp"
     }
    ],
    "query": {
     "expression": "sentora.shop.kind : \"order\"",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "sentora.shop.number"
      ],
      "label": "Order",
      "limit": 10,
      "operation": "terms",
      "rank_by": {
       "direction": "desc",
       "metric_index": 0,
       "type": "metric"
      }
     }
    ],
    "title": "Latest orders",
    "type": "data_table"
   },
   "grid": {
    "h": 13,
    "w": 24,
    "x": 0,
    "y": 22
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-shop",
     "type": "data_view_reference"
    },
    "group_by": [
     {
      "fields": [
       "sentora.shop.country"
      ],
      "label": "Country",
      "limit": 6,
      "operation": "terms"
     }
    ],
    "metrics": [
     {
      "field": "sentora.shop.base_total",
      "format": {
       "decimals": 2,
       "type": "number"
      },
      "label": "Sales",
      "operation": "sum"
     }
    ],
    "query": {
     "expression": "sentora.shop.kind : \"order\" and not sentora.shop.state : (\"canceled\" or \"closed\") and sentora.shop.country : *",
     "language": "kql"
    },
    "styling": {
     "donut_hole": "m"
    },
    "title": "Where orders go",
    "type": "pie"
   },
