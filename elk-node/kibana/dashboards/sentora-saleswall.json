     {
      "field": "sentora.shop.qty",
      "label": "Sold",
      "operation": "sum"
     }
    ],
    "query": {
     "expression": "sentora.shop.kind : \"item\" and not sentora.shop.status : (\"canceled\" or \"closed\")",
