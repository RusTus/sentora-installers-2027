    },
    "metrics": [
     {
      "field": "email.to.domain",
      "label": "",
      "operation": "unique_count",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "sentora.mail.status : \"sent\"",
     "language": "kql"
    },
