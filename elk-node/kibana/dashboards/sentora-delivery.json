  },
  {
   "config": {
    "layers": [
     {
      "breakdown_by": {
       "fields": [
        "sentora.mail.status"
       ],
       "label": "Result",
       "limit": 4,
       "operation": "terms"
      },
      "data_source": {
       "ref_id": "sentora-logs",
       "type": "data_view_reference"
      },
      "type": "bar_stacked",
      "x": {
       "field": "@timestamp",
       "operation": "date_histogram"
      },
      "y": [
       {
        "label": "Mails",
        "operation": "count"
       }
      ]
     }
    ],
    "legend": {
     "position": "right",
     "visibility": "visible"
    },
    "query": {
     "expression": "sentora.mail.status : (\"sent\" or \"bounced\" or \"deferred\" or \"expired\")",
     "language": "kql"
    },
    "title": "Delivery results",
    "type": "xy"
   },
   "grid": {
    "h": 12,
    "w": 32,
    "x": 0,
    "y": 7
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "group_by": [
     {
      "fields": [
       "sentora.mail.status"
      ],
      "label": "Result",
      "limit": 2,
      "operation": "terms"
     }
    ],
    "metrics": [
     {
      "label": "Mails",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "sentora.mail.status : (\"spam\" or \"clean\")",
