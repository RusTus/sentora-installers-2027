  {
   "config": {
    "layers": [
     {
      "data_source": {
       "ref_id": "sentora-shop",
       "type": "data_view_reference"
      },
      "type": "bar",
      "x": {
       "field": "@timestamp",
       "operation": "date_histogram",
       "suggested_interval": "1d"
      },
      "y": [
       {
        "field": "sentora.shop.base_total",
        "format": {
         "decimals": 2,
         "type": "number"
        },
        "label": "This week",
        "operation": "sum"
       }
      ]
     },
     {
      "data_source": {
       "ref_id": "sentora-shop",
       "type": "data_view_reference"
      },
      "type": "line",
      "x": {
       "field": "@timestamp",
       "operation": "date_histogram",
       "suggested_interval": "1d"
      },
      "y": [
       {
        "field": "sentora.shop.base_total",
        "format": {
         "decimals": 2,
         "type": "number"
        },
        "label": "The week before",
        "operation": "sum",
        "time_shift": "1w"
       }
      ]
     }
    ],
    "legend": {
     "position": "right",
