   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-fortigate",
     "type": "data_view_reference"
    },
    "group_by": [
     {
      "fields": [
       "fortigate.appcat"
      ],
      "label": "Kind of app",
      "limit": 6,
      "operation": "terms"
     }
    ],
    "metrics": [
     {
      "field": "network.bytes",
      "format": {
       "type": "bytes"
      },
      "label": "Data",
      "operation": "sum"
     }
    ],
    "query": {
     "expression": "fortigate.appcat : * and network.bytes : *",
     "language": "kql"
    },
    "styling": {
     "donut_hole": "m"
    },
    "title": "What the internet was used for",
    "type": "pie"
   },
   "grid": {
    "h": 13,
    "w": 16,
    "x": 0,
    "y": 28
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-shop",
     "type": "data_view_reference"
    },
    "group_by": [
     {
      "fields": [
       "sentora.shop.product"
      ],
      "label": "Product",
      "limit": 6,
      "operation": "terms"
     }
    ],
    "metrics": [
     {
      "field": "sentora.shop.qty",
      "label": "Sold",
      "operation": "sum"
     }
    ],
    "query": {
     "expression": "sentora.shop.kind : \"item\" and not sentora.shop.status : (\"canceled\" or \"closed\")",
     "language": "kql"
    },
    "styling": {
     "donut_hole": "m"
    },
    "title": "Best sellers",
    "type": "pie"
   },
   "grid": {
    "h": 13,
    "w": 16,
    "x": 16,
    "y": 28
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-all",
     "type": "data_view_reference"
    },
    "group_by": [
     {
      "fields": [
       "source.geo.country_iso_code"
      ],
      "label": "Country",
      "limit": 6,
      "operation": "terms"
     }
    ],
    "metrics": [
     {
      "label": "Lines",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "(event.outcome : \"failure\" or event.action : waf-* or fortigate.subtype : \"ips\" or event.action : \"ban\") and source.ip : * and not source.ip : (\"10.0.0.0/8\" or \"172.16.0.0/12\" or \"192.168.0.0/16\" or \"127.0.0.0/8\") and source.geo.country_iso_code : *",
     "language": "kql"
    },
    "styling": {
     "donut_hole": "m"
    },
    "title": "Where attacks came from",
    "type": "pie"
   },
   "grid": {
    "h": 13,
    "w": 16,
    "x": 32,
    "y": 28
   },
   "type": "vis"
  }
 ],
 "refresh_interval": {
  "pause": false,
  "value": 60000
 },
 "time_range": {
  "from": "now-7d",
  "to": "now"
 },
 "title": "Sentora: Week in review"
}
