{
 "description": "Made by the Sentora Elk node installer; a copy with another name keeps your own changes (an update replaces this one).",
 "panels": [
  {
   "config": {
    "layout": "horizontal",
    "links": [
     {
      "destination": "sentora-today",
      "label": "Today",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-serverwall",
      "label": "Server wall",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-backupwall",
      "label": "Backup wall",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-overview",
      "label": "Panel: Overview",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-attackers",
      "label": "Attackers",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-fortigate",
      "label": "FortiGate: web",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-vpn",
      "label": "FortiGate: VPN",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-threats",
      "label": "FortiGate: threats",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-internet",
      "label": "Internet use",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-veeam",
      "label": "Veeam backups",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-coverage",
      "label": "Backup coverage",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-m365",
      "label": "Microsoft 365",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-shop",
      "label": "Online store",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-funnel",
      "label": "Store funnel",
      "type": "dashboardLink"
     }
    ]
   },
   "grid": {
    "h": 2,
    "w": 48,
    "x": 0,
    "y": 0
   },
   "type": "links"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-veeam",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "color": {
       "color": "#24C28A",
       "type": "static"
      },
      "field": "veeam_job.name",
      "label": "",
      "operation": "unique_count",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "event.action : (\"job-state\" or \"job-finished\") and veeam_job.health : * and veeam_job.health >= 1",
     "language": "kql"
    },
    "title": "Jobs OK",
    "type": "metric"
   },
   "grid": {
    "h": 6,
    "w": 12,
    "x": 0,
    "y": 2
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-veeam",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "color": {
       "color": "#F2C94C",
       "type": "static"
      },
      "field": "veeam_job.name",
      "label": "",
      "operation": "unique_count",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "event.action : (\"job-state\" or \"job-finished\") and veeam_job.health : * and veeam_job.health >= 0.5 and veeam_job.health < 1",
     "language": "kql"
    },
    "title": "Jobs with warnings",
    "type": "metric"
   },
   "grid": {
    "h": 6,
    "w": 12,
    "x": 12,
    "y": 2
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-veeam",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "color": {
       "color": "#EB5757",
       "type": "static"
      },
      "field": "veeam_job.name",
      "label": "",
      "operation": "unique_count",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "event.action : (\"job-state\" or \"job-finished\") and veeam_job.health : * and veeam_job.health < 0.5",
     "language": "kql"
    },
    "title": "Jobs failed",
    "type": "metric"
   },
   "grid": {
    "h": 6,
    "w": 12,
    "x": 24,
    "y": 2
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-veeam",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "color": {
       "color": "#4FA3F7",
       "type": "static"
      },
      "field": "host.name",
      "label": "",
      "operation": "unique_count",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "event.action : \"coverage\" and @timestamp >= \"now-2h\"",
     "language": "kql"
    },
    "title": "Machines protected",
    "type": "metric"
   },
   "grid": {
    "h": 6,
    "w": 12,
    "x": 36,
    "y": 2
   },
   "type": "vis"
  },
  {
   "config": {
    "breakdown_by": {
     "columns": 5,
     "fields": [
      "veeam_job.name"
     ],
     "label": "Job",
     "limit": 15,
     "operation": "terms",
     "rank_by": {
      "direction": "asc",
      "type": "alphabetical"
     }
    },
    "data_source": {
     "ref_id": "sentora-veeam",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "color": {
       "range": "absolute",
       "steps": [
        {
         "color": "#EB5757",
         "lt": 0.5
        },
        {
         "color": "#F2C94C",
         "gte": 0.5,
         "lt": 1
        },
        {
         "color": "#24C28A",
         "gte": 1
        }
       ],
       "type": "dynamic"
      },
      "field": "veeam_job.health",
      "format": {
       "decimals": 0,
       "type": "percent"
      },
      "label": "health",
      "operation": "last_value",
      "time_field": "@timestamp",
      "type": "primary"
     },
     {
      "field": "veeam_job.result",
      "label": "last result",
      "operation": "last_value",
      "time_field": "@timestamp",
      "type": "secondary"
     }
    ],
    "query": {
     "expression": "event.action : (\"job-state\" or \"job-finished\") and veeam_job.health : *",
     "language": "kql"
    },
    "title": "Backup jobs (each one's last result)",
    "type": "metric"
   },
   "grid": {
    "h": 24,
    "w": 48,
    "x": 0,
    "y": 8
   },
   "type": "vis"
  },
  {
   "config": {
    "breakdown_by": {
     "columns": 6,
     "fields": [
      "host.name"
     ],
     "label": "Machine",
     "limit": 24,
     "operation": "terms",
     "rank_by": {
      "direction": "asc",
      "type": "alphabetical"
     }
    },
    "data_source": {
     "ref_id": "sentora-veeam",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "color": {
       "range": "absolute",
       "steps": [
        {
         "color": "#24C28A",
         "lt": 26
        },
        {
         "color": "#F2C94C",
         "gte": 26,
         "lt": 48
        },
        {
         "color": "#EB5757",
         "gte": 48
        }
       ],
       "type": "dynamic"
      },
      "field": "veeam_job.hours_since",
      "format": {
       "decimals": 0,
       "type": "number"
      },
      "label": "hours ago",
      "operation": "min",
      "type": "primary"
     },
     {
      "field": "veeam_job.platform",
      "label": "",
      "operation": "last_value",
      "time_field": "@timestamp",
      "type": "secondary"
     }
    ],
    "query": {
     "expression": "event.action : \"coverage\" and @timestamp >= \"now-2h\"",
     "language": "kql"
    },
    "title": "Machines (hours since their newest backup)",
    "type": "metric"
   },
   "grid": {
    "h": 26,
    "w": 48,
    "x": 0,
    "y": 32
   },
   "type": "vis"
  },
  {
   "config": {
    "breakdown_by": {
     "columns": 3,
     "fields": [
      "veeam_repo.name"
     ],
     "label": "Repository",
     "limit": 6,
     "operation": "terms",
     "rank_by": {
      "direction": "asc",
      "type": "alphabetical"
     }
    },
    "data_source": {
     "ref_id": "sentora-veeam",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "color": {
       "range": "absolute",
       "steps": [
        {
         "color": "#24C28A",
         "lt": 70
        },
        {
         "color": "#F2C94C",
         "gte": 70,
         "lt": 90
        },
        {
         "color": "#EB5757",
         "gte": 90
        }
       ],
       "type": "dynamic"
      },
      "field": "veeam_repo.used_pct",
      "format": {
       "decimals": 0,
       "suffix": "%",
       "type": "number"
      },
      "label": "used",
      "operation": "last_value",
      "time_field": "@timestamp",
      "type": "primary"
     },
     {
      "field": "veeam_repo.free_gb",
      "format": {
       "decimals": 0,
       "type": "number"
      },
      "label": "GB free",
      "operation": "last_value",
      "time_field": "@timestamp",
      "type": "secondary"
     }
    ],
    "query": {
     "expression": "event.action : \"repo-state\"",
     "language": "kql"
    },
    "title": "Repositories (how full)",
    "type": "metric"
   },
   "grid": {
    "h": 12,
    "w": 24,
    "x": 0,
    "y": 58
   },
   "type": "vis"
  },
  {
   "config": {
    "layers": [
     {
      "breakdown_by": {
       "fields": [
        "veeam_job.result"
       ],
       "label": "Result",
       "limit": 3,
       "operation": "terms",
       "rank_by": {
        "direction": "asc",
        "type": "alphabetical"
       }
      },
      "data_source": {
       "ref_id": "sentora-veeam",
       "type": "data_view_reference"
      },
      "type": "bar_stacked",
      "x": {
       "field": "@timestamp",
       "operation": "date_histogram"
      },
      "y": [
       {
        "label": "Jobs",
        "operation": "count"
       }
      ]
     }
    ],
    "legend": {
     "position": "right",
     "visibility": "visible"
    },
    "query": {
     "expression": "event.action : \"job-finished\"",
     "language": "kql"
    },
    "title": "Job results over the last days",
    "type": "xy"
   },
   "grid": {
    "h": 12,
    "w": 24,
    "x": 24,
    "y": 58
   },
   "type": "vis"
  }
 ],
 "refresh_interval": {
  "pause": false,
  "value": 60000
 },
 "time_range": {
  "from": "now-2d",
  "to": "now"
 },
 "title": "Sentora: Backup wall"
}
