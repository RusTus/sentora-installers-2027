  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metric": {
     "color": {
      "range": "absolute",
      "steps": [
       {
        "color": "#24C28A",
        "lt": 70
       },
       {
        "color": "#F2C94C",
        "gte": 70,
        "lt": 90
       },
       {
        "color": "#EB5757",
        "gte": 90
       }
      ],
      "type": "dynamic"
     },
     "field": "sentora.health.cpu_pct",
     "label": "%",
     "max": {
      "operation": "static_value",
      "value": 100
     },
     "operation": "last_value",
     "time_field": "@timestamp"
    },
    "query": {
     "expression": "sentora.log : \"health\"",
     "language": "kql"
    },
    "styling": {
     "shape": {
      "type": "semi_circle"
     }
    },
    "title": "CPU busy",
    "type": "gauge"
   },
