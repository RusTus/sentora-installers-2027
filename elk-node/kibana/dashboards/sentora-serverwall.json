  {
   "config": {
    "breakdown_by": {
     "columns": 6,
     "fields": [
      "monitor.name"
     ],
     "label": "Website",
     "limit": 18,
     "operation": "terms",
     "rank_by": {
      "direction": "asc",
      "type": "alphabetical"
     }
    },
    "data_source": {
     "ref_id": "sentora-uptime",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "color": {
       "range": "absolute",
       "steps": [
        {
         "color": "#EB5757",
         "lt": 0.9
        },
        {
         "color": "#F2C94C",
         "gte": 0.9,
         "lt": 1
        },
        {
         "color": "#24C28A",
         "gte": 1
        }
       ],
       "type": "dynamic"
      },
      "format": {
       "decimals": 0,
       "type": "percent"
      },
      "formula": "count(kql='monitor.status : \"up\"') / count()",
      "label": "up",
      "operation": "formula",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "tags : \"sentora-site\" and @timestamp >= \"now-15m\"",
     "language": "kql"
    },
    "title": "Websites (checks answered, last 15 minutes)",
    "type": "metric"
   },
