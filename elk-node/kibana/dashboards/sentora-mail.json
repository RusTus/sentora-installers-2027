{
 "description": "Made by the Sentora Elk node installer; a copy with another name keeps your own changes (an update replaces this one).",
 "panels": [
  {
   "config": {
    "layout": "horizontal",
    "links": [
     {
      "destination": "sentora-today",
      "label": "Today",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-serverwall",
      "label": "Server wall",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-overview",
      "label": "Overview",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-worldmap",
      "label": "World map",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-uptime",
      "label": "Uptime",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-websites",
      "label": "Websites",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-mail",
      "label": "Mail",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-delivery",
      "label": "Mail delivery",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-security",
      "label": "Security",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-attackers",
      "label": "Attackers",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-firewall",
      "label": "Web firewall",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-panel",
      "label": "Panel and server",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-health",
      "label": "Server health",
      "type": "dashboardLink"
     },
     {
      "destination": "sentora-speed",
      "label": "Website speed",
      "type": "dashboardLink"
     }
    ]
   },
   "grid": {
    "h": 2,
    "w": 48,
    "x": 0,
    "y": 0
   },
   "type": "links"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "label": "",
      "operation": "count",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "sentora.mail.status : \"sent\"",
     "language": "kql"
    },
    "title": "Sent",
    "type": "metric"
   },
   "grid": {
    "h": 5,
    "w": 12,
    "x": 0,
    "y": 2
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "label": "",
      "operation": "count",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "sentora.mail.status : \"bounced\"",
     "language": "kql"
    },
    "title": "Bounced",
    "type": "metric"
   },
   "grid": {
    "h": 5,
    "w": 12,
    "x": 12,
    "y": 2
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "label": "",
      "operation": "count",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "sentora.mail.status : \"deferred\"",
     "language": "kql"
    },
    "title": "Waiting to retry",
    "type": "metric"
   },
   "grid": {
    "h": 5,
    "w": 12,
    "x": 24,
    "y": 2
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "label": "",
      "operation": "count",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "sentora.mail.status : \"rejected\"",
     "language": "kql"
    },
    "title": "Refused at the door",
    "type": "metric"
   },
   "grid": {
    "h": 5,
    "w": 12,
    "x": 36,
    "y": 2
   },
   "type": "vis"
  },
  {
   "config": {
    "layers": [
     {
      "breakdown_by": {
       "fields": [
        "sentora.mail.status"
       ],
       "label": "Result",
       "limit": 6,
       "operation": "terms"
      },
      "data_source": {
       "ref_id": "sentora-logs",
       "type": "data_view_reference"
      },
      "type": "bar_stacked",
      "x": {
       "field": "@timestamp",
       "operation": "date_histogram"
      },
      "y": [
       {
        "label": "Mails",
        "operation": "count"
       }
      ]
     }
    ],
    "legend": {
     "position": "right",
     "visibility": "visible"
    },
    "query": {
     "expression": "sentora.mail.status : *",
     "language": "kql"
    },
    "title": "Mail by result",
    "type": "xy"
   },
   "grid": {
    "h": 12,
    "w": 32,
    "x": 0,
    "y": 7
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "group_by": [
     {
      "fields": [
       "event.outcome"
      ],
      "label": "Result",
      "limit": 2,
      "operation": "terms"
     }
    ],
    "metrics": [
     {
      "label": "Logins",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "event.action : \"mail-login\"",
     "language": "kql"
    },
    "title": "Mailbox logins",
    "type": "pie"
   },
   "grid": {
    "h": 12,
    "w": 16,
    "x": 32,
    "y": 7
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "label": "Mails",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "sentora.mail.status : \"sent\"",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "email.to.address"
      ],
      "label": "To",
      "limit": 15,
      "operation": "terms"
     }
    ],
    "title": "Where mail went",
    "type": "data_table"
   },
   "grid": {
    "h": 14,
    "w": 16,
    "x": 0,
    "y": 19
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "label": "Mails",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "sentora.mail.status : (\"bounced\" or \"deferred\")",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "email.to.address"
      ],
      "label": "To",
      "limit": 15,
      "operation": "terms"
     },
     {
      "fields": [
       "sentora.mail.status"
      ],
      "label": "Result",
      "limit": 15,
      "operation": "terms"
     }
    ],
    "title": "Not delivered",
    "type": "data_table"
   },
   "grid": {
    "h": 14,
    "w": 16,
    "x": 16,
    "y": 19
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "label": "Attempts",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "sentora.mail.status : (\"rejected\" or \"login-failed\")",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "source.ip"
      ],
      "label": "Address",
      "limit": 15,
      "operation": "terms"
     }
    ],
    "title": "Refused senders (addresses)",
    "type": "data_table"
   },
   "grid": {
    "h": 14,
    "w": 16,
    "x": 32,
    "y": 19
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "label": "Attempts",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "event.action : \"mail-login\" and event.outcome : \"failure\"",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "user.name"
      ],
      "label": "Name",
      "limit": 15,
      "operation": "terms"
     },
     {
      "fields": [
       "source.ip"
      ],
      "label": "Address",
      "limit": 15,
      "operation": "terms"
     }
    ],
    "title": "Mailbox logins that failed",
    "type": "data_table"
   },
   "grid": {
    "h": 12,
    "w": 24,
    "x": 0,
    "y": 33
   },
   "type": "vis"
  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-logs",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "label": "Logins",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "event.action : \"mail-login\" and event.outcome : \"success\"",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "user.name"
      ],
      "label": "Name",
      "limit": 15,
      "operation": "terms"
     }
    ],
    "title": "Mailboxes in use",
    "type": "data_table"
   },
   "grid": {
    "h": 12,
    "w": 24,
    "x": 24,
    "y": 33
   },
   "type": "vis"
  }
 ],
 "refresh_interval": {
  "pause": false,
  "value": 60000
 },
 "time_range": {
  "from": "now-24h",
  "to": "now"
 },
 "title": "Sentora: Mail"
}
