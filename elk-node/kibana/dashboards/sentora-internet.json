     "field": "fortigate.hour_n",
     "granularity": "auto",
     "label": "Hour",
     "operation": "histogram"
    },
    "y": {
     "fields": [
      "fortigate.weekday"
     ],
     "label": "Day",
     "limit": 7,
     "operation": "terms",
     "rank_by": {
      "direction": "asc",
      "type": "alphabetical"
     }
    }
   },
