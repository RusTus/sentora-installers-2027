  },
  {
   "config": {
    "data_source": {
     "ref_id": "sentora-fortigate",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "field": "network.bytes",
      "format": {
       "type": "bytes"
      },
      "label": "",
      "operation": "sum",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "(fortigate.appcat : (\"Video/Audio\" or \"Social.Media\" or \"Game\" or \"P2P\") or fortigate.category : (\"Streaming Media and Download\" or \"Social Networking\" or \"Games\" or \"Entertainment\" or \"Peer-to-peer File Sharing\")) and network.bytes : *",
     "language": "kql"
    },
    "title": "Streaming, social, games",
    "type": "metric"
