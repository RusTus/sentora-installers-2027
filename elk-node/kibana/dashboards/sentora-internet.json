    },
    "metric": {
     "field": "network.bytes",
     "format": {
      "type": "bytes"
     },
     "label": "Data",
     "operation": "sum"
    },
    "query": {
     "expression": "network.bytes : * and fortigate.hour_n : *",
     "language": "kql"
    },
    "title": "When the internet is busiest (data moved, by hour and day, the FortiGate's time)",
    "type": "heatmap",
