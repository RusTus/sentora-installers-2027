  {
   "config": {
    "data_source": {
     "ref_id": "sentora-vsphere",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "field": "vmw.cpu_pct",
      "format": {
       "decimals": 0,
       "type": "percent"
      },
      "label": "CPU",
      "operation": "last_value",
      "time_field": "@timestamp"
     },
     {
      "field": "vmw.mem_pct",
      "format": {
       "decimals": 0,
       "type": "percent"
      },
      "label": "Memory",
      "operation": "last_value",
      "time_field": "@timestamp"
     },
     {
      "field": "vmw.vms",
      "label": "VMs",
      "operation": "last_value",
      "time_field": "@timestamp"
     },
     {
      "field": "vmw.uptime_days",
      "format": {
       "decimals": 0,
       "type": "number"
      },
      "label": "Days up",
      "operation": "last_value",
      "time_field": "@timestamp"
     },
     {
      "field": "vmw.status",
      "label": "State",
      "operation": "last_value",
      "time_field": "@timestamp"
     }
    ],
    "query": {
     "expression": "vmw.kind : \"host\" and @timestamp >= \"now-30m\"",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "vmw.name"
      ],
      "label": "Name",
      "limit": 20,
      "operation": "terms",
      "rank_by": {
       "direction": "asc",
       "type": "alphabetical"
      }
     }
    ],
    "title": "Hosts",
    "type": "data_table"
