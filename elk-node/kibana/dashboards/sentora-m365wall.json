   "grid": {
    "h": 2,
    "w": 48,
    "x": 0,
    "y": 0
   },
   "type": "links"
  },
  {
   "config": {
    "breakdown_by": {
     "columns": 6,
     "fields": [
      "m365.service"
     ],
     "label": "Service",
     "limit": 12,
     "operation": "terms",
     "rank_by": {
      "direction": "asc",
      "type": "alphabetical"
     }
    },
    "data_source": {
     "ref_id": "sentora-m365",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "color": {
       "range": "absolute",
       "steps": [
        {
         "color": "#EB5757",
         "lt": 0.5
        },
        {
         "color": "#F2C94C",
         "gte": 0.5,
         "lt": 1
        },
        {
         "color": "#24C28A",
         "gte": 1
        }
       ],
       "type": "dynamic"
      },
      "field": "m365.health",
      "format": {
       "decimals": 0,
       "type": "percent"
      },
      "label": "health",
      "operation": "last_value",
      "time_field": "@timestamp",
      "type": "primary"
     },
     {
      "field": "m365.state",
      "label": "",
      "operation": "last_value",
      "time_field": "@timestamp",
      "type": "secondary"
     }
    ],
    "query": {
     "expression": "m365.kind : \"service-health\" and @timestamp >= \"now-30m\"",
     "language": "kql"
    },
    "title": "Microsoft's services (from Microsoft, every 5 minutes)",
    "type": "metric"
   },
   "grid": {
    "h": 15,
    "w": 48,
