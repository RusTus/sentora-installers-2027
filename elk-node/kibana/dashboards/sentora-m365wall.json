  {
   "config": {
    "data_source": {
     "ref_id": "sentora-m365",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "color": {
       "range": "absolute",
       "steps": [
        {
         "color": "#EB5757",
         "lt": 0.8
        },
        {
         "color": "#F2C94C",
         "gte": 0.8,
         "lt": 0.95
        },
        {
         "color": "#24C28A",
         "gte": 0.95
        }
       ],
       "type": "dynamic"
      },
      "format": {
       "decimals": 0,
       "type": "percent"
      },
      "formula": "count(kql='m365.mfa : true') / count()",
      "label": "of sign-ins",
      "operation": "formula",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "m365.kind : \"signin\" and m365.interactive : true",
