    },
    "metrics": [
     {
      "label": "Times",
      "operation": "count"
     }
    ],
    "query": {
     "expression": "m365.kind : \"signin\" and (event.outcome : \"failure\" or m365.risk : (\"medium\" or \"high\"))",
     "language": "kql"
    },
    "rows": [
     {
      "fields": [
       "user.name"
      ],
      "label": "Name",
      "limit": 12,
      "operation": "terms"
     },
     {
      "fields": [
       "m365.reason"
      ],
      "label": "Why",
      "limit": 12,
      "operation": "terms"
     }
