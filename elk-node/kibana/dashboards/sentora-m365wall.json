  {
   "config": {
    "data_source": {
     "ref_id": "sentora-m365",
     "type": "data_view_reference"
    },
    "metrics": [
     {
      "background_chart": {
       "type": "trend"
      },
      "color": {
       "range": "absolute",
       "steps": [
        {
         "color": "#24C28A",
         "lt": 50
        },
        {
         "color": "#F2C94C",
         "gte": 50,
         "lt": 200
        },
        {
         "color": "#EB5757",
         "gte": 200
        }
       ],
       "type": "dynamic"
      },
      "label": "",
      "operation": "count",
      "type": "primary"
     }
    ],
    "query": {
     "expression": "m365.kind : \"signin\" and event.outcome : \"failure\"",
     "language": "kql"
    },
    "title": "Failed sign-ins",
    "type": "metric"
   },
   "grid": {
    "h": 6,
    "w": 10,
    "x": 20,
    "y": 17
   },
   "type": "vis"
