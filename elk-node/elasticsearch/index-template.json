{
  "index_patterns": [
    "logs-sentora-*"
  ],
  "data_stream": {},
  "priority": 250,
  "composed_of": [
    "logs@mappings",
    "logs@settings",
    "ecs@mappings"
  ],
  "template": {
    "settings": {
      "index.lifecycle.name": "sentora-logs",
      "index.number_of_replicas": 0,
      "index.default_pipeline": "logs@default-pipeline"
    },
    "mappings": {
      "properties": {
        "sentora": {
          "properties": {
            "log": {
              "type": "keyword"
            },
            "account": {
              "type": "keyword"
            },
            "domain": {
              "type": "keyword"
            },
            "panel": {
              "type": "keyword"
            },
            "mail": {
              "properties": {
                "status": {
                  "type": "keyword"
                },
                "queue_id": {
                  "type": "keyword"
                }
              }
            },
            "bot": {
              "type": "boolean"
            },
            "visitor": {
              "type": "keyword"
            },
            "status_class": {
              "type": "keyword"
            },
            "health": {
              "properties": {
                "cpu_pct": {
                  "type": "double"
                },
                "load1": {
                  "type": "double"
                },
                "load5": {
                  "type": "double"
                },
                "load15": {
                  "type": "double"
                },
                "cpus": {
                  "type": "double"
                },
                "mem_total": {
                  "type": "double"
                },
                "mem_used_pct": {
                  "type": "double"
                },
                "swap_used_pct": {
                  "type": "double"
                },
                "disk_root_used_pct": {
                  "type": "double"
                },
                "disk_root_free": {
                  "type": "double"
                },
                "disk_sites_used_pct": {
                  "type": "double"
                },
                "disk_sites_free": {
                  "type": "double"
                },
                "net_rx_bps": {
                  "type": "double"
                },
                "net_tx_bps": {
                  "type": "double"
                },
                "apache_busy": {
                  "type": "double"
                },
                "apache_idle": {
                  "type": "double"
                },
                "apache_rps": {
                  "type": "double"
                },
                "mysql_threads": {
                  "type": "double"
                },
                "mysql_qps": {
                  "type": "double"
                },
                "mysql_slow_per_min": {
                  "type": "double"
                },
                "mail_queue": {
                  "type": "double"
                }
              }
            },
            "response_ms": {
              "type": "double"
            },
            "search": {
              "properties": {
                "term": {
                  "type": "keyword"
                },
                "class": {
                  "type": "keyword"
                }
              }
            },
            "store": {
              "properties": {
                "step": {
                  "type": "keyword"
                }
              }
            },
            "zgod": {
              "properties": {
                "type": {
                  "type": "keyword"
                },
                "user": {
                  "type": "keyword"
                },
                "reseller": {
                  "type": "keyword"
                },
                "package": {
                  "type": "keyword"
                },
                "group": {
                  "type": "keyword"
                },
                "by": {
                  "type": "keyword"
                },
                "action": {
                  "type": "keyword"
                },
                "reason": {
                  "type": "keyword",
                  "ignore_above": 256
                },
                "disk": {
                  "type": "double"
                },
                "disk_quota": {
                  "type": "double"
                },
                "disk_pct": {
                  "type": "double"
                },
                "bandwidth": {
                  "type": "double"
                },
                "bandwidth_quota": {
                  "type": "double"
                },
                "bandwidth_pct": {
                  "type": "double"
                },
                "domains": {
                  "type": "double"
                },
                "mailboxes": {
                  "type": "double"
                },
                "databases": {
                  "type": "double"
                },
                "ftp": {
                  "type": "double"
                },
                "clients": {
                  "type": "double"
                },
                "accounts": {
                  "type": "double"
                },
                "suspended": {
                  "type": "double"
                },
                "resellers": {
                  "type": "double"
                },
                "enabled": {
                  "type": "boolean"
                },
                "last_login": {
                  "type": "date"
                }
              }
            }
          }
        },
        "source": {
          "properties": {
            "geo": {
              "properties": {
                "location": {
                  "type": "geo_point"
                }
              }
            }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Sentora Elk node: the panel's logs (one data stream per panel)"
  }
}
