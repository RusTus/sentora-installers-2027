#!/usr/bin/env bash
# Sentora Node installer for AlmaLinux 10, Rocky Linux 10 and Red Hat Enterprise Linux 10: makes this
# server a Docker Hosting node of a Sentora-2027 panel. Run it as root on a server of its own (not the
# panel's), with nothing else on it:
#
#   curl -fsSL https://raw.githubusercontent.com/RusTus/sentora-installers-2027/master2027/node/sentora2027-node-alma10 -o sentora2027-node
#   sudo bash sentora2027-node
#
# It asks for the panel's address, shows the panel's code to check against the panel (Docker Hosting >
# Nodes and apps), and ends with this node's key: paste it in the panel's "Add a node". (Or the older
# way: the command the panel shows, with --panel, --key and --code.)
#
# Options:  --panel URL      the panel's address (asked for when not given)
#           --panel-code C   the panel's code (asked to check when not given)
#           --no-tls-check   the panel has a self-signed certificate (found by itself when needed;
#                            safe: every message from the panel is signed with its key)
#           --email ADDRESS  for Let's Encrypt's notices about the containers' certificates
#           --agent FILE     use this agent instead of downloading it (tests)
#           --update         bring an installed node up to date (what sentora-node-update runs):
#                            every step again, the node stays linked, its settings are kept
#
# What it does:
#   1. Podman (rootless containers: each customer has a Linux user of its own, sdh<account>),
#      PHP (for the agent), Caddy (web server with automatic HTTPS: EPEL's, else Caddy's own COPR repository),
#      firewalld (only SSH, HTTP and HTTPS open), chrony (the panel refuses messages with a wrong clock).
#   2. systemd hands CPU, memory, I/O and process limits to the customers' users (cgroups), so each
#      container's limits hold.
#   3. SELinux stays enforcing: Caddy may only forward to the containers' ports (20000-29999, on
#      127.0.0.1) and to web ports; nothing else is widened.
#   4. The agent (/usr/local/lib/sentora-node/sentora-node-agent.php) is linked to the panel with the
#      one-time code (new keys, made here; the secret ones never leave this server) and runs as the
#      service sentora-node. It calls the panel; nothing is opened on this server for the panel.
#
# Update: sentora-node-update --yes (the newest agent and installer from master2027, and the node's
#         own packages: Podman, Caddy, PHP; the customers' containers keep running).
# Uninstall: sentora-node-uninstall (keeps the customers' containers unless --purge).
# Log: /var/log/sentora2027-node.log
set -u
LOG=/var/log/sentora2027-node.log
RAW_BASE=https://raw.githubusercontent.com/RusTus/sentora-installers-2027/master2027/node
LIB=/usr/local/lib/sentora-node
PANEL='' KEY='' CODE='' EMAIL='' AGENT='' TLS='' UPDATE=0 PANELCODE='' MODE=enroll
CONF=/etc/sentora-node/install.conf
while [ $# -gt 0 ]; do
    case "$1" in
        --panel) PANEL=${2:-}; shift ;;
        --key) KEY=${2:-}; shift ;;
        --code) CODE=${2:-}; shift ;;
        --panel-code) PANELCODE=${2:-}; shift ;;
        --email) EMAIL=${2:-}; shift ;;
        --agent) AGENT=${2:-}; shift ;;
        --no-tls-check) TLS=--no-tls-check ;;
        --update) UPDATE=1 ;;
        -h|--help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "Unknown option: $1 (see --help)"; exit 1 ;;
    esac
    shift
done

say() { echo "$*"; echo "$(date '+%F %T') $*" >> "$LOG"; }
die() { say "STOPPED: $*"; exit 1; }
run() { "$@" >> "$LOG" 2>&1; }

[ "$(id -u)" -eq 0 ] || die "Run this as root."
if [ "$UPDATE" = 1 ]; then
    [ -f /etc/sentora-node/node.json ] || die "This server is not a node yet: install it with the command from the panel."
    PANEL=$(php -r '$c = json_decode((string) file_get_contents("/etc/sentora-node/node.json"), true); echo is_array($c) && isset($c["panel"]) ? $c["panel"] : "";')
    # the settings it was installed with (only known names are read)
    if [ -f "$CONF" ]; then
        v=$(sed -n 's/^EMAIL=//p' "$CONF" | head -1); [ -z "$EMAIL" ] && EMAIL=$v
        [ "$(sed -n 's/^LOCAL_CERTS=//p' "$CONF" | head -1)" = 1 ] && SNODE_TEST_LOCAL_CERTS=1
    fi
elif [ -n "$KEY" ] || [ -n "$CODE" ]; then
    MODE=pair
    [ -n "$PANEL" ] && [ -n "$KEY" ] && [ -n "$CODE" ] || die "Needs --panel, --key and --code together: copy the whole command from the panel (Docker Hosting > Nodes and apps)."
    case "$PANEL" in https://*|http://*) ;; *) die "--panel must start with https://" ;; esac
    [[ "$KEY" =~ ^v1\.[A-Za-z0-9_-]{43}\.[A-Za-z0-9_-]{43}$ ]] || die "--key is not right: copy the command from the panel again."
    [[ "$CODE" =~ ^[0-9]{1,9}\.[0-9a-f]{32}$ ]] || die "--code is not right: copy the command from the panel again."
else
    if [ -z "$PANEL" ] && [ ! -f /etc/sentora-node/node.json ]; then
        echo "Where is your Sentora panel? Type its IP address or its name, as this server can reach it"
        read -r -p "(for example 172.16.1.250 or panel.example.com): " PANEL
    fi
    case "$PANEL" in ''|https://*|http://*) ;; *) PANEL="https://$PANEL" ;; esac
    PANEL=${PANEL%/}
    [ -f /etc/sentora-node/node.json ] || [[ "$PANEL" =~ ^https?://[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?$ ]] || die "That is not a panel address (an IP address or name, like 172.16.1.250)."
fi
if [ -n "$EMAIL" ] && ! [[ "$EMAIL" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]]; then die "--email is not an email address."; fi
[ -r /etc/os-release ] || die "This system does not say what it is (/etc/os-release)."
. /etc/os-release
case "${ID:-}" in almalinux|rocky|rhel) ;; *) die "For AlmaLinux, Rocky Linux and Red Hat Enterprise Linux 10 only (this is ${PRETTY_NAME:-unknown})." ;; esac
case "${VERSION_ID:-}" in 10|10.*) ;; *) die "For version 10 only (this is ${PRETTY_NAME:-unknown})." ;; esac
[ "$(uname -m)" = x86_64 ] || [ "$(uname -m)" = aarch64 ] || die "For x86_64 or aarch64 servers."
if [ -e /etc/sentora/.installing ] || [ -d /etc/sentora/panel ] || [ -d /etc/zpanel ]; then die "This is a Sentora panel server: a node must be a server of its own."; fi
if [ "${ID}" = rhel ] && ! subscription-manager identity >/dev/null 2>&1; then die "Register this RHEL server first (subscription-manager register)."; fi
[ "$UPDATE" = 1 ] || : > "$LOG"
touch "$LOG"; chmod 600 "$LOG"
say "Sentora Node $([ "$UPDATE" = 1 ] && echo update || echo installer), $(date '+%F %T'), ${PRETTY_NAME}"

say "1/6 Packages (Podman, PHP, Caddy, firewalld, chrony)..."
# EPEL (php-sodium for the agent's keys, Caddy) and CRB, as the Sentora installer adds them: signed,
# updated like the system's own repositories
if [ "$ID" = rhel ]; then
    run subscription-manager repos --enable "codeready-builder-for-rhel-10-$(uname -m)-rpms"
    if ! rpm -q epel-release > /dev/null 2>&1; then
        EPEL_DIR=$(mktemp -d /tmp/sentora-epel.XXXXXX)
        if curl -fsSL -o "$EPEL_DIR/RPM-GPG-KEY-EPEL-10" https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-10 \
           && curl -fsSL -o "$EPEL_DIR/epel-release.rpm" https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm \
           && rpm --import "$EPEL_DIR/RPM-GPG-KEY-EPEL-10" \
           && rpm -K "$EPEL_DIR/epel-release.rpm" | grep -qiE 'digests signatures OK|signatures OK'; then
            run dnf -y install "$EPEL_DIR/epel-release.rpm"
        fi
        rm -rf "$EPEL_DIR"
    fi
    run dnf -y install dnf-plugins-core
else
    run dnf -y install epel-release dnf-plugins-core
    if command -v crb > /dev/null 2>&1; then run crb enable; else run dnf config-manager --set-enabled crb; fi
fi
rpm -q epel-release > /dev/null 2>&1 || die "EPEL could not be added (see $LOG)."
run dnf -y install podman skopeo php-cli php-sodium curl policycoreutils-python-utils firewalld chrony util-linux shadow-utils libcap systemd dbus dnf-plugins-core \
    || die "Could not install the packages (see $LOG)."
if [ "$UPDATE" = 1 ]; then
    # the node's own programs to their newest versions (the system's other updates: sentora2027-patch-alma10 or dnf)
    run dnf -y install skopeo dnf-plugins-core
    run dnf -y upgrade --refresh podman skopeo crun conmon passt containers-common caddy php-cli php-common php-sodium \
        || say "   Some of the node's packages could not be updated (see $LOG): going on."
fi
php -r 'exit(function_exists("sodium_crypto_box_seal") && function_exists("curl_init") ? 0 : 1);' || die "PHP lacks sodium or curl (see $LOG)."
if ! command -v caddy >/dev/null 2>&1; then
    # Caddy from EPEL; when EPEL does not have it, from Caddy's own repository (its COPR)
    if ! run dnf -y install caddy; then
        run dnf -y copr enable @caddy/caddy || die "Could not add Caddy's repository (dnf copr enable @caddy/caddy; see $LOG)."
        run dnf -y install caddy || die "Could not install Caddy (see $LOG)."
    fi
fi
command -v caddy >/dev/null 2>&1 || die "Caddy is not there after installing it."
# rootless Podman maps each customer's IDs with newuidmap/newgidmap, which need their file capabilities
# (some server images lose them): put them back from the package when missing
if ! getcap /usr/bin/newuidmap | grep -q cap_setuid || ! getcap /usr/bin/newgidmap | grep -q cap_setgid; then
    run dnf -y reinstall shadow-utils
    getcap /usr/bin/newuidmap | grep -q cap_setuid && getcap /usr/bin/newgidmap | grep -q cap_setgid \
        || die "newuidmap/newgidmap have no capabilities (getcap): rootless containers can not run."
    say "   newuidmap/newgidmap had lost their capabilities: shadow-utils reinstalled."
fi
[ "$(systemctl is-enabled systemd-logind 2> /dev/null)" = masked ] && die "systemd-logind is masked on this system: each customer's containers run in their own user session, which needs it (systemctl unmask systemd-logind)."
run systemctl start systemd-logind
run systemctl enable --now chronyd

say "2/6 Limits for the customers' containers (cgroups)..."
mkdir -p /etc/systemd/system/user@.service.d
cat > /etc/systemd/system/user@.service.d/sentora-delegate.conf <<'EOF'
# Sentora Node: each customer's containers get CPU, memory, I/O and process limits (rootless Podman).
[Service]
Delegate=cpu cpuset io memory pids
EOF
run systemctl daemon-reload
[ -f /sys/fs/cgroup/cgroup.controllers ] || die "This system does not use cgroups v2: container limits would not hold."

say "3/6 Web server (Caddy, automatic HTTPS) and firewall..."
mkdir -p /etc/caddy/sentora
[ -f /etc/caddy/Caddyfile ] && [ ! -f /etc/caddy/Caddyfile.before-sentora ] && cp -p /etc/caddy/Caddyfile /etc/caddy/Caddyfile.before-sentora
{
    echo "# Written by the Sentora Node installer. The containers' sites are in sentora/ (the agent writes them)."
    echo "{"
    [ -n "$EMAIL" ] && echo "	email $EMAIL"
    # (install test only: certificates from Caddy's own local authority, as the test has no public name)
    [ "${SNODE_TEST_LOCAL_CERTS:-}" = 1 ] && echo "	local_certs"
    # Caddy must not try to put its own certificate authority into this server's trust store: it would
    # need sudo (which SELinux rightly refuses, and the node does not need it)
    echo "	skip_install_trust"
    echo "	admin localhost:2019"
    echo "}"
    echo ""
    echo "import /etc/caddy/sentora/*.caddy"
} > /etc/caddy/Caddyfile
[ -f /etc/caddy/sentora/sites.caddy ] || echo "# Written by Sentora Node (sentora-node-agent): no containers yet." > /etc/caddy/sentora/sites.caddy
run caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile || die "Caddy does not accept its settings (see $LOG)."
run systemctl enable --now firewalld
for s in ssh http https; do run firewall-cmd --permanent --add-service=$s; done
run firewall-cmd --permanent --add-port=443/udp
run firewall-cmd --reload

say "4/6 SELinux..."
if command -v getenforce >/dev/null 2>&1 && [ "$(getenforce)" != Disabled ]; then
    # Caddy (httpd_t) may forward to the containers' ports only: label them as web cache ports and allow relaying
    if ! run semanage port -a -t http_cache_port_t -p tcp 20000-29999; then run semanage port -m -t http_cache_port_t -p tcp 20000-29999; fi
    run setsebool -P httpd_can_network_relay 1
    say "   SELinux is $(getenforce): Caddy may reach ports 20000-29999 and web ports, nothing else was widened."
else
    say "   SELinux is off on this system (it was not switched off by Sentora)."
fi
run systemctl enable caddy
run systemctl restart caddy || die "Caddy did not start (see $LOG and journalctl -u caddy)."

say "5/6 The agent, linked to the panel..."
mkdir -p "$LIB"; chmod 755 "$LIB"
rm -f "$LIB/sentora-node-agent.php.new"
if [ -n "$AGENT" ]; then
    cp "$AGENT" "$LIB/sentora-node-agent.php.new" || die "No agent at $AGENT."
else
    curl -fsSL "${SNODE_RAW_BASE:-$RAW_BASE}/sentora-node-agent.php" -o "$LIB/sentora-node-agent.php.new" || die "Could not download the agent."
fi
php -l "$LIB/sentora-node-agent.php.new" >> "$LOG" 2>&1 || { rm -f "$LIB/sentora-node-agent.php.new"; die "The agent is damaged (see $LOG): nothing changed."; }
# the one that ran before is kept, to go back to when the new one does not start
[ -f "$LIB/sentora-node-agent.php" ] && cp -p "$LIB/sentora-node-agent.php" "$LIB/sentora-node-agent.php.previous"
chmod 755 "$LIB/sentora-node-agent.php.new"
mv "$LIB/sentora-node-agent.php.new" "$LIB/sentora-node-agent.php"
# (this installer is kept too: sentora-node-update compares it with the newest)
if [ -f "$0" ] && [ "$0" != "$LIB/installer" ]; then cp "$0" "$LIB/installer"; chmod 700 "$LIB/installer"; fi
cat > /usr/local/sbin/sentora-node-agent <<EOF
#!/bin/sh
exec /usr/bin/php $LIB/sentora-node-agent.php "\$@"
EOF
chmod 755 /usr/local/sbin/sentora-node-agent
if [ -f /etc/sentora-node/node.json ]; then
    say "   Already linked to a panel (/etc/sentora-node/node.json): kept. To link it again, run sentora-node-uninstall first."
elif [ "$MODE" = pair ]; then
    /usr/local/sbin/sentora-node-agent pair --panel "$PANEL" --key "$KEY" --code "$CODE" $TLS 2>&1 | tee -a "$LOG"
    [ "${PIPESTATUS[0]}" -eq 0 ] || die "Not linked to the panel (see above)."
else
    # the node makes its own keys; the person installing checks the panel's code (no fake panel)
    /usr/local/sbin/sentora-node-agent enroll --panel "$PANEL" $TLS ${PANELCODE:+--panel-code "$PANELCODE"} || die "No node key was made (see above)."
fi
{ echo "# Settings this node was installed with (read by sentora-node-update)"; [ -n "$EMAIL" ] && echo "EMAIL=$EMAIL"; [ "${SNODE_TEST_LOCAL_CERTS:-}" = 1 ] && echo "LOCAL_CERTS=1"; } > "$CONF"
chmod 600 "$CONF"

say "6/6 The service..."
cat > /etc/systemd/system/sentora-node.service <<EOF
[Unit]
Description=Sentora Node agent (Docker Hosting)
After=network-online.target caddy.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/php $LIB/sentora-node-agent.php run
Restart=always
RestartSec=10
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
EOF
cat > /usr/local/sbin/sentora-node-uninstall <<'EOF'
#!/bin/sh
# Sentora Node: stop and remove the agent and its keys (the panel then sees the node offline; remove it there).
# --purge also deletes every customer's containers, data and Linux user (sdh*), and the containers' sites.
[ "$(id -u)" -eq 0 ] || { echo "Run this as root."; exit 1; }
systemctl disable --now sentora-node 2>/dev/null
rm -f /etc/systemd/system/sentora-node.service /usr/local/sbin/sentora-node-agent /usr/local/sbin/sentora-node-update /usr/local/sbin/sentora-node-sysupdate /root/sentora-node-key.txt
rm -rf /etc/sentora-node /usr/local/lib/sentora-node
if [ "${1:-}" = --purge ]; then
    for u in $(awk -F: '$1 ~ /^sdh[0-9]+$/ {print $1}' /etc/passwd); do
        loginctl disable-linger "$u" 2>/dev/null; loginctl terminate-user "$u" 2>/dev/null; sleep 1
        userdel -r "$u" 2>/dev/null && echo "removed $u"
    done
    rm -rf /var/lib/sentora-node
    echo "# no containers" > /etc/caddy/sentora/sites.caddy; systemctl reload caddy 2>/dev/null
fi
systemctl daemon-reload
rm -f /usr/local/sbin/sentora-node-uninstall
echo "Sentora Node agent removed."
EOF
chmod 755 /usr/local/sbin/sentora-node-uninstall
cat > /usr/local/sbin/sentora-node-sysupdate <<'SYSUPDATE_EOF'
#!/bin/bash
# Sentora Node: this server's own updates, for the panel (Docker Hosting > Nodes and apps), which asks
# for them through the agent. The result goes to /var/lib/sentora-node/sysupdate.json.
#   --check     count the waiting updates (all, security) and whether a restart is needed
#   --security  install the security updates      --all   install all updates
set -u
S=/var/lib/sentora-node/sysupdate.json
mkdir -p /var/lib/sentora-node && chmod 700 /var/lib/sentora-node
exec 9> /run/sentora-node-sysupdate.lock
flock -n 9 || exit 0
put() { php -r '$f = $argv[1]; $o = json_decode((string) @file_get_contents($f), true); $o = is_array($o) ? $o : array();
    file_put_contents($f . ".new", json_encode(array_merge($o, json_decode($argv[2], true)))); rename($f . ".new", $f);' "$S" "$1"; }
check() {
    local all sec reboot=0
    all=$(dnf -q --refresh check-update 2> /dev/null | grep -cE '^[A-Za-z0-9_.+-]+\.(x86_64|aarch64|noarch|i686)[[:space:]]')
    sec=$(dnf -q updateinfo list --security --available 2> /dev/null | grep -cE '[[:space:]][A-Za-z0-9_.+-]+-[0-9]')
    dnf -q needs-restarting -r > /dev/null 2>&1; [ $? -eq 1 ] && reboot=1
    put "{\"updates\": ${all:-0}, \"security\": ${sec:-0}, \"reboot\": $reboot, \"checked_at\": $(date +%s)}"
}
case "${1:---check}" in
    --check) check ;;
    --security|--all)
        kind=${1#--}
        put "{\"running\": \"$kind\"}"
        if [ "$kind" = security ]; then dnf -y upgrade --refresh --security >> /var/log/sentora-node-sysupdate.log 2>&1; else dnf -y upgrade --refresh >> /var/log/sentora-node-sysupdate.log 2>&1; fi
        ok=$?
        put "{\"running\": \"\", \"last_at\": $(date +%s), \"last_ok\": $([ $ok -eq 0 ] && echo 1 || echo 0), \"last_kind\": \"$kind\"}"
        check ;;
    *) echo "sentora-node-sysupdate --check|--security|--all"; exit 2 ;;
esac
SYSUPDATE_EOF
chmod 700 /usr/local/sbin/sentora-node-sysupdate
cat > /usr/local/sbin/sentora-node-update <<'UPDATE_EOF'
#!/bin/bash
# Sentora Node: bring this node up to date, like sentora-update on the panel. Downloads the newest node
# installer and agent (master2027 of sentora-installers-2027), shows what changes, and runs the
# installer with --update: every step again, the node's own packages (Podman, Caddy, PHP) to their
# newest, the new agent (the old one comes back when the new one does not start). The node stays
# linked; the customers' containers keep running.
#   sentora-node-update           ask before updating
#   sentora-node-update --yes     update without asking
#   sentora-node-update --check   only show whether there is something new
set -u
LIB=/usr/local/lib/sentora-node
RAW_BASE=${SNODE_RAW_BASE:-https://raw.githubusercontent.com/RusTus/sentora-installers-2027/master2027/node}
YES=0 CHECK=0
for a in "$@"; do case "$a" in --yes|-y) YES=1 ;; --check) CHECK=1 ;; -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; *) echo "Unknown option: $a"; exit 1 ;; esac; done
[ "$(id -u)" -eq 0 ] || { echo "Run this as root."; exit 1; }
T=$(mktemp -d /tmp/sentora-node-update.XXXXXX); trap 'rm -rf "$T"' EXIT
curl -fsSL "$RAW_BASE/sentora2027-node-alma10" -o "$T/installer" && curl -fsSL "$RAW_BASE/sentora-node-agent.php" -o "$T/agent.php" \
    || { echo "Could not download the newest node files ($RAW_BASE)."; exit 1; }
bash -n "$T/installer" && php -l "$T/agent.php" > /dev/null 2>&1 || { echo "The downloaded files are damaged: nothing changed."; exit 1; }
ver() { sed -n "s/^    const VERSION = '\([^']*\)';/\1/p" "$1" 2> /dev/null | head -1; }
same() { [ -f "$2" ] && [ "$(sha256sum < "$1")" = "$(sha256sum < "$2")" ]; }
OLD=$(ver "$LIB/sentora-node-agent.php"); NEW=$(ver "$T/agent.php")
if same "$T/agent.php" "$LIB/sentora-node-agent.php"; then echo "Agent: up to date (version ${OLD:-?})."; else echo "Agent: ${OLD:-?} -> ${NEW:-?} (new)"; fi
if same "$T/installer" "$LIB/installer"; then echo "Node setup: up to date."; else echo "Node setup: new (its steps run again)."; fi
echo "The node's own packages (Podman, Caddy, PHP) are brought to their newest too."
[ "$CHECK" = 1 ] && exit 0
if [ "$YES" != 1 ]; then read -r -p "Update this node now? [y/N] " r; case "$r" in y|Y|yes) ;; *) echo "Nothing changed."; exit 0 ;; esac; fi
bash "$T/installer" --update --agent "$T/agent.php"
UPDATE_EOF
chmod 755 /usr/local/sbin/sentora-node-update
run systemctl daemon-reload
if [ "$UPDATE" = 1 ]; then
    run systemctl enable sentora-node
    run systemctl restart sentora-node
else
    run systemctl enable --now sentora-node || die "The service did not start (journalctl -u sentora-node)."
fi
sleep 3
if ! systemctl is-active --quiet sentora-node; then
    if [ "$UPDATE" = 1 ] && [ -f "$LIB/sentora-node-agent.php.previous" ]; then
        cp -p "$LIB/sentora-node-agent.php.previous" "$LIB/sentora-node-agent.php"
        run systemctl restart sentora-node
        die "The new agent did not stay up: the one before is back (journalctl -u sentora-node)."
    fi
    die "The service did not stay up (journalctl -u sentora-node)."
fi
say ""
if [ "$UPDATE" = 1 ]; then
    say "Done: this node is up to date (agent $(sed -n "s/^    const VERSION = '\([^']*\)';/\1/p" "$LIB/sentora-node-agent.php" | head -1)), still a node of $PANEL."
elif [ "$MODE" = enroll ] && [ -f /root/sentora-node-key.txt ]; then
    NODEKEY=$(grep -oE 'SN1(-[A-Z0-9]{4}){6}' /root/sentora-node-key.txt | head -1)
    say "Done: this server is ready to be a node of $PANEL."
    say ""
    say "Last step, in the panel: Docker Hosting > Nodes and apps > Add a node."
    say "Give the node a name and paste this node key:"
    say ""
    say "    $NODEKEY"
    say ""
    say "(The key is also in /root/sentora-node-key.txt. The node shows online a few seconds after you add it.)"
else
    say "Done: this server is a node of $PANEL. The panel shows it online in a few seconds."
fi
say "Status: sentora-node-agent status    Update: sentora-node-update --yes    Log: journalctl -u sentora-node"
