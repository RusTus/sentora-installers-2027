#!/usr/bin/env bash
# Sentora Node installer: this name is kept for older commands and for nodes whose sentora-node-update
# still asks for it. The installer for every system Sentora supports is sentora2027-node now: this
# fetches it from the same place and runs it with the same options.
set -u
RAW_BASE=${SNODE_RAW_BASE:-https://raw.githubusercontent.com/RusTus/sentora-installers-2027/master2027/node}
T=$(mktemp -d /tmp/sentora2027-node.XXXXXX)
curl -fsSL --proto =https,file --proto-redir =https "$RAW_BASE/sentora2027-node" -o "$T/sentora2027-node" \
    || { echo "Could not download the node installer ($RAW_BASE/sentora2027-node)."; exit 1; }
bash -n "$T/sentora2027-node" || { echo "The downloaded node installer is damaged: nothing changed."; exit 1; }
exec bash "$T/sentora2027-node" "$@"
