<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>
    <link rel="stylesheet" href="modules/visitor_stats/assets/visitors.css">

    <div class="vz" id="vz">
        <% if NoDomains %>
        <div class="vz-card vz-state">
            <svg class="vz-ico-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <b><: You have no websites yet :></b>
            <span><: Reports appear here once you add a domain and it has had visitors. :> <a href="./?module=domains"><: Create a new domain :></a></span>
        </div>
        <% endif %>
        <% if Domains %>
        <div class="vz-card vz-bar">
            <@ DomainPicker @>
            <@ ReportInfo @>
        </div>
        <% if NotMadeYet %>
        <div class="vz-card vz-state">
            <svg class="vz-ico-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
            <b><: This report has not been made yet :></b>
            <span><: Reports are made every hour from the web server logs, once a site has had visitors. :></span>
        </div>
        <% endif %>
        <div class="vz-frame-wrap"><@ Frame @></div>
        <p class="vz-note"><: Reports are made every hour from the web server logs. The list at the top of the report jumps to each part: visitors per day and month, pages, referrers, search terms, browsers and the busiest hours. :></p>
        <% endif %>
    </div>
</div>
<script>
(function () {
    'use strict';
    var vz = document.getElementById('vz'); if (!vz) { return; }
    // the report in the panel's Light or Dark
    var dark = (getComputedStyle(document.documentElement).colorScheme || '').indexOf('dark') >= 0;
    var themed = function (url) { return url + (dark ? '&theme=dark' : ''); };
    var frame = vz.querySelector('.vz-frame');
    if (frame) { frame.src = themed(frame.getAttribute('src')); }
    var win = vz.querySelector('.vz-newwin');
    if (win) { win.href = themed(win.getAttribute('href')); }
    var reload = vz.querySelector('.vz-reload');
    if (reload && frame) { reload.addEventListener('click', function () { try { frame.contentWindow.location.reload(); } catch (e) { frame.src = frame.src; } }); }
})();
</script>
