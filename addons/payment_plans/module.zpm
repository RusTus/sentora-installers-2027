<@ Init @>
<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ Title @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ Intro @></div>
    </div>
    <link rel="stylesheet" href="modules/payment_plans/assets/pp.css">
    <div class="pp">
        <@ Page @>
    </div>
</div>
