{ echo "# Settings this node was installed with (read by sentora-docker-node-update)"; [ -n "$EMAIL" ] && echo "EMAIL=$EMAIL"; [ "${SNODE_TEST_LOCAL_CERTS:-}" = 1 ] && echo "LOCAL_CERTS=1"; } > "$CONF"
