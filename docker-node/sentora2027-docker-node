chmod 755 /usr/local/sbin/sentora-docker-node-uninstall
cat > /usr/local/sbin/sentora-docker-node-sysupdate <<'SYSUPDATE_EOF'
#!/bin/bash
# Sentora Docker Node: this server's own updates, for the panel (Docker Hosting > Nodes and apps), which asks
# for them through the agent. The result goes to /var/lib/sentora-docker-node/sysupdate.json.
#   --check     count the waiting updates (all, security) and whether a restart is needed
#   --security  install the security updates      --all   install all updates
set -u
S=/var/lib/sentora-docker-node/sysupdate.json
mkdir -p /var/lib/sentora-docker-node && chmod 700 /var/lib/sentora-docker-node
exec 9> /run/sentora-docker-node-sysupdate.lock
flock -n 9 || exit 0
put() { php -r '$f = $argv[1]; $o = json_decode((string) @file_get_contents($f), true); $o = is_array($o) ? $o : array();
    file_put_contents($f . ".new", json_encode(array_merge($o, json_decode($argv[2], true)))); rename($f . ".new", $f);' "$S" "$1"; }
# the system's package manager (from the installer: platform.conf)
PKG=$(sed -n 's/^PKG=//p' /etc/sentora-docker-node/platform.conf 2> /dev/null); PKG=${PKG:-dnf}
export DEBIAN_FRONTEND=noninteractive
check() {
    local all sec reboot=0
    if [ "$PKG" = apt ]; then
        apt-get -q update > /dev/null 2>&1
        all=$(apt-get -s upgrade 2> /dev/null | grep -c '^Inst ')
        sec=$(apt-get -s upgrade 2> /dev/null | grep '^Inst ' | grep -ci 'securit')
        # a newer kernel than the running one, or the system says so
        newest=$(ls /boot/vmlinuz-* 2> /dev/null | sed 's#.*/vmlinuz-##' | sort -V | tail -1)
        { [ -f /run/reboot-required ] || { [ -n "$newest" ] && [ "$newest" != "$(uname -r)" ]; }; } && reboot=1
    else
        all=$(dnf -q --refresh check-update 2> /dev/null | grep -cE '^[A-Za-z0-9_.+-]+\.(x86_64|aarch64|noarch|i686)[[:space:]]')
        sec=$(dnf -q updateinfo list --security --available 2> /dev/null | grep -cE '[[:space:]][A-Za-z0-9_.+-]+-[0-9]')
        dnf -q needs-restarting -r > /dev/null 2>&1; [ $? -eq 1 ] && reboot=1
    fi
    put "{\"updates\": ${all:-0}, \"security\": ${sec:-0}, \"reboot\": $reboot, \"checked_at\": $(date +%s)}"
}
case "${1:---check}" in
    --check) check ;;
    --security|--all)
        kind=${1#--}
        put "{\"running\": \"$kind\"}"
        L=/var/log/sentora-docker-node-sysupdate.log
        touch $L; chmod 600 $L   # (root's only: it lists the node's packages)
        if [ "$PKG" = apt ]; then
            apt-get -q update >> $L 2>&1
            if [ "$kind" = security ]; then unattended-upgrade -v >> $L 2>&1; else apt-get -y -o Dpkg::Options::=--force-confold upgrade >> $L 2>&1; fi
        elif [ "$kind" = security ]; then dnf -y upgrade --refresh --security >> $L 2>&1; else dnf -y upgrade --refresh >> $L 2>&1; fi
        ok=$?
        put "{\"running\": \"\", \"last_at\": $(date +%s), \"last_ok\": $([ $ok -eq 0 ] && echo 1 || echo 0), \"last_kind\": \"$kind\"}"
        check ;;
    *) echo "sentora-docker-node-sysupdate --check|--security|--all"; exit 2 ;;
esac
SYSUPDATE_EOF
chmod 700 /usr/local/sbin/sentora-docker-node-sysupdate
cat > /usr/local/sbin/sentora-docker-node-update <<'UPDATE_EOF'
#!/bin/bash
# Sentora Docker Node: bring this node up to date, like sentora-update on the panel. Downloads the newest node
# installer and agent (master2027 of sentora-installers-2027), shows what changes, and runs the
# installer with --update: every step again and the new agent (the old one comes back when the new
# one does not start). Only Sentora's own software: Podman, Caddy, PHP and the rest of the system are
# updated by the system's updates (sentora-docker-node-sysupdate). The node stays linked; the customers'
# containers keep running.
#   sentora-docker-node-update           ask before updating
#   sentora-docker-node-update --yes     update without asking
#   sentora-docker-node-update --check   only show whether there is something new
set -u
LIB=/usr/local/lib/sentora-docker-node
RAW_BASE=${SNODE_RAW_BASE:-https://raw.githubusercontent.com/RusTus/sentora-installers-2027/master2027/docker-node}
YES=0 CHECK=0
for a in "$@"; do case "$a" in --yes|-y) YES=1 ;; --check) CHECK=1 ;; -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; *) echo "Unknown option: $a"; exit 1 ;; esac; done
[ "$(id -u)" -eq 0 ] || { echo "Run this as root."; exit 1; }
T=$(mktemp -d /tmp/sentora-docker-node-update.XXXXXX); trap 'rm -rf "$T"' EXIT
curl -fsSL --proto =https,file --proto-redir =https "$RAW_BASE/sentora2027-docker-node" -o "$T/installer" && curl -fsSL --proto =https,file --proto-redir =https "$RAW_BASE/sentora-docker-node-agent.php" -o "$T/agent.php" \
    || { echo "Could not download the newest node files ($RAW_BASE)."; exit 1; }
bash -n "$T/installer" && php -l "$T/agent.php" > /dev/null 2>&1 || { echo "The downloaded files are damaged: nothing changed."; exit 1; }
ver() { sed -n "s/^    const VERSION = '\([^']*\)';/\1/p" "$1" 2> /dev/null | head -1; }
same() { [ -f "$2" ] && [ "$(sha256sum < "$1")" = "$(sha256sum < "$2")" ]; }
OLD=$(ver "$LIB/sentora-docker-node-agent.php"); NEW=$(ver "$T/agent.php")
if same "$T/agent.php" "$LIB/sentora-docker-node-agent.php"; then echo "Agent: up to date (version ${OLD:-?})."; else echo "Agent: ${OLD:-?} -> ${NEW:-?} (new)"; fi
if same "$T/installer" "$LIB/installer"; then echo "Node setup: up to date."; else echo "Node setup: new (its steps run again)."; fi
echo "(Only Sentora's own software; Podman, Caddy, PHP and the rest come with the system's updates.)"
[ "$CHECK" = 1 ] && exit 0
if [ "$YES" != 1 ]; then read -r -p "Update this node now? [y/N] " r; case "$r" in y|Y|yes) ;; *) echo "Nothing changed."; exit 0 ;; esac; fi
bash "$T/installer" --update --agent "$T/agent.php"
UPDATE_EOF
chmod 755 /usr/local/sbin/sentora-docker-node-update
run systemctl daemon-reload
if [ "$UPDATE" = 1 ]; then
    run systemctl enable sentora-docker-node
    run systemctl restart sentora-docker-node
else
    run systemctl enable --now sentora-docker-node || die "The service did not start (journalctl -u sentora-docker-node)."
fi
sleep 3
if ! systemctl is-active --quiet sentora-docker-node; then
    if [ "$UPDATE" = 1 ] && [ -f "$LIB/sentora-docker-node-agent.php.previous" ]; then
        cp -p "$LIB/sentora-docker-node-agent.php.previous" "$LIB/sentora-docker-node-agent.php"
        run systemctl restart sentora-docker-node
        die "The new agent did not stay up: the one before is back (journalctl -u sentora-docker-node)."
    fi
    die "The service did not stay up (journalctl -u sentora-docker-node)."
fi
ui_done
UI_WORKING=''
if [ $UI_TTY -eq 1 ]; then ui_bar "$BG_OK" "  $([ "$UPDATE" = 1 ] && echo "This node is up to date" || echo "This server is ready")"; echo >&3; fi
if [ "$UPDATE" = 1 ]; then
    say "Done: this node is up to date (agent $(sed -n "s/^    const VERSION = '\([^']*\)';/\1/p" "$LIB/sentora-docker-node-agent.php" | head -1)), still a node of $PANEL."
elif [ "$MODE" = enroll ] && [ -f /root/sentora-docker-node-key.txt ]; then
    NODEKEY=$(grep -oE 'SN1(-[A-Z0-9]{4}){6}' /root/sentora-docker-node-key.txt | head -1)
