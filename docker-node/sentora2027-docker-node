cat > /usr/local/sbin/sentora-docker-node-uninstall <<'EOF'
#!/bin/sh
# Sentora Docker Node: stop and remove the agent and its keys (the panel then sees the node offline; remove it there).
# --purge also deletes every customer's containers, data and Linux user (sdh*), and the containers' sites.
[ "$(id -u)" -eq 0 ] || { echo "Run this as root."; exit 1; }
CADDY_DIR=$(sed -n 's/^CADDY_DIR=//p' /etc/sentora-docker-node/platform.conf 2> /dev/null); CADDY_DIR=${CADDY_DIR:-/etc/caddy}
CADDY_SERVICE=$(sed -n 's/^CADDY_SERVICE=//p' /etc/sentora-docker-node/platform.conf 2> /dev/null); CADDY_SERVICE=${CADDY_SERVICE:-caddy}
systemctl disable --now sentora-docker-node 2>/dev/null
rm -f /etc/systemd/system/sentora-docker-node.service /usr/local/sbin/sentora-docker-node-agent /usr/local/sbin/sentora-docker-node-relink /usr/local/sbin/sentora-docker-node-update /usr/local/sbin/sentora-docker-node-sysupdate /root/sentora-docker-node-key.txt
rm -rf /etc/sentora-docker-node /usr/local/lib/sentora-docker-node
if [ "${1:-}" = --purge ]; then
    for u in $(awk -F: '$1 ~ /^sdh[0-9]+$/ {print $1}' /etc/passwd); do
        loginctl disable-linger "$u" 2>/dev/null; loginctl terminate-user "$u" 2>/dev/null; sleep 1
