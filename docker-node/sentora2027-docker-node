gvisor_install
if [ -x /usr/local/bin/runsc ]; then
    # (the runtime the apps with Extra isolation use: runsc with its two settings always, also when Podman starts
    # an app again after a restart, which passes no runtime flags of its own; Podman keeps each app's runtime)
    # (the same as docker-node/runsc-sentora, which the gVisor SELinux probe and the node test use; the node test
    # checks the two are the same)
    cat > /usr/local/bin/runsc-sentora.new <<'RUNSC_EOF'
#!/bin/bash
# Sentora Docker Node: gVisor for the apps with Extra isolation (installed as /usr/local/bin/runsc-sentora).
# The app's limits are held by its own slice (sentora-app-<id>.slice, set by the agent): runsc does not manage
# cgroups itself under rootless Podman. --overlay2=none: the app's own files go to Podman's layer, as without
# gVisor (kept over a restart). --network=host: gVisor uses the network namespace Podman made for the app.
RUNSC=/usr/local/bin/runsc
FLAGS=(--ignore-cgroups --network=host --overlay2=none)
[ "$(cat /sys/fs/selinux/enforce 2> /dev/null)" = 1 ] || exec "$RUNSC" "${FLAGS[@]}" "$@"

# With SELinux enforcing (docker-node/selinux/sentora_runsc.te): runsc takes no SELinux label, so when a sandbox
# is made the label Podman chose for the app (container_t at the app's own MCS categories) is taken out of the
# app's spec, and runsc is started in Sentora's domain for it (sentora_runsc_t) at that same level: the sandbox
# and its file helper are confined, and reach none of another app's files. Each app keeps gVisor's state in a
# folder of its own (/run/user/<uid>/sentora-runsc/<container id>) at the app's level, so no app's sandbox can
# touch another's state either; the pid file Podman asks for is written there and copied to Podman by this
# wrapper (which runs as Podman does), so the sandbox needs no access to Podman's folders.
base="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sentora-runsc"
args=(); id=""; sub=""; bundle=""; pidfile=""; prev=""; skip=0
for a in "$@"; do
    if [ $skip = 1 ]; then skip=0; prev=$a; continue; fi
    case "$prev" in --bundle|-bundle|-b) bundle=$a ;; --pid-file|-pid-file) pidfile=$a; a=@PIDFILE@ ;; esac
    case "$a" in
        --root|-root) skip=1; prev=$a; continue ;;
        --root=*|-root=*) prev=$a; continue ;;
        --bundle=*|-bundle=*) bundle=${a#*=} ;;
        --pid-file=*|-pid-file=*) pidfile=${a#*=}; a=${a%%=*}=@PIDFILE@ ;;
        create|run|delete) [ -z "$sub" ] && sub=$a ;;
    esac
    [ -z "$id" ] && [[ "$a" =~ ^[0-9a-f]{64}$ ]] && id=$a
    args+=("$a"); prev=$a
done
[ -d "$base" ] || mkdir -m 700 "$base" 2> /dev/null
root=$base; [ -n "$id" ] && root=$base/$id
FLAGS+=(--root="$root")
# (only a new sandbox writes its pid file into its own folder; exec and the rest write Podman's own, as Podman runs)
case "$sub" in create|run) args=("${args[@]//@PIDFILE@/$root/pidfile}") ;; *) args=("${args[@]//@PIDFILE@/$pidfile}") ;; esac

case "$sub" in
create|run)
    [ -n "$bundle" ] || bundle=$PWD
    ctx=$(/usr/bin/python3 -I - "$bundle/config.json" <<'PY'
import json, os, sys
p = sys.argv[1]
with open(p) as f:
    spec = json.load(f)
label = (spec.get("process") or {}).get("selinuxLabel") or ""
parts = label.split(":", 3)
if len(parts) != 4 or not parts[3].startswith("s0"):
    sys.exit(3)
spec["process"].pop("selinuxLabel", None)
(spec.get("linux") or {}).pop("mountLabel", None)
for m in spec.get("mounts") or []:
    if m.get("options"):
        m["options"] = [o for o in m["options"] if not o.startswith("context=")]
tmp = p + ".sentora"
with open(tmp, "w") as f:
    json.dump(spec, f)
os.rename(tmp, p)
print(":".join(parts[:2]) + ":sentora_runsc_t:" + parts[3])
PY
    )
    # (no label to take over, or its folder can not have the app's level: refused, never run unconfined)
    [ -n "$ctx" ] && [ -n "$id" ] || { echo "runsc-sentora: the app's SELinux label or id was not found ($bundle/config.json)" >&2; exit 1; }
    # (the same folder again when the app is started again: Podman keeps its id and its level)
    { [ -d "$root" ] || mkdir -m 700 "$root"; } && chcon -l "${ctx#*:*:*:}" "$root" || { echo "runsc-sentora: could not make $root at the app's level" >&2; exit 1; }
    /usr/bin/runcon "$ctx" "$RUNSC" "${FLAGS[@]}" "${args[@]}"; rc=$?
    if [ $rc = 0 ] && [ -n "$pidfile" ]; then cat "$root/pidfile" > "$pidfile.sentora" && mv -f "$pidfile.sentora" "$pidfile" || rc=1; fi
    exit $rc ;;
delete)
    "$RUNSC" "${FLAGS[@]}" "${args[@]}"; rc=$?
    # (runsc's empty network namespace stays mounted on its file: unmounted first, then the folder goes)
    if [ $rc = 0 ] && [ -n "$id" ]; then umount "$root/null-netns" 2> /dev/null; rm -rf "$root" 2> /dev/null; fi
    exit $rc ;;
esac
exec "$RUNSC" "${FLAGS[@]}" "${args[@]}"
RUNSC_EOF
    install -m 755 -o root -g root /usr/local/bin/runsc-sentora.new /usr/local/bin/runsc-sentora; rm -f /usr/local/bin/runsc-sentora.new
    command -v restorecon > /dev/null 2>&1 && restorecon /usr/local/bin/runsc-sentora > /dev/null 2>&1
    # With SELinux (AlmaLinux, Rocky, RHEL, Fedora): Sentora's own SELinux domain for gVisor (2026-11-24), built
    # here from its source against this system's policy and container-selinux, so the sandbox is confined as an
    # app is under container_t, at the app's own level. Without it loaded the agent does not use gVisor here.
    if [ "$MAC" = selinux ]; then
        sel=/usr/share/sentora-docker-node/selinux; mkdir -p "$sel"
        cat > "$sel/sentora_runsc.te" <<'SENTORA_TE_EOF'
policy_module(sentora_runsc, 1.0)

# Sentora Docker Node: gVisor (runsc) for the apps with Extra isolation, under SELinux (2026-11-24).
#
# runsc takes no SELinux label of its own, so the wrapper (/usr/local/bin/runsc-sentora) starts it in this domain
# at the app's own MCS level, the one Podman chose for the app: the sandbox (gVisor's kernel, which runs the app)
# and its file helper (gofer) are confined as an app is under container_t, and one app's sandbox can reach none
# of another app's files (MCS). The domain is made with container-selinux's own template, as its container
# domains are; on top of that only what runsc needs to set itself up (found on a real AlmaLinux 10 by the probe,
# .github/workflows/gvisor-selinux-probe.yml): its own state, mounts inside its own private namespace, and the
# same network as container_t.

gen_require(`
	type container_runtime_t;
	type container_file_t;
	type user_tmp_t;
	type proc_t;
	type tmpfs_t;
	type root_t;
	type tmp_t;
	attribute container_net_domain;
')

type sentora_runsc_exec_t;
container_domain_template(sentora_runsc, container)
domain_entry_file(sentora_runsc_t, sentora_runsc_exec_t)

# the same network as container_t (an app listens on its port inside its own network namespace)
typeattribute sentora_runsc_t container_net_domain;

# gVisor's state (locks, state, control socket, its empty network namespace file, the pid file Podman asks for):
# /run/user/<uid>/sentora-runsc/<container id>, made by the wrapper (as Podman's conmon runs) at the app's own
# level, so what a sandbox writes there has the app's categories and no other app's sandbox can touch it. The
# sandbox gets no access to Podman's own folders (the wrapper copies the pid file there).
type sentora_runsc_state_t;
files_type(sentora_runsc_state_t)
filetrans_pattern(container_runtime_t, user_tmp_t, sentora_runsc_state_t, dir, "sentora-runsc")
manage_dirs_pattern(container_runtime_t, sentora_runsc_state_t, sentora_runsc_state_t)
manage_files_pattern(container_runtime_t, sentora_runsc_state_t, sentora_runsc_state_t)
manage_sock_files_pattern(container_runtime_t, sentora_runsc_state_t, sentora_runsc_state_t)
allow container_runtime_t sentora_runsc_state_t:dir { relabelfrom relabelto };
allow sentora_runsc_t user_tmp_t:dir search_dir_perms;
allow sentora_runsc_t sentora_runsc_state_t:dir rw_dir_perms;
manage_files_pattern(sentora_runsc_t, sentora_runsc_state_t, sentora_runsc_state_t)
manage_sock_files_pattern(sentora_runsc_t, sentora_runsc_state_t, sentora_runsc_state_t)
allow sentora_runsc_t sentora_runsc_state_t:file mounton;

# started by Podman's conmon (container_runtime_t) through the wrapper; runsc then runs itself again (sandbox,
# gofer) and its helper (gvisor-bin), all labelled sentora_runsc_exec_t
allow container_runtime_t sentora_runsc_t:process transition;
allow container_runtime_t sentora_runsc_exec_t:file { mmap_exec_file_perms execute_no_trans };
allow container_runtime_t sentora_runsc_t:process { signal sigkill signull sigstop };
allow container_runtime_t sentora_runsc_t:unix_stream_socket connectto;
allow sentora_runsc_t sentora_runsc_exec_t:file { mmap_exec_file_perms execute_no_trans };
allow sentora_runsc_t container_runtime_t:fd use;
allow sentora_runsc_t container_runtime_t:fifo_file { rw_fifo_file_perms setattr };
allow sentora_runsc_t container_runtime_t:process sigchld;
# (runsc sets its standard input's owner to its own: /dev/null for an app; the owner can not change, as /dev/null
# is root's and the app runs as the customer)
dev_setattr_null_dev(sentora_runsc_t)

# setting itself up inside its own mount namespace: a proc of its own, the root and /var/tmp as mount points
allow sentora_runsc_t proc_t:filesystem { mount unmount };
allow sentora_runsc_t tmpfs_t:filesystem remount;
allow sentora_runsc_t { root_t tmp_t }:dir mounton;
SENTORA_TE_EOF
        cat > "$sel/sentora_runsc.fc" <<'SENTORA_FC_EOF'
/usr/local/bin/runsc		--	gen_context(system_u:object_r:sentora_runsc_exec_t,s0)
/usr/local/bin/gvisor-bin(/.*)?		gen_context(system_u:object_r:sentora_runsc_exec_t,s0)
SENTORA_FC_EOF
        : > "$sel/sentora_runsc.if"
        if { [ -f /usr/share/selinux/devel/Makefile ] || run $PKG_INSTALL selinux-policy-devel; } && { command -v python3 > /dev/null 2>&1 || run $PKG_INSTALL python3; } \
            && (cd "$sel" && run make -f /usr/share/selinux/devel/Makefile sentora_runsc.pp) && run semodule -i "$sel/sentora_runsc.pp"; then
            restorecon -R /usr/local/bin/runsc /usr/local/bin/gvisor-bin /usr/local/bin/runsc-sentora > /dev/null 2>&1
            echo "RUNSC_SELINUX=1" >> /etc/sentora-docker-node/platform.conf
            note "gVisor with SELinux: Sentora's domain for it (sentora_runsc) is loaded."
        else
            note "gVisor's SELinux domain could not be built or loaded (see $LOG): apps asking for Extra isolation run on the standard runtime, confined by SELinux as before."
        fi
    fi
    echo "RUNSC=/usr/local/bin/runsc-sentora" >> /etc/sentora-docker-node/platform.conf
fi

ui_step "Image check for the apps (Trivy)"
# Trivy checks an app's image for known security holes before it starts or updates, and every night (Docker
# Hosting 137, owner 2026-11-15: warn by default). One release, pinned with its checksums: Trivy's own releases
# were attacked in March 2026 (a poisoned 0.69.4), so a new one is taken only after it was looked at (the Trivy
# probe workflow lists the releases and checks them). It runs as its own user (sentora-scan), never as root.
TRIVY_VERSION=0.76.2
TRIVY_SHA256_X86_64=bc0fc726e017b8927a62b2d3531d7a84ee01769daf5c99ed866dced54089fdbf
TRIVY_SHA256_AARCH64=ab9d51f86e6a5fb936f605faff6b593ac51bc378fff4d3e8b9d58358b9c367c3
trivy_install() {
    local arch file sum tmp free
    case "$(uname -m)" in
        x86_64) file=Linux-64bit; sum=$TRIVY_SHA256_X86_64 ;;
        aarch64) file=Linux-ARM64; sum=$TRIVY_SHA256_AARCH64 ;;
        *) note "Image check: no Trivy for $(uname -m); the apps are not checked."; return ;;
    esac
    if [ "$(cat /etc/sentora-docker-node/trivy.version 2> /dev/null)" = "$TRIVY_VERSION" ] && [ -x /usr/local/bin/trivy ]; then
        note "Trivy $TRIVY_VERSION is in place."
    else
        # (its database takes about 2 GB on the disk)
        free=$(df --output=avail -k /var/lib 2> /dev/null | tail -1 | tr -d ' ')
        if [ "${free:-0}" -lt 3145728 ]; then
            note "Image check: less than 3 GB free in /var/lib, so Trivy was not installed; the apps are not checked."
            return
        fi
        tmp=$(mktemp -d)
        if curl -fsSL --proto =https,file --proto-redir =https "${SNODE_TRIVY_URL:-https://github.com/aquasecurity/trivy/releases/download/v$TRIVY_VERSION}/trivy_${TRIVY_VERSION}_$file.tar.gz" -o "$tmp/trivy.tar.gz" \
            && echo "$sum  $tmp/trivy.tar.gz" | sha256sum -c - > /dev/null 2>&1 \
            && tar -xzf "$tmp/trivy.tar.gz" -C "$tmp" trivy && "$tmp/trivy" --version > /dev/null 2>&1; then
            install -m 755 -o root -g root "$tmp/trivy" /usr/local/bin/trivy && echo "$TRIVY_VERSION" > /etc/sentora-docker-node/trivy.version
            command -v restorecon > /dev/null 2>&1 && restorecon /usr/local/bin/trivy > /dev/null 2>&1
            note "Trivy $TRIVY_VERSION installed (checksum checked)."
        else
            note "Trivy could not be downloaded or did not match its checksum: the apps are not checked (see $LOG)."
        fi
        rm -rf "$tmp"
    fi
}
trivy_install
if [ -x /usr/local/bin/trivy ]; then
    # its own user (no login, no rights): it reads what the customers' images contain
    id sentora-scan > /dev/null 2>&1 || useradd --system --home-dir /var/lib/sentora-scan --no-create-home --shell "$(command -v nologin || echo /usr/sbin/nologin)" sentora-scan
    install -d -m 750 -o sentora-scan -g sentora-scan /var/lib/sentora-scan
    install -d -m 700 -o sentora-scan -g sentora-scan /var/lib/sentora-scan/cache
    # (the images being checked: root's folder, which only the check's user may also read)
    install -d -m 750 -o root -g sentora-scan /var/lib/sentora-scan/in
    rm -f /var/lib/sentora-scan/in/*.tar
    command -v restorecon > /dev/null 2>&1 && restorecon -R /var/lib/sentora-scan > /dev/null 2>&1
    # (started in its own folder: Trivy reads a trivy.yaml from where it is started)
    if (cd /var/lib/sentora-scan && runuser -u sentora-scan -- /usr/local/bin/trivy image --download-db-only --cache-dir /var/lib/sentora-scan/cache --quiet) >> "$LOG" 2>&1; then
        note "Image check ready: Trivy's database of known security holes is in place (brought up to date every night)."
    else
        note "Trivy's database could not be downloaded now; the agent tries again every night (see $LOG)."
    fi
    printf 'TRIVY=/usr/local/bin/trivy\nSCAN_USER=sentora-scan\n' >> /etc/sentora-docker-node/platform.conf
fi

ui_step "Web firewall for the apps (Caddy with Coraza)"
# Caddy built with the Coraza web firewall and the OWASP Core Rule Set (Docker Hosting 138, owner 2026-11-16):
# built by the "Caddy with Coraza" workflow, one file per processor, its SHA-256 pinned here (a file changed on
# the release is refused). It runs as the system's caddy service, under the same user and SELinux label
# (httpd_t) as the system's own Caddy, which stays installed and comes back when this one is not there.
CADDY_WAF_TAG=caddy-waf-2.11.9-coraza-2.6.2
CADDY_WAF_SHA256_X86_64=2f568a9e2b52ddf282c09f609e49f199aa55297832c9eb0522e621db014e4487
CADDY_WAF_SHA256_AARCH64=ed6ce39c53dfe5ab35df6a106e1539f2063040aa1c2ac370c93cc5a373ed1998
caddy_waf_install() {
    local file sum tmp
    case "$(uname -m)" in
        x86_64) file=caddy-sentora-amd64; sum=$CADDY_WAF_SHA256_X86_64 ;;
        aarch64) file=caddy-sentora-arm64; sum=$CADDY_WAF_SHA256_AARCH64 ;;
        *) note "Web firewall: no build for $(uname -m); the system's own Caddy serves the apps."; return 1 ;;
    esac
    if [ -x /usr/local/bin/caddy-sentora ] && echo "$sum  /usr/local/bin/caddy-sentora" | sha256sum -c - > /dev/null 2>&1; then
        note "Caddy with Coraza is in place ($(/usr/local/bin/caddy-sentora version 2> /dev/null | cut -d' ' -f1))."
        return 0
    fi
    tmp=$(mktemp -d)
    if curl -fsSL --proto =https,file --proto-redir =https "${SNODE_CADDY_WAF_URL:-https://github.com/RusTus/sentora-installers-2027/releases/download/$CADDY_WAF_TAG}/$file" -o "$tmp/caddy" \
        && echo "$sum  $tmp/caddy" | sha256sum -c - > /dev/null 2>&1 && chmod 755 "$tmp/caddy" && "$tmp/caddy" list-modules 2> /dev/null | grep -qx http.handlers.waf; then
        install -m 755 -o root -g root "$tmp/caddy" /usr/local/bin/caddy-sentora
        note "Caddy with Coraza installed: $(/usr/local/bin/caddy-sentora version 2> /dev/null | cut -d' ' -f1) (checksum checked)."
        rm -rf "$tmp"; return 0
    fi
    rm -rf "$tmp"
    note "Caddy with Coraza could not be downloaded or did not match its checksum: the system's own Caddy serves the apps, without the web firewall (see $LOG)."
    return 1
}
mkdir -p /etc/systemd/system/$CADDY_SERVICE.service.d
if caddy_waf_install; then
    if command -v getenforce > /dev/null 2>&1 && [ "$(getenforce)" != Disabled ]; then
        # (the same label as the system's Caddy: it runs confined as the web server, httpd_t)
        run semanage fcontext -a -t httpd_exec_t '/usr/local/bin/caddy-sentora' || run semanage fcontext -m -t httpd_exec_t '/usr/local/bin/caddy-sentora'
        restorecon /usr/local/bin/caddy-sentora > /dev/null 2>&1
    fi
    cat > /etc/systemd/system/$CADDY_SERVICE.service.d/sentora-waf.conf <<WAF_EOF
# Sentora Docker Node: the caddy service runs Caddy with the Coraza web firewall (/usr/local/bin/caddy-sentora);
# removing this file brings the system's own Caddy back (the apps' sites then have to be written without it).
# (also the check before it starts: the system's own unit may check the settings with its own Caddy, which does
# not know the firewall: AlmaLinux, Rocky, RHEL, Fedora)
[Service]
ExecStartPre=
ExecStartPre=/usr/local/bin/caddy-sentora validate --config $CADDY_DIR/Caddyfile
ExecStart=
ExecStart=/usr/local/bin/caddy-sentora run --environ --config $CADDY_DIR/Caddyfile
ExecReload=
ExecReload=/usr/local/bin/caddy-sentora reload --config $CADDY_DIR/Caddyfile --force
WAF_EOF
    CADDY_BIN=/usr/local/bin/caddy-sentora
    sed -i "s#^CADDY_BIN=.*#CADDY_BIN=$CADDY_BIN#" /etc/sentora-docker-node/platform.conf
    echo "CADDY_WAF=1" >> /etc/sentora-docker-node/platform.conf
else
    rm -f /etc/systemd/system/$CADDY_SERVICE.service.d/sentora-waf.conf
fi
systemctl daemon-reload

ui_step "Blocking repeat attackers (CrowdSec)"
# CrowdSec reads the apps' access log (Caddy), SSH and the system's logs, and an address that keeps attacking is
# blocked at the node's firewall (its nftables blocker) for a while (Docker Hosting 139, owner 2026-11-19).
# Local by default: nothing is shared with CrowdSec's servers until an administrator switches sharing on in the
# panel. From CrowdSec's own signed repository on every system (Debian and Ubuntu carry a 2023 version only,
# AlmaLinux, Rocky, RHEL and Fedora none): its key's fingerprint is checked here.
CROWDSEC_KEY_FPR=6A89E3C2303A901A889971D3376ED5326E93CD0C
crowdsec_install() {
    local tmp fpr
    if command -v cscli > /dev/null 2>&1 && [ -x /usr/bin/crowdsec ] && { [ -f /etc/apt/sources.list.d/sentora-crowdsec.list ] || [ -f /etc/yum.repos.d/sentora-crowdsec.repo ]; }; then
        note "CrowdSec is in place ($(cscli version 2> /dev/null | sed -n 's/^version: //p'))."
        return 0
    fi
    tmp=$(mktemp -d)
    if [ "$PKG" = apt ]; then
        command -v gpg > /dev/null 2>&1 || run $PKG_INSTALL gnupg || { rm -rf "$tmp"; return 1; }
        curl -fsSL --proto =https "https://packagecloud.io/crowdsec/crowdsec/gpgkey" -o "$tmp/key.asc" || { rm -rf "$tmp"; return 1; }
        fpr=$(gpg --show-keys --with-colons "$tmp/key.asc" 2> /dev/null | awk -F: '$1 == "fpr" {print $10; exit}')
        if [ "$fpr" != "$CROWDSEC_KEY_FPR" ]; then
            note "CrowdSec's signing key is not the one expected ($fpr): not installed."
            rm -rf "$tmp"; return 1
        fi
        install -d -m 755 /etc/apt/keyrings
        gpg --dearmor < "$tmp/key.asc" > /etc/apt/keyrings/sentora-crowdsec.gpg && chmod 644 /etc/apt/keyrings/sentora-crowdsec.gpg
        echo "deb [signed-by=/etc/apt/keyrings/sentora-crowdsec.gpg] https://packagecloud.io/crowdsec/crowdsec/any/ any main" > /etc/apt/sources.list.d/sentora-crowdsec.list
        run apt-get -q update
    else
        cat > /etc/yum.repos.d/sentora-crowdsec.repo <<'REPO_EOF'
[sentora-crowdsec]
name=CrowdSec (for Sentora Docker Node)
baseurl=https://packagecloud.io/crowdsec/crowdsec/rpm_any/rpm_any/$basearch
repo_gpgcheck=1
gpgcheck=1
enabled=1
gpgkey=https://packagecloud.io/crowdsec/crowdsec/gpgkey
       https://packagecloud.io/crowdsec/crowdsec/gpgkey/crowdsec-crowdsec-C822EDD6B39954A1.pub.gpg
       https://packagecloud.io/crowdsec/crowdsec/gpgkey/crowdsec-crowdsec-FED78314A2468CCF.pub.gpg
sslverify=1
REPO_EOF
    fi
    rm -rf "$tmp"
    # Local only before CrowdSec's first start, so it never pulls anything from CrowdSec's servers. On AlmaLinux,
    # Rocky, RHEL and Fedora it is set before the package, which then does not contact them at all. Debian's and
    # Ubuntu's package registers with them while installing and fails without that (found by the node test,
    # 2026-11-19): there it registers once (a machine account, no attack data), with its services kept from
    # starting meanwhile (policy-rc.d), and the registration is removed and local only set before it first runs.
    if [ "$PKG" = apt ]; then
        local policy=
        if [ ! -e /usr/sbin/policy-rc.d ]; then policy=1; printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d; chmod 755 /usr/sbin/policy-rc.d; fi
        run $PKG_INSTALL crowdsec crowdsec-firewall-bouncer-nftables; local rc=$?
        [ -n "$policy" ] && rm -f /usr/sbin/policy-rc.d
        [ $rc -eq 0 ] || return 1
    else
        if [ ! -f /etc/crowdsec/config.yaml.local ]; then
            install -d -m 755 /etc/crowdsec
            printf "# Written by Sentora Docker Node: local only, nothing is shared with CrowdSec's servers (the panel's switch).\napi:\n  server:\n    online_client: null\n" > /etc/crowdsec/config.yaml.local
        fi
        run $PKG_INSTALL crowdsec crowdsec-firewall-bouncer-nftables || return 1
    fi
    command -v cscli > /dev/null 2>&1
}
if crowdsec_install; then
    # local only: CrowdSec's central API off, and the registration its package made at install removed (it is
    # made again only when an administrator switches sharing on in the panel)
    if ! grep -q "sharing with CrowdSec's community is on" /etc/crowdsec/config.yaml.local 2> /dev/null; then
        printf "# Written by Sentora Docker Node: local only, nothing is shared with CrowdSec's servers (the panel's switch).\napi:\n  server:\n    online_client: null\n" > /etc/crowdsec/config.yaml.local
        rm -f /etc/crowdsec/online_api_credentials.yaml
    fi
    # the apps' access log (Caddy writes it, CrowdSec reads it), and what reads it
    install -d -m 750 -o caddy -g "$CADDY_GROUP" /var/log/caddy 2> /dev/null || install -d -m 750 /var/log/caddy
    [ -e /var/log/caddy/sentora-access.log ] || install -m 640 -o caddy -g "$CADDY_GROUP" /dev/null /var/log/caddy/sentora-access.log 2> /dev/null
    if command -v getenforce > /dev/null 2>&1 && [ "$(getenforce)" != Disabled ]; then
        run semanage fcontext -a -t httpd_log_t '/var/log/caddy(/.*)?' || run semanage fcontext -m -t httpd_log_t '/var/log/caddy(/.*)?'
        restorecon -R /var/log/caddy > /dev/null 2>&1
    fi
    run cscli hub update
    run cscli collections install crowdsecurity/linux crowdsecurity/sshd crowdsecurity/caddy
    install -d -m 755 /etc/crowdsec/acquis.d
    printf "# Written by Sentora Docker Node: the apps' access log (Caddy).\nfilenames:\n  - /var/log/caddy/sentora-access.log\nlabels:\n  type: caddy\n" > /etc/crowdsec/acquis.d/sentora-caddy.yaml
    # (the safe list: the agent writes it from the panel, with the panel's own addresses)
    install -d -m 755 /etc/crowdsec/parsers/s02-enrich
    # (never empty: CrowdSec refuses an empty one; the node's own local addresses are always on it)
    [ -f /etc/crowdsec/parsers/s02-enrich/sentora-safe-list.yaml ] || printf "name: sentora/safe-list\ndescription: \"Sentora: addresses never blocked\"\nwhitelist:\n  reason: \"Sentora safe list\"\n  ip:\n    - \"127.0.0.1\"\n    - \"::1\"\n" > /etc/crowdsec/parsers/s02-enrich/sentora-safe-list.yaml
    run systemctl enable crowdsec crowdsec-firewall-bouncer
    run systemctl restart crowdsec
    # (the blocker needs its key with CrowdSec's local API: its package makes it when CrowdSec runs)
    if ! grep -qE '^api_key: *[A-Za-z0-9]' /etc/crowdsec/bouncers/crowdsec-firewall-bouncer.yaml 2> /dev/null; then
        cscli bouncers delete sentora-firewall > /dev/null 2>&1
        k=$(cscli bouncers add sentora-firewall -o raw 2> /dev/null)
        [ -n "$k" ] && sed -i "s#^api_key:.*#api_key: $k#" /etc/crowdsec/bouncers/crowdsec-firewall-bouncer.yaml
    fi
    run systemctl restart crowdsec-firewall-bouncer
    if systemctl is-active --quiet crowdsec && systemctl is-active --quiet crowdsec-firewall-bouncer; then
        note "CrowdSec runs ($(cscli version 2> /dev/null | sed -n 's/^version: //p')), local only: repeat attackers are blocked at the node's firewall; nothing is shared."
        echo "CROWDSEC=1" >> /etc/sentora-docker-node/platform.conf
    else
        note "CrowdSec did not start (see journalctl -u crowdsec -u crowdsec-firewall-bouncer): this node blocks no repeat attackers."
    fi
else
    note "CrowdSec could not be installed (see $LOG): this node blocks no repeat attackers."
fi

ui_step "Web server (Caddy, automatic HTTPS)"
mkdir -p $CADDY_DIR/sentora
[ -f $CADDY_DIR/Caddyfile ] && [ ! -f $CADDY_DIR/Caddyfile.before-sentora ] && cp -p $CADDY_DIR/Caddyfile $CADDY_DIR/Caddyfile.before-sentora
{
    echo "# Written by the Sentora Docker Node installer. The containers' sites are in sentora/ (the agent writes them)."
    echo "{"
    [ -n "$EMAIL" ] && echo "	email $EMAIL"
    # (install test only: certificates from Caddy's own local authority, as the test has no public name)
    [ "${SNODE_TEST_LOCAL_CERTS:-}" = 1 ] && echo "	local_certs"
    # Caddy must not try to put its own certificate authority into this server's trust store: it would
    # need sudo (which SELinux rightly refuses, and the node does not need it)
    echo "	skip_install_trust"
    echo "	admin localhost:2019"
    # (with the web firewall: only what it finds goes to the journal, not the many notes it writes on every request)
    if grep -q '^CADDY_WAF=1' /etc/sentora-docker-node/platform.conf 2> /dev/null; then
        echo "	log {"; echo "		exclude http.handlers.waf"; echo "	}"
        echo "	log sentora-waf {"; echo "		include http.handlers.waf"; echo "		level ERROR"; echo "	}"
    fi
    echo "}"
    echo ""
    echo "import $CADDY_DIR/sentora/*.caddy"
} > $CADDY_DIR/Caddyfile
[ -f $CADDY_DIR/sentora/sites.caddy ] || echo "# Written by Sentora Docker Node (sentora-docker-node-agent): no containers yet." > $CADDY_DIR/sentora/sites.caddy
run "$CADDY_BIN" validate --config $CADDY_DIR/Caddyfile --adapter caddyfile || die "Caddy does not accept its settings (see $LOG)."
ui_step "Firewall (only SSH, HTTP and HTTPS open)"
SSH_PORTS=$(sshd -T 2> /dev/null | awk '$1 == "port" {print $2}' | sort -u | tr '\n' ' ')
SSH_PORTS="${SSH_PORTS:-22} ${SSH_CONNECTION:+${SSH_CONNECTION##* }}"
SSH_PORTS=$(echo $SSH_PORTS | tr ' ' '\n' | sort -un | tr '\n' ' '); SSH_PORTS=${SSH_PORTS% }
# (the system's own firewall: ufw on Debian/Ubuntu, firewalld elsewhere, as the panel's installers do; one
# that is already on is kept)
if systemctl is-active --quiet firewalld 2> /dev/null; then FIREWALL=firewalld
elif command -v ufw > /dev/null 2>&1 && ufw status 2> /dev/null | grep -q '^Status: active'; then FIREWALL=ufw; fi
if [ "$FIREWALL" = ufw ]; then
    command -v ufw > /dev/null 2>&1 || run $PKG_INSTALL ufw || die "Could not install ufw (see $LOG)."
    for p in $SSH_PORTS; do run ufw allow "$p/tcp"; done
    for p in 80/tcp 443/tcp 443/udp; do run ufw allow "$p"; done
    if ! ufw status 2> /dev/null | grep -q '^Status: active'; then
        run ufw default deny incoming; run ufw default allow outgoing; run ufw --force enable
    fi
    if ufw status 2> /dev/null | grep -q '^Status: active'; then note "ufw: only SSH, HTTP and HTTPS open."; else echo "WARNING: ufw did not switch on (see $LOG): no firewall on this node"; fi
else
    if ! command -v firewall-cmd > /dev/null 2>&1; then run $PKG_INSTALL "$FIREWALLD_PKG" || die "Could not install firewalld (see $LOG)."; fi
    run systemctl enable --now firewalld
    for p in $SSH_PORTS; do run firewall-cmd --permanent --add-port="$p/tcp"; done
    for s in ssh http https; do run firewall-cmd --permanent --add-service=$s; done
    run firewall-cmd --permanent --add-port=443/udp
    run firewall-cmd --reload
    if systemctl is-active --quiet firewalld; then note "firewalld: only SSH, HTTP and HTTPS open."; else echo "WARNING: firewalld did not start (journalctl -u firewalld): no firewall on this node"; fi
fi

ui_step "SELinux / AppArmor"
if [ "$MAC" = apparmor ]; then
    if [ "$(cat /sys/module/apparmor/parameters/enabled 2> /dev/null)" = Y ]; then
        note "AppArmor is on: Caddy and Podman run under the system's own profiles; nothing was widened."
    else
        note "AppArmor is off on this system (it was not switched off by Sentora)."
    fi
elif command -v getenforce >/dev/null 2>&1 && [ "$(getenforce)" != Disabled ]; then
    # Caddy (httpd_t) may forward to the containers' ports only: label them as web cache ports and allow relaying
    if ! run semanage port -a -t http_cache_port_t -p tcp 20000-29999; then run semanage port -m -t http_cache_port_t -p tcp 20000-29999; fi
    run setsebool -P httpd_can_network_relay 1
    note "SELinux is $(getenforce): Caddy may reach ports 20000-29999 and web ports, nothing else was widened."
else
    note "SELinux is off on this system (it was not switched off by Sentora)."
fi
ui_step "Starting Caddy"
run systemctl enable "$CADDY_SERVICE"
run systemctl restart "$CADDY_SERVICE" || die "Caddy did not start (see $LOG and journalctl -u $CADDY_SERVICE)."

ui_step "The agent (Sentora's own software on the node)"
mkdir -p "$LIB"; chmod 755 "$LIB"
rm -f "$LIB/sentora-docker-node-agent.php.new"
if [ -n "$AGENT" ]; then
    cp "$AGENT" "$LIB/sentora-docker-node-agent.php.new" || die "No agent at $AGENT."
else
    curl -fsSL --proto =https,file --proto-redir =https "${SNODE_RAW_BASE:-$RAW_BASE}/sentora-docker-node-agent.php" -o "$LIB/sentora-docker-node-agent.php.new" || die "Could not download the agent."
fi
php -l "$LIB/sentora-docker-node-agent.php.new" >> "$LOG" 2>&1 || { rm -f "$LIB/sentora-docker-node-agent.php.new"; die "The agent is damaged (see $LOG): nothing changed."; }
# the one that ran before is kept, to go back to when the new one does not start
[ -f "$LIB/sentora-docker-node-agent.php" ] && cp -p "$LIB/sentora-docker-node-agent.php" "$LIB/sentora-docker-node-agent.php.previous"
chmod 755 "$LIB/sentora-docker-node-agent.php.new"
mv "$LIB/sentora-docker-node-agent.php.new" "$LIB/sentora-docker-node-agent.php"
# (this installer is kept too: sentora-docker-node-update compares it with the newest)
if [ -f "$0" ] && [ "$0" != "$LIB/installer" ]; then cp "$0" "$LIB/installer"; chmod 700 "$LIB/installer"; fi
cat > /usr/local/sbin/sentora-docker-node-agent <<EOF
#!/bin/sh
exec $PHP_BIN $LIB/sentora-docker-node-agent.php "\$@"
EOF
chmod 755 /usr/local/sbin/sentora-docker-node-agent
cat > /usr/local/sbin/sentora-docker-node-relink <<'RELINK_EOF'
#!/bin/sh
# Sentora Docker Node: link this node again, keeping every app and its data.
#   sentora-docker-node-relink --panel https://panel.example            the same panel at a new address (only the address
#                                                                 changes), or another panel (new node key to add there)
#   sentora-docker-node-relink --panel https://panel.example --new-key  the same panel, which no longer knows this node
