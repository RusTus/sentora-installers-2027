policy_module(sentora_runsc, 1.0)

# Sentora Docker Node: gVisor (runsc) for the apps with Extra isolation, under SELinux (2026-11-24).
#
# runsc takes no SELinux label of its own, so the wrapper (/usr/local/bin/runsc-sentora) starts it in this domain
# at the app's own MCS level, the one Podman chose for the app: the sandbox (gVisor's kernel, which runs the app)
# and its file helper (gofer) are confined as an app is under container_t, and one app's sandbox can reach none
# of another app's files (MCS). The domain is made with container-selinux's own template, as its container
# domains are; on top of that only what runsc needs to set itself up (found on a real AlmaLinux 10 by the probe,
# .github/workflows/gvisor-selinux-probe.yml): its own state, mounts inside its own private namespace, and the
# same network as container_t.

gen_require(`
	type container_runtime_t;
	type container_file_t;
	type user_tmp_t;
	type proc_t;
	type tmpfs_t;
	type root_t;
	type tmp_t;
	attribute container_net_domain;
')

type sentora_runsc_exec_t;
container_domain_template(sentora_runsc, container)
domain_entry_file(sentora_runsc_t, sentora_runsc_exec_t)

# the same network as container_t (an app listens on its port inside its own network namespace)
typeattribute sentora_runsc_t container_net_domain;

# gVisor's state (locks, state, control socket, its empty network namespace file, the pid file Podman asks for):
# /run/user/<uid>/sentora-runsc/<container id>, made by the wrapper (as Podman's conmon runs) at the app's own
# level, so what a sandbox writes there has the app's categories and no other app's sandbox can touch it. The
# sandbox gets no access to Podman's own folders (the wrapper copies the pid file there).
type sentora_runsc_state_t;
files_type(sentora_runsc_state_t)
filetrans_pattern(container_runtime_t, user_tmp_t, sentora_runsc_state_t, dir, "sentora-runsc")
manage_dirs_pattern(container_runtime_t, sentora_runsc_state_t, sentora_runsc_state_t)
manage_files_pattern(container_runtime_t, sentora_runsc_state_t, sentora_runsc_state_t)
manage_sock_files_pattern(container_runtime_t, sentora_runsc_state_t, sentora_runsc_state_t)
allow container_runtime_t sentora_runsc_state_t:dir { relabelfrom relabelto };
allow sentora_runsc_t user_tmp_t:dir search_dir_perms;
allow sentora_runsc_t sentora_runsc_state_t:dir rw_dir_perms;
manage_files_pattern(sentora_runsc_t, sentora_runsc_state_t, sentora_runsc_state_t)
manage_sock_files_pattern(sentora_runsc_t, sentora_runsc_state_t, sentora_runsc_state_t)
allow sentora_runsc_t sentora_runsc_state_t:file mounton;

# started by Podman's conmon (container_runtime_t) through the wrapper; runsc then runs itself again (sandbox,
# gofer) and its helper (gvisor-bin), all labelled sentora_runsc_exec_t
allow container_runtime_t sentora_runsc_t:process transition;
allow container_runtime_t sentora_runsc_exec_t:file { mmap_exec_file_perms execute_no_trans };
allow container_runtime_t sentora_runsc_t:process { signal sigkill signull sigstop };
allow container_runtime_t sentora_runsc_t:unix_stream_socket connectto;
allow sentora_runsc_t sentora_runsc_exec_t:file { mmap_exec_file_perms execute_no_trans };
allow sentora_runsc_t container_runtime_t:fd use;
allow sentora_runsc_t container_runtime_t:fifo_file { rw_fifo_file_perms setattr };
allow sentora_runsc_t container_runtime_t:process sigchld;
# (runsc sets its standard input's owner to its own: /dev/null for an app; the owner can not change, as /dev/null
# is root's and the app runs as the customer)
dev_setattr_null_dev(sentora_runsc_t)

# setting itself up inside its own mount namespace: a proc of its own, the root and /var/tmp as mount points
allow sentora_runsc_t proc_t:filesystem { mount unmount };
allow sentora_runsc_t tmpfs_t:filesystem remount;
allow sentora_runsc_t { root_t tmp_t }:dir mounton;
