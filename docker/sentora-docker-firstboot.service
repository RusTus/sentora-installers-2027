[Unit]
Description=Sentora 2027: install on the container's first start
# (after the system is up: the installer starts and restarts services itself)
After=multi-user.target network-online.target
Wants=network-online.target
ConditionPathExists=!/etc/sentora/.docker-installed

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/sentora-docker-firstboot
TimeoutStartSec=0
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
