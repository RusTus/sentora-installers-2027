#!/usr/bin/env bash
# Sentora 2027 in Docker: install Sentora the first time the container starts, with the settings
# given to docker run, so every container has its own passwords, keys and certificate. Run by
# sentora-docker-firstboot.service; does nothing once /etc/sentora/.docker-installed exists.
#
#   SENTORA_DOMAIN  the panel's address, e.g. panel.example.com (default: docker run --hostname)
#   SENTORA_EMAIL   your email address, for server alerts (needed)
#   SENTORA_IP      the server's IPv4 address, or public (default) or local
#   TZ              time zone, e.g. America/Chicago (default UTC)
#   ADMIN_NAME ADMIN_PHONE ADMIN_ADDRESS ADMIN_PROVINCE ADMIN_POSTALCODE ADMIN_COUNTRY
#                   zadmin's profile (optional; changed later in the panel)
#
# FTP's passive ports are 61000-61099 in a container (see below).
# Progress goes to the container's log (docker logs); passwords never do: they are in
# /root/passwords.txt inside the container, readable by root only.
set -uo pipefail
umask 022   # (as on a server: the installer sets each file's own permissions)
DONE=/etc/sentora/.docker-installed
SCREEN=/root/sentora-install-screen.txt
[ -f "$DONE" ] && exit 0
say() { printf 'sentora: %s\n' "$*"; }

# systemd does not hand docker run's -e settings to services: read them from PID 1
while IFS= read -r -d '' kv; do
    case "$kv" in SENTORA_*=*|ADMIN_*=*|TZ=*) export "${kv?}" ;; esac
done < /proc/1/environ

# (the panel's address: SENTORA_DOMAIN, or else the name given with docker run --hostname)
DOMAIN=$(printf '%s' "${SENTORA_DOMAIN:-$(hostname -f 2> /dev/null || hostname)}" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
EMAIL=${SENTORA_EMAIL:-${ADMIN_EMAIL:-}}
IP=${SENTORA_IP:-public}
TZONE=${TZ:-UTC}
missing=0
if [[ ! "$DOMAIN" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\.[a-z]{2,63}$ ]]; then
    say "No panel address: start the container with the panel's name, e.g. --hostname panel.example.com"
    missing=1
fi
if [[ ! "$EMAIL" =~ ^[^@[:space:]]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,63}$ ]]; then
    say "SENTORA_EMAIL is missing or not an email address: give yours, e.g. -e SENTORA_EMAIL=you@example.com"
    missing=1
fi
if [ ! -f "/usr/share/zoneinfo/$TZONE" ]; then
    say "TZ=$TZONE is not a time zone (for example America/Chicago or Europe/Paris)"
    missing=1
fi
if [ $missing -eq 1 ]; then
    say "Nothing was installed. Remove this container and start a new one with the settings above."
    exit 1
fi

say "Installing Sentora 2027 for https://$DOMAIN (about 10 minutes; this container's log shows each step)"
export ADMIN_EMAIL="$EMAIL"
export ADMIN_NAME="${ADMIN_NAME:-Administrator}" ADMIN_PHONE="${ADMIN_PHONE:--}" ADMIN_ADDRESS="${ADMIN_ADDRESS:--}"
export ADMIN_PROVINCE="${ADMIN_PROVINCE:--}" ADMIN_POSTALCODE="${ADMIN_POSTALCODE:--}" ADMIN_COUNTRY="${ADMIN_COUNTRY:--}"
cd /root || exit 1
# (its screen ends with the passwords: root's eyes only from the start; tee keeps the file's mode)
install -m 600 /dev/null "$SCREEN"
# Only the step lines reach the log (the installer's last screen lists the passwords)
bash /usr/local/share/sentora/sentora2027-deb13 -t "$TZONE" -d "$DOMAIN" -i "$IP" < /dev/null 2>&1 \
    | tee "$SCREEN" | sed -u -n 's/\x1b\[[0-9;]*m//g; /^-- \[[0-9]*\/[0-9]*\] /p; /^  *Stopped:/p'
if ! grep -q "Sentora is installed" "$SCREEN"; then
    say "The installation did not finish. Its screen: docker exec <container> cat $SCREEN"
    say "Its log: docker exec <container> sh -c 'cat /root/*_sentora_install.log'"
    exit 1
fi
# FTP's passive ports: a range Docker can publish (-p 61000-61099:61000-61099). Sentora's own
# 60000-65535 overlaps the ports Linux uses for its outgoing connections (32768-60999), so a host
# often has one of them in use and Docker can't publish the range; 100 ports = 100 transfers at once.
FTPCONF=/etc/sentora/configs/proftpd/proftpd-mysql.conf
if [ -f "$FTPCONF" ]; then
    sed -i 's/^PassivePorts[[:space:]].*/PassivePorts\t\t\t61000 61099/' "$FTPCONF"
    systemctl restart proftpd 2> /dev/null
fi
mkdir -p /etc/sentora && date -u '+%Y-%m-%dT%H:%M:%SZ' > "$DONE"
say "Sentora is installed: https://$DOMAIN"
say "Log in as zadmin. Its password and every other one: docker exec <container> cat /root/passwords.txt"
say "Then, inside the container: sentora-post-install-check"
