#!/bin/bash
# sentora-web-probe: look at the panel from outside, the way a visitor (or an attacker)
# would: security headers and cookies, files and folders that must not be served, the
# web apps' version leaks, Apache's status pages, HTTP methods, the web service API key.
# Read-only: it changes nothing, guesses no passwords and prints no secrets.
#
#   sentora-web-probe                    the panel's own address (from the panel's settings)
#   sentora-web-probe panel.example.com  any Sentora panel (run it from another machine too)
#
# Exit code: 0 when nothing failed.

HOST="${1:-}"
if [ -z "$HOST" ] && [ -f /etc/sentora/panel/cnf/db.php ]; then
    HOST=$(mysql --defaults-extra-file=<(printf '[client]\nuser=%s\npassword=%s\n' \
        "$(grep -o "\$user = '[^']*'" /etc/sentora/panel/cnf/db.php | cut -d"'" -f2)" \
        "$(grep -o "\$pass = '[^']*'" /etc/sentora/panel/cnf/db.php | cut -d"'" -f2)") \
        -N -B -e "SELECT so_value_tx FROM sentora_core.x_settings WHERE so_name_vc='sentora_domain'" 2> /dev/null)
fi
[ -n "$HOST" ] || { echo "Usage: sentora-web-probe <panel address>"; exit 2; }
HOST=${HOST#https://}; HOST=${HOST#http://}; HOST=${HOST%%/*}
BASE="https://$HOST"
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
OKS=0; WARNS=0; FAILS=0
ok() { echo "  OK    $*"; OKS=$((OKS + 1)); }
warn() { echo "  WARN  $*"; WARNS=$((WARNS + 1)); }
fail() { echo "  FAIL  $*"; FAILS=$((FAILS + 1)); }
# -k: the panel may still have its self-signed certificate (checked separately below)
get() { curl -sk --max-time 20 -o "$TMP/body" -D "$TMP/head" -w '%{http_code}' "$@"; }

echo "Sentora web probe, $(date '+%Y-%m-%d %H:%M %Z'): $BASE"

echo; echo "== Connection"
code=$(get "$BASE/")
[ "$code" = "000" ] && { fail "the panel does not answer at $BASE"; echo; echo "Result: $OKS OK, $WARNS WARN, $FAILS FAIL"; exit 1; }
ok "the panel answers over HTTPS ($code)"
if curl -s --max-time 20 -o /dev/null "$BASE/" 2> /dev/null; then ok "its certificate is trusted"
else warn "its certificate is not trusted by this machine (self-signed: issue one with Sencrypt once the name is in public DNS)"; fi
rc=$(curl -s --max-time 20 -o /dev/null -w '%{http_code} %{redirect_url}' "http://$HOST/")
case "$rc" in 30[1278]\ https://*) ok "plain HTTP sends visitors to HTTPS" ;; *) warn "plain HTTP does not redirect to HTTPS ($rc)" ;; esac

echo; echo "== Security headers on the panel"
hdr() { grep -i "^$1:" "$TMP/head" | head -1 | cut -d: -f2- | tr -d '\r' | sed 's/^ //'; }
for h in Strict-Transport-Security Content-Security-Policy X-Frame-Options X-Content-Type-Options Referrer-Policy; do
    v=$(hdr "$h"); if [ -n "$v" ]; then ok "$h"; else fail "no $h header"; fi
done
srv=$(hdr Server); case "$srv" in ""|Apache) ok "the Server header names no version (${srv:-none})" ;; *) warn "the Server header says: $srv" ;; esac
xp=$(hdr X-Powered-By); [ -z "$xp" ] && ok "no X-Powered-By header" || warn "X-Powered-By says: $xp"
ck=$(grep -i '^set-cookie:' "$TMP/head" | head -1)
if [ -n "$ck" ]; then
    for f in Secure HttpOnly SameSite; do echo "$ck" | grep -qi "$f" && ok "session cookie: $f" || fail "session cookie without $f"; done
fi

echo; echo "== Files and folders that must not be served"
nope() { # path what
    local c; c=$(get "$BASE$1")
    case "$c" in 403|404) ok "$2 ($1: $c)" ;;
        200) if grep -qiE '<title>(Index of|Sentora)|login' "$TMP/body" && ! grep -qiE 'Index of' "$TMP/body"; then ok "$2 ($1: the login page)"; else fail "$2 is served ($1: 200, $(wc -c < "$TMP/body") bytes)"; fi ;;
        30*) ok "$2 ($1: redirected)" ;;
        *) warn "$2 ($1: $c)" ;; esac
}
nope /cnf/db.php "the panel's database password"
nope /cnf/security.php "the panel's encryption key"
nope /dryden/loader.inc.php "the panel's code"
nope /inc/dbc.inc.php "the panel's code"
nope /bin/daemon.php "the daemon"
nope /bin/sentora-offsite-backup "the backup tool"
nope /modules/backup_admin/hooks/OnDaemonRun.hook.php "a daemon job"
nope /etc/tmp/ "the template cache"
nope /CHANGELOG.md "the change log (lists every security fix)"
nope /README.md "the read-me"
nope /.git/HEAD "a git folder"
nope /.env "an environment file"
nope /phpinfo.php "a phpinfo page"
nope /etc/apps/phpmyadmin/setup/ "phpMyAdmin's setup"
nope /etc/apps/phpmyadmin/config.inc.php "phpMyAdmin's settings"
nope /etc/apps/webmail/installer/ "Roundcube's installer"
nope /etc/apps/webmail/config/config.inc.php "Roundcube's settings"
nope /etc/apps/webmail/logs/errors.log "Roundcube's error log"
nope /etc/apps/webmail/temp/ "Roundcube's temporary files"
nope /etc/apps/matomo/config/config.ini.php "Matomo's settings"
nope /etc/apps/matomo/tmp/ "Matomo's temporary files"
for d in /etc/ /etc/apps/ /etc/lib/ /modules/ /modules/cron/ /etc/styles/; do
    c=$(get "$BASE$d"); if [ "$c" = 200 ] && grep -qi 'Index of' "$TMP/body"; then fail "folder listing is on: $d"; else ok "no folder listing: $d ($c)"; fi
done

echo; echo "== Versions the web apps show to anyone"
leak() { # path what
    local c; c=$(get "$BASE$1")
    if [ "$c" = 200 ] && [ -s "$TMP/body" ]; then warn "$2 is readable ($1): it names the exact version"; else ok "$2 is not readable ($1: $c)"; fi
}
leak /etc/apps/phpmyadmin/ChangeLog "phpMyAdmin's change log"
leak /etc/apps/phpmyadmin/README "phpMyAdmin's read-me"
leak /etc/apps/webmail/CHANGELOG.md "Roundcube's change log"
leak /etc/apps/webmail/composer.json "Roundcube's package list"
leak /etc/apps/matomo/CHANGELOG.md "Matomo's change log"

echo; echo "== Apache's status pages"
# Apache lets the server itself see them (Require local: its own addresses count as local),
# so from the server an answer proves nothing about visitors
LOCAL=no
MINE=$( { ip -o addr show 2> /dev/null | awk '{print $4}' | cut -d/ -f1; hostname -I 2> /dev/null | tr ' ' '\n'; } | sort -u)
for a in $(getent ahosts "${HOST%%:*}" 2> /dev/null | awk '{print $1}' | sort -u); do
    case "$a" in 127.*|::1) LOCAL=yes ;; esac
    if printf '%s\n' "$MINE" | grep -qx "$a"; then LOCAL=yes; fi
done
for p in /server-status /server-info; do
    c=$(get "$BASE$p")
    if [ "$c" = 200 ] && grep -qiE 'Apache Server (Status|Information)' "$TMP/body"; then
        if [ "$LOCAL" = yes ]; then
            warn "$p answers here, but this probe runs on the server itself, which Apache allows; run sentora-web-probe $HOST from another machine to check visitors are refused"
        else
            fail "$p is open to visitors"
        fi
    else
        ok "$p is closed ($c)"
    fi
done

echo; echo "== HTTP methods"
c=$(curl -sk --max-time 20 -o /dev/null -w '%{http_code}' -X TRACE "$BASE/")
[ "$c" = 200 ] && fail "TRACE is answered" || ok "TRACE is refused ($c)"

echo; echo "== Web service API"
# The key every Sentora shipped with is public: with it alone the API resets passwords,
# so it must be refused. A harmless read-only request; the answer is not printed.
c=$(get -X POST --data '<?xml version="1.0" encoding="UTF-8"?><xmws><apikey>ee8795c8c53bfdb3b2cc595186b68912</apikey><request>GetAllPackages</request><authuser></authuser><authpass></authpass><content></content></xmws>' "$BASE/api/packages")
if grep -q '<response>1103</response>' "$TMP/body"; then ok "the public default API key is refused"
elif grep -q '<xmws>' "$TMP/body"; then fail "THE PUBLIC DEFAULT API KEY IS ACCEPTED: anyone can reset passwords (update Sentora now)"
else ok "the API is not reachable with the public key ($c)"; fi

echo; echo "Result: $OKS OK, $WARNS WARN, $FAILS FAIL"
[ "$FAILS" -eq 0 ]
