#!/bin/bash
echo "systemd-run $*" >> "$FAKE_DIR/calls.log"
# (--scope: the command runs here and now, as systemd-run does; options before it, -p with its value)
for a in "$@"; do
    if [ "$a" = --scope ]; then
        while [ "${1#-}" != "$1" ]; do case "$1" in -p|--property|--unit|--slice|--uid) shift 2 ;; *) shift ;; esac; done
        exec "$@"
    fi
done
exit 0
