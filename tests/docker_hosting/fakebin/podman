#!/bin/bash
# fake rootless podman: one folder per user ($FAKE_USER)
echo "podman[${FAKE_USER:-root}] $*" >> "$FAKE_DIR/calls.log"
[ "$1" = --version ] && { echo "podman version 5.6.0"; exit 0; }
[ -n "${FAKE_USER:-}" ] || { echo "not as root" >&2; exit 125; }
[ "$XDG_RUNTIME_DIR" = "$SNODE_RUN/$(cat "$FAKE_DIR/users/$FAKE_USER")" ] || { echo "wrong XDG_RUNTIME_DIR $XDG_RUNTIME_DIR" >&2; exit 125; }
P=$FAKE_DIR/podman/$FAKE_USER; mkdir -p "$P/c" "$P/v"
last=${!#}
case "$1" in
  container) [ "$2" = exists ] && [ -d "$P/c/$3" ]; exit $? ;;
  pull) case "$last" in *nopull*) echo "Error: initializing source: manifest unknown"; exit 125 ;; esac; echo sha256:abc; exit 0 ;;
  create)
    name=''; args=("$@"); for ((i=0; i<${#args[@]}; i++)); do
      [ "${args[$i]}" = --name ] && name=${args[$((i+1))]}
      [ "${args[$i]}" = --volume ] && { v=${args[$((i+1))]}; mkdir -p "$P/v/${v%%:*}"; }
    done
    [ -d "$P/c/$name" ] && { echo "Error: name in use"; exit 125; }
    mkdir -p "$P/c/$name"; printf '%s\n' "$@" > "$P/c/$name/args"; echo created > "$P/c/$name/state"; echo id123; exit 0 ;;
  start) [ -d "$P/c/$last" ] || { echo "Error: no such container $last"; exit 125; }; [ -f "$FAKE_DIR/start-fail" ] && { echo "Error: crun: OCI runtime error"; exit 126; }; echo running > "$P/c/$last/state"; echo "$last"; exit 0 ;;
  stop) [ -d "$P/c/$last" ] || exit 125; echo exited > "$P/c/$last/state"; exit 0 ;;
  restart) [ -d "$P/c/$last" ] || exit 125; echo running > "$P/c/$last/state"; exit 0 ;;
  update) [ -d "$P/c/$last" ] || exit 125; echo "$*" >> "$P/c/$last/updates"; exit 0 ;;
  logs) [ -d "$P/c/$last" ] || exit 125; echo "fake log of $last: listening"; exit 0 ;;
  rm) rm -rf "$P/c/$last"; exit 0 ;;
  volume)
    case "$2" in
      ls) pre=${last#name=^}; pre=${pre%%-\[*}; ls "$P/v" | grep "^$pre-" ; exit 0 ;;
      inspect) [ -d "$P/v/$last" ] || { echo "Error: no such volume"; exit 125; }; echo "$P/v/$last"; exit 0 ;;
      rm) rm -rf "$P/v/$last"; exit 0 ;;
    esac ;;
  ps)
    out='['; sep=''
    for d in "$P"/c/*/; do [ -d "$d" ] || continue; n=$(basename "$d"); out="$out$sep{\"Names\":[\"$n\"],\"State\":\"$(cat "$d/state")\",\"Labels\":{\"sentora.cid\":\"${n#sdh-}\"}}"; sep=','; done
    echo "$out]"; exit 0 ;;
esac
echo "fake podman: unknown $*" >&2; exit 125
