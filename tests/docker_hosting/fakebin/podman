#!/bin/bash
# fake rootless podman: one folder per user ($FAKE_USER)
echo "podman[${FAKE_USER:-root}] $*" >> "$FAKE_DIR/calls.log"
[ "$1" = --version ] && { echo "podman version 5.6.0"; exit 0; }
[ -n "${FAKE_USER:-}" ] || { echo "not as root" >&2; exit 125; }
[ "$XDG_RUNTIME_DIR" = "$SNODE_RUN/$(cat "$FAKE_DIR/users/$FAKE_USER")" ] || { echo "wrong XDG_RUNTIME_DIR $XDG_RUNTIME_DIR" >&2; exit 125; }
P=$FAKE_DIR/podman/$FAKE_USER; mkdir -p "$P/c" "$P/v"
last=${!#}
reg() { local f="$FAKE_DIR/registry/$(echo "$1" | tr '/:' '__')"; if [ -f "$f" ]; then cat "$f"; else echo "id-$(echo "$1" | tr '/:' '__')-1 sha256:$(printf '1%.0s' $(seq 1 64))"; fi; }
mkdir -p "$P/i"
case "$1" in
  container)
    case "$2" in
      exists) [ -d "$P/c/$3" ]; exit $? ;;
      inspect)
        [ -d "$P/c/$last" ] || { echo "Error: no such container $last"; exit 125; }
        case "$*" in
          *PortBindings*) v=$(grep -A1 -x -- --publish "$P/c/$last/args" | tail -1); echo "${v%:*} "; exit 0 ;;
          *NanoCpus*) c=$(grep -A1 -x -- --cpus "$P/c/$last/args" | tail -1); m=$(grep -A1 -x -- --memory "$P/c/$last/args" | tail -1)
            php -r 'echo (int) round((float) $argv[1] * 1e9), " ", (int) $argv[2] * 1048576, "\n";' "$c" "${m%m}"; exit 0 ;;
          *Config.Env*) grep -A1 -x -- --env "$P/c/$last/args" | grep -vx -- --env | grep -vx -- -- | php -r '$o = array("PATH=/usr/bin", "container=podman", "HOSTNAME=abc");
            foreach (file("php://stdin", FILE_IGNORE_NEW_LINES) as $l) { $o[] = $l; } echo json_encode($o), "\n";'; exit 0 ;;
          *.ImageName*) tail -1 "$P/c/$last/args"; exit 0 ;;
          *.Image*) cat "$P/c/$last/imageid"; exit 0 ;;
          *State.Status*) cat "$P/c/$last/state"; exit 0 ;;
        esac ;;
    esac ;;
  pull) for ((k=1; k<=$#; k++)); do [ "${!k}" = --authfile ] && { j=$((k+1)); f=${!j}; [ -f "$f" ] && { cat "$f"; echo " mode=$(stat -c %a "$f") at=$f"; } >> "$FAKE_DIR/authfiles.log"; }; done
        case "$last" in *nopull*) echo "Error: initializing source: manifest unknown"; exit 125 ;; esac; reg "$last" > "$P/i/$(echo "$last" | tr '/:' '__')"; echo sha256:abc; exit 0 ;;
  image)
    f="$P/i/$(echo "$last" | tr '/:' '__')"
    case "$*" in
      *Config.Env*) echo '["PATH=/usr/bin"]'; exit 0 ;;
      "image save --output "*) [ -f "$FAKE_DIR/save-fail" ] && { echo "Error: save failed"; exit 125; }; echo "$last" > "$4"; exit 0 ;;
      "image load --input "*) [ -f "$4" ] || exit 125; echo "Loaded image: $(cat "$4")"; exit 0 ;;
      *prune*) exit 0 ;;
      *RepoDigests*) [ -f "$f" ] || exit 125; echo "[\"${last%%:*}@$(cut -d' ' -f2 "$f")\"]"; exit 0 ;;
      *Id*) [ -f "$f" ] || exit 125; cut -d' ' -f1 "$f"; exit 0 ;;
    esac ;;
  rename) [ -d "$P/c/$2" ] && [ ! -e "$P/c/$3" ] || exit 125; mv "$P/c/$2" "$P/c/$3"; exit 0 ;;
  create)
    name=''; args=("$@"); for ((i=0; i<${#args[@]}; i++)); do
      [ "${args[$i]}" = --name ] && name=${args[$((i+1))]}
      [ "${args[$i]}" = --volume ] && { v=${args[$((i+1))]}; mkdir -p "$P/v/${v%%:*}"; }
    done
    [ -d "$P/c/$name" ] && { echo "Error: name in use"; exit 125; }
    mkdir -p "$P/c/$name"; printf '%s\n' "$@" > "$P/c/$name/args"; echo created > "$P/c/$name/state"
    f="$P/i/$(echo "$last" | tr '/:' '__')"; if [ -f "$f" ]; then cut -d' ' -f1 "$f" > "$P/c/$name/imageid"; elif [[ "$last" != */* ]]; then echo "$last" > "$P/c/$name/imageid"; else echo none > "$P/c/$name/imageid"; fi; echo id123; exit 0 ;;
  start) [ -d "$P/c/$last" ] || { echo "Error: no such container $last"; exit 125; }; [ -f "$FAKE_DIR/start-fail" ] && { echo "Error: crun: OCI runtime error"; exit 126; }
    # an image that crashes at once (for the update's rollback)
    # (and one with a setting it does not start with)
    if [ -f "$FAKE_DIR/crash-id" ] && [ "$(cat "$P/c/$last/imageid")" = "$(cat "$FAKE_DIR/crash-id")" ]; then echo exited > "$P/c/$last/state";
    elif [ -f "$FAKE_DIR/crash-env" ] && grep -qxF "$(cat "$FAKE_DIR/crash-env")" "$P/c/$last/args"; then echo exited > "$P/c/$last/state";
    else echo running > "$P/c/$last/state"; fi; echo "$last"; exit 0 ;;
  stop) [ -d "$P/c/$last" ] || exit 125; echo exited > "$P/c/$last/state"; exit 0 ;;
  restart) [ -d "$P/c/$last" ] || exit 125; echo running > "$P/c/$last/state"; exit 0 ;;
  update) [ -d "$P/c/$last" ] || exit 125; echo "$*" >> "$P/c/$last/updates"; exit 0 ;;
  logs) [ -d "$P/c/$last" ] || exit 125; echo "fake log of $last: listening"; exit 0 ;;
  rm) rm -rf "$P/c/$last"; exit 0 ;;
  port) [ -d "$P/c/$last" ] || exit 125; v=$(grep -A1 -x -- --publish "$P/c/$last/args" | tail -1); echo "${v##*:}/tcp -> ${v%:*}"; exit 0 ;;
  volume)
    case "$2" in
      ls) pre=${last#name=^}; pre=${pre%%-\[*}; ls "$P/v" | grep "^$pre-" ; exit 0 ;;
      inspect) [ -d "$P/v/$last" ] || { echo "Error: no such volume"; exit 125; }; echo "$P/v/$last"; exit 0 ;;
      rm) rm -rf "$P/v/$last"; exit 0 ;;
      create) mkdir -p "$P/v/$last"; echo "$last"; exit 0 ;;
      export) [ -d "$P/v/$last" ] || exit 125; tar -C "$P/v/$last" -cf "$4" . ; exit $? ;;
      import) [ -d "$P/v/$3" ] && [ -f "$4" ] || exit 125; tar -C "$P/v/$3" -xf "$4"; exit $? ;;
    esac ;;
  ps)
    out='['; sep=''
    for d in "$P"/c/*/; do [ -d "$d" ] || continue; n=$(basename "$d"); out="$out$sep{\"Names\":[\"$n\"],\"State\":\"$(cat "$d/state")\",\"Labels\":{\"sentora.cid\":\"${n#sdh-}\"}}"; sep=','; done
    echo "$out]"; exit 0 ;;
esac
echo "fake podman: unknown $*" >&2; exit 125
