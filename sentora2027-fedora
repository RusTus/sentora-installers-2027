chown "$PANEL_USER:$PANEL_USER" /var/lib/sentora/sentora-auth.log
# Logs fail2ban acts on must not be writable by the sites (a forged line could
# get any address blocked): root's own, the panel's own, or root-only folders
chown root:root "$PANEL_DATA/logs/proftpd"; chmod 755 "$PANEL_DATA/logs/proftpd"
# phpMyAdmin's failed logins (written by the panel user, not writable by the sites)
touch /var/lib/sentora/phpmyadmin-auth.log
chown "$PANEL_USER":"$PANEL_USER" /var/lib/sentora/phpmyadmin-auth.log
chmod 640 /var/lib/sentora/phpmyadmin-auth.log
# The panel's other logs there, made now: the folder itself is root's (below), so the panel can write
# these but can not make, rename or link anything at its top level, where root jobs write their state
# (a link planted there would have root write through it; the daemon keeps this so: sys_statedir)
for f in twofactor.log password-reveal.log shadowing.log panel-update.log; do
    touch "/var/lib/sentora/$f"; chown "$PANEL_USER":"$PANEL_USER" "/var/lib/sentora/$f"; chmod 640 "/var/lib/sentora/$f"
done
chown root:root /var/lib/sentora
chmod 755 /var/lib/sentora
cp $PANEL_CONF/fail2ban/filter.d/*.conf /etc/fail2ban/filter.d/
sed -e "s|!SERVER_IP!|$PUBLIC_IP|" -e "s|_SYSTEMD_UNIT=postfix@-.service|_SYSTEMD_UNIT=postfix.service|" $PANEL_CONF/fail2ban/sentora.conf > /etc/fail2ban/jail.d/sentora.conf
# bans with nftables (firewalld's own rules when firewalld is running)
if systemctl is-active --quiet firewalld 2> /dev/null; then
    printf '[DEFAULT]\nbanaction = firewallcmd-rich-rules\nbanaction_allports = firewallcmd-rich-rules\n' > /etc/fail2ban/jail.d/00-sentora-ban.conf
else
    printf '[DEFAULT]\nbanaction = nftables-multiport\nbanaction_allports = nftables-allports\n' > /etc/fail2ban/jail.d/00-sentora-ban.conf
fi
if [ -f /var/log/sogo/sogo.log ]; then
    # SOGo's failed logins (web, CalDAV/CardDAV and ActiveSync), with fail2ban's own filter
    printf '[sogo-auth]\nenabled = true\nbackend = auto\nport = http,https\nlogpath = /var/log/sogo/sogo.log\n' > /etc/fail2ban/jail.d/sentora-sogo.conf
fi
if fail2ban-client -t > /dev/null 2>&1; then
    systemctl enable fail2ban
    systemctl restart fail2ban
else
    echo -e "WARNING: the fail2ban configuration did not pass its test, fail2ban was not started."
    fail2ban-client -t 2>&1 | tail -5
fi

#--- Lock down files that hold passwords
# Everything under $PANEL_PATH was made world-writable earlier (chmod -R 777),
# which included the MySQL root password and the service database passwords.
# Hosting folders: each account folder is set up by the daemon (owner web<id>,
# access lists for the panel and Apache, nothing for anyone else); the parent
# only lets users pass through to their own
chown root:root "$PANEL_DATA/hostdata"
chmod 711 "$PANEL_DATA/hostdata"
# The rest of the shared data folders: root's, never writable by the sites (the
# daemon keeps them this way too, sys_accountphp::LockSharedFolders)
chown root:root "$PANEL_DATA" "$PANEL_DATA/logs"
chmod 755 "$PANEL_DATA" "$PANEL_DATA/logs"
chmod 1777 "$PANEL_DATA/temp"
[ -d "$PANEL_DATA/sessions" ] && { chown root:root "$PANEL_DATA/sessions"; chmod 1733 "$PANEL_DATA/sessions"; }
# backups (whole accounts, databases included): root only
chown root:root "$PANEL_DATA/backups"; chmod 700 "$PANEL_DATA/backups"
# (the same modes the daemon keeps, sys_accountphp::LockSharedFolders)
mkdir -p "$PANEL_DATA/logs/domains"
chown root:"$PANEL_USER" "$PANEL_DATA/logs/domains"
chmod 750 "$PANEL_DATA/logs/domains"

# The panel's code belongs to root and can not be changed by the panel or the sites
chown -R root:root $PANEL_PATH/panel
find $PANEL_PATH/panel -type d -exec chmod 755 {} +
find $PANEL_PATH/panel -type f -exec chmod 644 {} +
chmod 755 $PANEL_PATH/panel/bin/zppy $PANEL_PATH/panel/bin/setso $PANEL_PATH/panel/bin/setzadmin $PANEL_PATH/panel/bin/sentora-notice $PANEL_PATH/panel/bin/sentora-update-check $PANEL_PATH/panel/bin/sentora-post-install-check $PANEL_PATH/panel/bin/sentora-update $PANEL_PATH/panel/bin/sentora-restore $PANEL_PATH/panel/bin/sentora-smoke-test $PANEL_PATH/panel/bin/sentora-offsite-backup $PANEL_PATH/panel/bin/sentora-panel-restore $PANEL_PATH/panel/bin/sentora-web-probe $PANEL_PATH/panel/bin/sentora-ftp-kick $PANEL_PATH/panel/bin/sentora-php-install $PANEL_PATH/panel/bin/sentora-change-domain $PANEL_PATH/panel/bin/sentora-migrate-import $PANEL_PATH/panel/bin/sentora-migrate-export $PANEL_PATH/panel/bin/sentora-matomo-setup 2> /dev/null
chown root:"$PANEL_USER" $PANEL_PATH/panel/bin/zsudo; chmod 4750 $PANEL_PATH/panel/bin/zsudo
# What the panel itself writes: its template cache. Modules and Repo Browser's
# package cache belong to root: the panel queues module changes and the root
# daemon makes them, so a break-in to the panel can not plant code root would run
chown -R "$PANEL_USER:$HTTP_GROUP" $PANEL_PATH/panel/etc/tmp
# The panel's working folders: the panel and Apache (group) only, not the sites (the
# daemon keeps them so; set here too, so a check right after the install finds them closed)
for d in $PANEL_PATH/panel/etc/tmp $PANEL_PATH/panel/etc/apps/matomo/tmp $PANEL_PATH/panel/etc/apps/matomo/config; do
    [ -d "$d" ] && chmod o-rwx,g+s "$d"
done
# The database password and the encryption key: the panel and root only
chown root:"$PANEL_USER" $PANEL_PATH/panel/cnf/db.php $PANEL_PATH/panel/cnf/security.php
chmod 640 $PANEL_PATH/panel/cnf/db.php $PANEL_PATH/panel/cnf/security.php
# Service configuration: written by root (the daemon), read by the services
chown -R root:root $PANEL_CONF
# (earlier chmod -R 777 left every file world-writable: nobody but root may write now)
chmod -R u+rwX,go-w,go+rX $PANEL_CONF
chown root:mail $PANEL_CONF/dovecot2/dovecot-mysql.conf; chmod 640 $PANEL_CONF/dovecot2/dovecot-mysql.conf
chown root:"$PANEL_USER" $PANEL_CONF/roundcube/*.inc.php $PANEL_CONF/phpmyadmin/config.inc.php
chmod 640 $PANEL_CONF/roundcube/*.inc.php $PANEL_CONF/phpmyadmin/config.inc.php
chmod 600 $PANEL_CONF/ssl/sentora.key
chown root:root $PANEL_CONF/proftpd/proftpd-mysql.conf
chmod 600 $PANEL_CONF/proftpd/proftpd-mysql.conf
chown root:postfix $PANEL_CONF/postfix/mysql-*.cf
chmod 640 $PANEL_CONF/postfix/mysql-*.cf
chmod 644 $PANEL_CONF/postfix/main.cf $PANEL_CONF/postfix/master.cf
chown root:root $PANEL_CONF/bind/rndc.conf 2> /dev/null; chmod 600 $PANEL_CONF/bind/rndc.conf 2> /dev/null
chmod 640 $BIND_FILES/rndc.conf 2> /dev/null
# BIND's main file holds the rndc key (whoever has it can stop or reconfigure BIND): root and BIND only
chown root:"$BIND_USER" $BIND_FILES/named.conf; chmod 640 $BIND_FILES/named.conf
# The File Manager's own program files must not be writable by the web server
# (it edits users' files, never itself)
chown -R root:root $PANEL_PATH/panel/modules/file_manager
chmod -R u=rwX,go=rX $PANEL_PATH/panel/modules/file_manager
# Same for Apache Status: its settings are fixed files, nothing in it should be writable
chown -R root:root $PANEL_PATH/panel/modules/apache_status
chmod -R u=rwX,go=rX $PANEL_PATH/panel/modules/apache_status
# Nothing else may stay writable by everyone (the chmod -R 777 earlier in this installer
# also opened /etc/sentora itself and its docs folder: a site could rename and replace
# the configuration). Left alone: hosting folders and mail (their own rules), and the two
# shared scratch folders. The daemon repeats this every run (sys_accountphp::LockWorldWritable).
chown root:root $PANEL_PATH; chmod 755 $PANEL_PATH
find $PANEL_PATH $PANEL_DATA -xdev \( -path "$PANEL_DATA/hostdata" -o -path "$PANEL_DATA/vmail" -o -path "$PANEL_DATA/temp" -o -path "$PANEL_DATA/sessions" \) -prune \
    -o -perm -o+w ! -type l -print0 2> /dev/null | xargs -0 -r chmod o-w
[ -f "$PANEL_DATA/logs/sentora.log" ] && { chown root:"$PANEL_USER" "$PANEL_DATA/logs/sentora.log"; chmod 660 "$PANEL_DATA/logs/sentora.log"; }

# Set admin contact info to zadmin profile

echo -e "\n--- Updating Admin contact Info..."
# (quoted: a name like O'Brien would otherwise end the SQL text and nothing would be saved)
sqlroot -e "UPDATE sentora_core.x_accounts SET ac_email_vc='$(sql_str "$ADMIN_EMAIL")' WHERE ac_id_pk = 1"
sqlroot -e "UPDATE sentora_core.x_profiles SET ud_fullname_vc='$(sql_str "$ADMIN_NAME")', ud_phone_vc='$(sql_str "$ADMIN_PHONE")', ud_address_tx=CONCAT('$(sql_str "$ADMIN_ADDRESS")', '\r\n', '$(sql_str "$ADMIN_PROVINCE $ADMIN_POSTALCODE")', '\r\n', '$(sql_str "$ADMIN_COUNTRY")'), ud_postcode_vc='$(sql_str "$ADMIN_POSTALCODE")' WHERE ud_id_pk = 1" \
    || echo "WARNING: the administrator's contact details were not saved in zadmin's profile (fill them in under My Account)."

echo -e "\n--- Done Updating admin contact info.\n"

echo -e "# -------------------------------------------------------------------------------"

#--- SELinux (enforcing): Sentora's folders get the labels of what uses them, and the services the
# switches they need; nothing is switched off. A denial is logged in /var/log/audit/audit.log
# (ausearch -m avc -ts recent) and sentora-post-install-check counts them.
if [ "$SELINUX_ON" = 1 ] && command -v semanage > /dev/null 2>&1; then
    ui_step "SELinux: labels and switches for Sentora"
    fc() { semanage fcontext -a -t "$1" "$2" 2> /dev/null || semanage fcontext -m -t "$1" "$2"; }
    # the panel's code (read by Apache and PHP-FPM) and the folders the panel writes
    fc httpd_sys_content_t "$PANEL_PATH/panel(/.*)?"
    fc httpd_sys_rw_content_t "$PANEL_PATH/panel/etc/tmp(/.*)?"
    fc httpd_sys_rw_content_t "$PANEL_PATH/panel/etc/apps/matomo/(tmp|config)(/.*)?"
    fc httpd_sys_rw_content_t "/var/lib/sentora(/.*)?"
    fc httpd_sys_content_t "$PANEL_CONF/apache(/.*)?"
    fc httpd_config_t "$PANEL_CONF/apache/.*\.conf"
    fc cert_t "$PANEL_CONF/ssl(/.*)?"
    # the hosted websites (their PHP writes to them) and the shared scratch folders
    fc httpd_sys_rw_content_t "$PANEL_DATA/hostdata(/.*)?"
    fc httpd_sys_rw_content_t "$PANEL_DATA/(temp|sessions|stats)(/.*)?"
    fc httpd_log_t "$PANEL_DATA/logs(/.*)?"
    fc httpd_sys_rw_content_t "$PANEL_DATA/backups(/.*)?"
    # mail
    fc mail_home_rw_t "$PANEL_DATA/vmail(/.*)?"
    fc dovecot_etc_t "$PANEL_CONF/dovecot2(/.*)?"
    fc postfix_etc_t "$PANEL_CONF/postfix(/.*)?"
    fc mail_home_rw_t "$PANEL_DATA/sieve(/.*)?"
    # DNS and FTP
    fc named_conf_t "$PANEL_CONF/bind(/.*)?"
    fc named_zone_t "$PANEL_CONF/bind/zones(/.*)?"
    fc named_log_t "$PANEL_DATA/logs/bind(/.*)?"
    fc etc_t "$PANEL_CONF/proftpd(/.*)?"
    fc xferlog_t "$PANEL_DATA/logs/proftpd(/.*)?"
    # fail2ban reads the panel's two login logs (it may enter the folder, not the panel's other files)
    fc httpd_sys_content_t "/var/lib/sentora"
    fc httpd_log_t "/var/lib/sentora/(sentora|phpmyadmin)-auth\.log"
    # Dovecot's other logs (Fedora labels only dovecot.log for it)
    fc dovecot_var_log_t "/var/log/dovecot-(info|debug)\.log"
    restorecon -RF "$PANEL_PATH" "$PANEL_DATA" /var/lib/sentora > /dev/null 2>&1
    # files made by this installer before here, which got the label of their folder, not their own
    restorecon -RF /var/log/dovecot.log /var/log/dovecot-info.log /var/log/dovecot-debug.log /var/log/clamav \
        /run/clamav-milter /run/spamass-milter > /dev/null 2>&1
    # Apache and PHP-FPM may reach the database, send mail, and fetch (Matomo, updates, Let's
    # Encrypt); FTP users reach their own folders; BIND writes its own zones
    for b in httpd_can_network_connect_db httpd_can_network_connect httpd_can_sendmail httpd_setrlimit \
        httpd_unified ftpd_full_access named_write_master_zones antivirus_can_scan_system spamd_update_can_network \
        domain_can_mmap_files; do
        setsebool -P "$b" on > /dev/null 2>&1 && echo "SELinux: $b on" || echo "SELinux: $b not set (not known here)"
    done
    echo "SELinux: labels set for $PANEL_PATH, $PANEL_DATA and /var/lib/sentora"
    # Sentora's own rules, for what labels can not fix (each one explained in the file)
    if [ -f "$PANEL_CONF/selinux/sentora.cil" ]; then
        semodule -i "$PANEL_CONF/selinux/sentora.cil" && echo "SELinux: Sentora's rules loaded (semodule -l: sentora)" \
            || echo "WARNING: SELinux: Sentora's rules ($PANEL_CONF/selinux/sentora.cil) could not be loaded."
    fi
    # what started before its files had their labels starts again now
    for u in dovecot fail2ban clamav-freshclam named; do
        systemctl is-enabled --quiet "$u" 2> /dev/null && systemctl restart "$u" > /dev/null 2>&1
    done
fi

#--- Fedora's name resolver answers local-network name lookups (LLMNR, port 5355) on every interface:
# a server has no use for that, so it is switched off (normal DNS lookups are unchanged)
if [ -d /etc/systemd ] && systemctl list-unit-files systemd-resolved.service > /dev/null 2>&1; then
    mkdir -p /etc/systemd/resolved.conf.d
    printf '# Sentora: no local-network name lookups on a server\n[Resolve]\nLLMNR=no\nMulticastDNS=no\n' > /etc/systemd/resolved.conf.d/90-sentora.conf
    systemctl try-restart systemd-resolved > /dev/null 2>&1
fi

#--- Cockpit (the system's own web console, port 9090: switched on by default on RHEL and Fedora Server)
# is a full administrator's page open to the network beside the panel: it is switched off, and its
# port closed. The administrator can switch it on again (see the message), e.g. reachable only over SSH.
if systemctl list-unit-files cockpit.socket > /dev/null 2>&1 && systemctl is-enabled --quiet cockpit.socket 2> /dev/null; then
    systemctl disable --now cockpit.socket > /dev/null 2>&1
    firewall-cmd --permanent --remove-service=cockpit > /dev/null 2>&1
    echo "Cockpit (web console, port 9090) switched off: Sentora's panel is the web page here."
    echo "  To use it again: systemctl enable --now cockpit.socket (and reach it through an SSH tunnel)."
fi

#--- The firewall (firewalld, when it runs): the ports Sentora serves
if systemctl is-active --quiet firewalld 2> /dev/null; then
    ui_step "Opening the firewall for Sentora's services"
    for svc in http https smtp smtps smtp-submission imap imaps pop3 pop3s ftp dns managesieve; do
        firewall-cmd --permanent --add-service="$svc" > /dev/null 2>&1 || echo "firewalld: no service $svc"
    done
    # FTP's passive data ports (proftpd: PassivePorts)
    firewall-cmd --permanent --add-port=60000-65535/tcp > /dev/null 2>&1
    firewall-cmd --reload > /dev/null 2>&1
    echo "firewalld: $(firewall-cmd --list-services 2> /dev/null)"
fi

echo -e "\n--- Restarting Services"
echo -e "Restarting $DB_SERVICE..."
systemctl restart "$DB_SERVICE"
echo -e "Restarting $HTTP_SERVICE..."
systemctl restart "$HTTP_SERVICE"
echo -e "Restarting Postfix..."
systemctl restart postfix
echo -e "Restarting Dovecot..."
systemctl restart dovecot
echo -e "Restarting BIND..."
systemctl restart "$BIND_SERVICE"
echo -e "Restarting Proftpd..."
systemctl restart proftpd
echo -e "Restarting CRON..."
systemctl restart "$CRON_SERVICE"
echo -e "Restarting ATD..."
systemctl restart atd

echo -e "\n--- Finished Restarting Services...\n"

##
#--- Matomo web analytics (etc/apps/matomo, in the panel's own PHP pool)
##
# Set up with Matomo's own installer pages (driven here, the same steps as in a
# browser); the Sentora daemon then creates a Matomo site per domain and a
# view-only Matomo user per account, and imports the access logs every hour.
MATOMO="$PANEL_PATH/panel/etc/apps/matomo"
matomopassword=""
matomoadminpassword=""
if [ -f "$MATOMO/index.php" ]; then
    ui_step "Setting up Matomo"
    install_available python3
    matomopassword=$(passwordgen)
    matomoadminpassword=$(passwordgen)
    sqlroot -e "CREATE DATABASE IF NOT EXISTS sentora_matomo CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci"
    for MH in localhost 127.0.0.1; do
        sqlroot -e "CREATE USER IF NOT EXISTS 'matomo'@'$MH' IDENTIFIED BY '$matomopassword'; GRANT ALL PRIVILEGES ON sentora_matomo.* TO 'matomo'@'$MH'"
    done
    chown -R "$PANEL_USER:$HTTP_GROUP" "$MATOMO/tmp" "$MATOMO/config"
    hosts_has "$PANEL_FQDN" || echo "127.0.0.1 $PANEL_FQDN" >> /etc/hosts
    mkdir -p /var/lib/sentora/matomo; chown root:"$PANEL_USER" /var/lib/sentora/matomo; chmod 750 /var/lib/sentora/matomo
    MI="https://127.0.0.1/etc/apps/matomo/index.php"
    MC=$(mktemp)
    # (each page's answer goes to the log: a setup that does not finish shows where it stopped)
    mstep() { echo "Matomo setup page: $(curl -sk -o /dev/null -w "%{http_code}" -c "$MC" -b "$MC" -H "Host: $PANEL_FQDN" --max-time 300 "$@") ${*: -1}" | sed 's|https://127.0.0.1/etc/apps/matomo/index.php||'; }
    mstep "$MI"
    mstep "$MI?action=systemCheck"
    mstep --data-urlencode "password=$matomopassword" -d "host=127.0.0.1&username=matomo&dbname=sentora_matomo&tables_prefix=matomo_&adapter=PDO\MYSQL&schema=Mysql&submit=Next" "$MI?action=databaseSetup"
    mstep "$MI?action=tablesCreation&module=Installation"
    mstep --data-urlencode "password=$matomoadminpassword" --data-urlencode "password_bis=$matomoadminpassword" -d "login=sentora_admin&email=postmaster@$PANEL_FQDN&subscribe_newsletter_piwikorg=0&subscribe_newsletter_professionalservices=0&submit=Next" "$MI?action=setupSuperUser&module=Installation"
    mstep -d "siteName=$PANEL_FQDN&url=https://$PANEL_FQDN&timezone=${tz:-UTC}&ecommerce=0&submit=Next" "$MI?action=firstWebsiteSetup&module=Installation"
    mstep "$MI?action=trackingCode&module=Installation&site_idSite=1&site_name=$PANEL_FQDN"
    mstep -d "do_not_track=1&anonymise_ip=1&submit=Continue" "$MI?action=finished&module=Installation&site_idSite=1&site_name=$PANEL_FQDN"
    rm -f "$MC"
    if [ -f "$MATOMO/config/config.ini.php" ]; then
        mconsole() { (cd "$MATOMO" && setpriv --reuid="$PANEL_USER" --regid="$PANEL_USER" --init-groups --reset-env /usr/bin/php"$PHPVER" console "$@" > /dev/null 2>&1); }
        mconsole plugin:activate SentoraSync
        # The panel opens Matomo in a frame; reports are built by the hourly job, not by visitors
        mconsole config:set --section=General --key=enable_framed_pages --value=1
        mconsole config:set --section=General --key=enable_browser_archiving_triggering --value=0
        mconsole config:set --section=General --key=enable_load_data_infile --value=0
        # No calls home: no marketplace, news feed, update checks, adverts or "what's new" tours
        mconsole config:set --section=General --key=enable_internet_features --value=0
        mconsole plugin:deactivate ProfessionalServices Marketplace Tour Feedback
        chown root:"$PANEL_USER" "$MATOMO/config/config.ini.php"
        chmod 660 "$MATOMO/config/config.ini.php"
        echo "Matomo is set up (super user sentora_admin)."
    else
        # A second try with the panel's own tool, from an empty Matomo database (it writes its own
        # passwords to /root/passwords.txt and logs each page's answer)
        echo "Matomo's setup did not finish: trying again with sentora-matomo-setup --reset"
        sleep 5
        if bash "$PANEL_PATH/panel/bin/sentora-matomo-setup" --reset && [ -f "$MATOMO/config/config.ini.php" ]; then
            matomopassword="(in /root/passwords.txt)"; matomoadminpassword="(in /root/passwords.txt)"
        else
            echo -e "WARNING: Matomo setup did not finish (the pages' answers are above); after the restart run: sentora-matomo-setup --reset"
        fi
    fi
fi

#--- Store the passwords for user reference
{
    echo "Server IP address : $PUBLIC_IP"
    echo "Panel URL         : https://$PANEL_FQDN"
    echo "zadmin Password   : $zadminpassword"
    echo ""
    echo "MySQL Root Password      : $mysqlpassword"
    echo "MySQL Postfix Password   : $postfixpassword"
    echo "MySQL Roundcube Password : $roundcubepassword"
    echo "MySQL SOGo Password      : $sogopassword"
    echo "MySQL Matomo Password    : $matomopassword"
    echo "Matomo super user        : sentora_admin / $matomoadminpassword"
    echo "MySQL ProFTPd Password   : $proftpdpassword"
} >> /root/passwords.txt
chmod 600 /root/passwords.txt

#--- Advise the admin that Sentora is now installed and accessible.
ui_done
rm -f /etc/sentora/.installing
UI_INSTALLING=""
# back to the screen for the summary and the last question
exec 1>&3 2>&4
UI_WARN_COUNT=$( [ -f "$logfile.warnings" ] && wc -l < "$logfile.warnings" || echo 0 )
UI_WARN_LIST=$( [ -f "$logfile.warnings" ] && cat "$logfile.warnings" )
rm -f "$logfile.warnings"
sleep 1
ui_banner "Installed on $(hostname) in $(( ($(date +%s) - UI_INSTALL_START) / 60 )) minutes"
ui_bar "$BG_OK" "  Sentora is installed"
echo
printf '  %-26s %shttps://%s%s\n' "Panel" "$C_BOLD" "$PANEL_FQDN" "$C_RESET"
printf '  %-26s %s%s%s\n' "Username" "$C_BOLD" "zadmin" "$C_RESET"
printf '  %-26s %s%s%s\n' "Password" "$C_BOLD$C_YELLOW" "$zadminpassword" "$C_RESET"
echo
printf '  %s%s%s\n' "$C_BOLD" "The other passwords this installation made:" "$C_RESET"
printf '  %-26s %s\n' "MySQL root" "$mysqlpassword"
printf '  %-26s %s\n' "MySQL Postfix" "$postfixpassword"
printf '  %-26s %s\n' "MySQL ProFTPD" "$proftpdpassword"
printf '  %-26s %s\n' "MySQL Roundcube" "$roundcubepassword"
[ -n "${sogopassword:-}" ] && printf '  %-26s %s\n' "MySQL SOGo" "$sogopassword"
[ -n "${matomopassword:-}" ] && printf '  %-26s %s\n' "MySQL Matomo" "$matomopassword"
[ -n "${matomoadminpassword:-}" ] && printf '  %-26s sentora_admin / %s\n' "Matomo super user" "$matomoadminpassword"
echo
printf '  %s%s%s\n' "$C_BOLD$C_YELLOW" "All of these are saved in /root/passwords.txt (readable by root only)" "$C_RESET"
printf '  %s%s%s\n' "$C_DIM" "(phpMyAdmin's and Roundcube's encryption keys stay in their settings files," "$C_RESET"
printf '  %s%s%s\n' "$C_DIM" " and SpamAV makes its database password itself)" "$C_RESET"
echo
if [ "${UI_WARN_COUNT:-0}" -gt 0 ]; then
    ui_warn "$UI_WARN_COUNT warning(s) during the installation (details in the log):"
    while IFS= read -r w; do
        printf '      %s%s%s\n' "$C_YELLOW" "${w:0:$(( $(ui_cols) - 8 ))}" "$C_RESET"
    done <<< "$UI_WARN_LIST"
else
