# Public IP as seen from the internet. api.sentora.org/ip.txt (used before) no
# longer answers, which left the IP empty and broke BIND's config. Try several
# services and fall back to the local address when none answer.
detect_public_ip() {
    local svc ip
    for svc in https://api.ipify.org https://ipv4.icanhazip.com https://checkip.amazonaws.com https://ifconfig.me/ip; do
        ip=$(wget -4 -qO- --timeout=5 --tries=1 "$svc" 2> /dev/null | tr -d '[:space:]')
        if is_ipv4 "$ip"; then
            echo "$ip"
            return
        fi
    done
}

# First IPv4 address on a real interface (the old command printed one per interface)
local_ip=$(ip -4 addr show scope global 2> /dev/null | awk '$1 == "inet" { sub(/\/.*/, "", $2); print $2; exit }')
if [[ -z "$local_ip" ]]; then
    for local_ip in $(hostname -I 2> /dev/null) ""; do
        [[ "$local_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && break
    done
fi
extern_ip="$(detect_public_ip)"
[[ -z "$extern_ip" ]] && extern_ip="$local_ip"
if [[ "$PUBLIC_IP" == "local" || "$PUBLIC_IP" == "public" ]]; then
    PUBLIC_IP_ASKED="$PUBLIC_IP"
    if [[ "$PUBLIC_IP" == "local" ]]; then PUBLIC_IP=$local_ip; else PUBLIC_IP=$extern_ip; fi
    if [[ -z "$PUBLIC_IP" ]]; then
        echo "-i $PUBLIC_IP_ASKED: this server's IPv4 address could not be found. Give it with -i <address>."
        exit 2
    fi
fi


#--- Download and unpack Sentora before asking anything
# GitHub's release API: the release's tag (for "latest") and each file's SHA-256, so
# a download is checked against what was uploaded. Without it (no network to
# api.github.com, or its hourly limit reached) a pinned tag still downloads, unchecked.
REL_DIR=$(mktemp -d /tmp/sentora-release.XXXXXX)
release_info() {   # $1 repository: its release's details, saved once
    local repo="$1" f api
    f="$REL_DIR/${repo//\//_}.json"
    if [ ! -e "$f" ]; then
        if [ "$SENTORA_RELEASE_TAG" = "latest" ]; then
            api="https://api.github.com/repos/$repo/releases?per_page=1"
        else
            api="https://api.github.com/repos/$repo/releases/tags/$SENTORA_RELEASE_TAG"
        fi
        # one key per line, whatever the layout of the answer
        wget -q -T 20 -O - --header="Accept: application/vnd.github+json" "$api" 2> /dev/null \
            | sed 's/\([,{[]\) *"/\1\n"/g' > "$f" || true
    fi
    cat "$f"
}
release_tag() {    # $1 repository: the tag to download from
    local tag
    if [ "$SENTORA_RELEASE_TAG" != "latest" ]; then
        echo "$SENTORA_RELEASE_TAG"
        return
    fi
    tag=$(release_info "$1" | sed -n 's/^ *"tag_name": *"\([^"]*\)".*/\1/p' | head -1)
    if [ -z "$tag" ]; then   # no API: the release feed lists pre-releases too, newest first
        tag=$(wget -q -T 20 -O - "$SENTORA_GITHUB/$1/releases.atom" 2> /dev/null \
            | grep -o 'releases/tag/[^"<]*' | head -1 | sed 's|releases/tag/||')
    fi
    echo "${tag:-latest}"
}
release_digest() { # $1 repository, $2 file: its SHA-256 as GitHub lists it
    release_info "$1" | awk -v want="$2" '
        /^ *"name": *"/ { n = $0; sub(/^ *"name": *"/, "", n); sub(/".*/, "", n) }
        /^ *"digest": *"sha256:/ && n == want { d = $0; sub(/^ *"digest": *"sha256:/, "", d); sub(/".*/, "", d); print d; exit }'
}
release_url() {    # $1 file, $2 repository
    local tag
    if [ -n "$SENTORA_DOWNLOAD_URL" ]; then
        echo "$SENTORA_DOWNLOAD_URL/$1"
        return
    fi
    tag=$(release_tag "$2")
    if [ "$tag" = "latest" ]; then   # no API: GitHub's newest full release
        echo "$SENTORA_GITHUB/$2/releases/latest/download/$1"
    else
        echo "$SENTORA_GITHUB/$2/releases/download/$tag/$1"
    fi
}

# Download $1 (a file of the GitHub repository $3) to $2, retrying a few times;
# checked against GitHub's SHA-256 when the API answered.
download_file() {
    local url dest="$2" repo="$3" try want="" rc
    url=$(release_url "$1" "$repo")
    [ -z "$SENTORA_DOWNLOAD_URL" ] && want=$(release_digest "$repo" "$1")
    for try in 1 2 3; do
        echo "Downloading $url (attempt $try)"
        # (GitHub sends the file from a signed address: its long query is left out of the log)
        wget -nv -O "$dest" "$url" > "$REL_DIR/wget.log" 2>&1
        rc=$?
        sed 's/?[^ ]*//' "$REL_DIR/wget.log"
        if [ "$rc" -eq 0 ] && [ -s "$dest" ] \
           && { unzip -tq "$dest" > /dev/null 2>&1 || tar -tzf "$dest" > /dev/null 2>&1; }; then
            if [ -z "$want" ]; then
                [ -z "$SENTORA_DOWNLOAD_URL" ] && echo "(not checked: GitHub's release API did not answer)"
                return 0
            fi
            if [ "$(sha256sum "$dest" | cut -d' ' -f1)" = "$want" ]; then
                echo "SHA-256 matches the release"
                return 0
            fi
            echo "$1 does not match the SHA-256 GitHub lists for it."
        else
            echo "Download of $url failed or the file is not a valid zip or tar.gz."
        fi
        rm -f "$dest"
        sleep 5
    done
    return 1
}

# Unpack a downloaded zip into $dest and set STAGED_DIR to the folder that contains $marker.
stage_zip() {
    local zip="$1" marker="$2" dest="$3" top=""
    STAGED_DIR=""
    mkdir -p "$dest"
    if ! unzip -oq "$zip" -d "$dest"; then
        echo "Install failed: could not unzip $zip"
        return 1
    fi
    top=$(find "$dest" -mindepth 1 -maxdepth 2 -type d -name "$marker" -printf '%h\n' 2> /dev/null | head -1)
    if [[ -z "$top" ]]; then
        echo "Install failed: $zip does not contain $marker/."
        return 1
    fi
    STAGED_DIR=$(cd "$top" && pwd)
}

SRC_STAGE=$(mktemp -d /tmp/sentora-src.XXXXXX)

if ! download_file "$SENTORA_CORE_ZIP" "$SRC_STAGE/$SENTORA_CORE_ZIP" "$SENTORA_CORE_REPO" \
   || ! stage_zip "$SRC_STAGE/$SENTORA_CORE_ZIP" "dryden" "$SRC_STAGE/core" \
   || [ ! -f "$STAGED_DIR/index.php" ]; then
    echo "Install failed: could not get the Sentora core:"
    echo "  $(release_url "$SENTORA_CORE_ZIP" "$SENTORA_CORE_REPO")"
    echo "Check that this server can reach it and that the release holds that file."
    rm -rf "$SRC_STAGE"
    exit 3
fi
CORE_DIR="$STAGED_DIR"
# what sentora-update compares with later (the zip's SHA-256 and the release)
CORE_SUM=$(sha256sum "$SRC_STAGE/$SENTORA_CORE_ZIP" | cut -d' ' -f1)
CORE_TAG=""
[ -z "$SENTORA_DOWNLOAD_URL" ] && CORE_TAG=$(release_tag "$SENTORA_CORE_REPO")
[ "$CORE_TAG" = "latest" ] && CORE_TAG=""

if ! download_file "$SENTORA_INSTALLERS_ZIP" "$SRC_STAGE/$SENTORA_INSTALLERS_ZIP" "$SENTORA_INSTALLERS_REPO" \
   || ! stage_zip "$SRC_STAGE/$SENTORA_INSTALLERS_ZIP" "preconf" "$SRC_STAGE/preconf"; then
    echo "Install failed: could not get the Sentora configuration files:"
    echo "  $(release_url "$SENTORA_INSTALLERS_ZIP" "$SENTORA_INSTALLERS_REPO")"
    echo "Check that this server can reach it and that the release holds that file."
    rm -rf "$SRC_STAGE"
    exit 3
fi
PRECONF_DIR="$STAGED_DIR"

if [ -n "$tz" ]; then
    timedatectl set-timezone "$tz" > /dev/null 2>&1 || { ln -sf "/usr/share/zoneinfo/$tz" /etc/localtime && echo "$tz" > /etc/timezone; }
fi
if [[ "$tz" == "" && "$PANEL_FQDN" == "" ]] ; then
    # The time zone could not be found out: chosen here from numbered lists (the region,
    # then the city), in the installer's own screen
    $PACKAGE_INSTALLER tzdata > /dev/null 2>&1
    # numbered items in columns that fit the screen: tz_columns item...
    tz_columns() {
        local cols w n i rows r c idx line name maxw
        cols=$(ui_cols); n=$#
        maxw=0; for i in "$@"; do [ ${#i} -gt $maxw ] && maxw=${#i}; done
        # at least 3 columns on an 80-column screen (more when wider); longer names are
        # shortened with ~ (the number still picks the whole name)
        c=$(( (cols - 2) / 26 )); [ $c -lt 1 ] && c=1
        w=$(( maxw + 7 )); [ $w -gt $(( (cols - 2) / c )) ] && w=$(( (cols - 2) / c ))
        c=$(( (cols - 2) / w )); [ $c -lt 1 ] && c=1
        rows=$(( (n + c - 1) / c ))
        local items=("$@")
        for (( r = 0; r < rows; r++ )); do
            line="  "
            for (( i = 0; i < c; i++ )); do
                idx=$(( i * rows + r ))
                [ $idx -lt $n ] || continue
                name="${items[$idx]}"
                [ ${#name} -gt $(( w - 7 )) ] && name="${name:0:$(( w - 8 ))}~"
                line+=$(printf "%s%4d)%s %-*s" "$C_CYAN" $(( idx + 1 )) "$C_RESET" $(( w - 6 )) "$name")
            done
            echo "$line"
        done
    }
    tz_answer=""; tz_pick=""
    while [ -z "$tz_answer" ]; do
        # 1. the region
        mapfile -t TZ_REGIONS <<< "$(cd /usr/share/zoneinfo && for d in Africa America Antarctica Arctic Asia Atlantic Australia Europe Indian Pacific; do [ -d "$d" ] && echo "$d"; done)"
        TZ_REGIONS+=("UTC")
        ui_banner "Server: $(hostname)  -  $OS $VER $ARCH"
        ui_heading "The server's time zone: the region"
        echo "  Used for the panel's times, the logs and scheduled tasks."
        echo
        tz_columns "${TZ_REGIONS[@]}"
        ui_ask "The number of the region:" "" tz_pick
        if [[ "$tz_pick" =~ ^[0-9]+$ ]] && [ "$tz_pick" -ge 1 ] && [ "$tz_pick" -le ${#TZ_REGIONS[@]} ]; then
            region="${TZ_REGIONS[$(( tz_pick - 1 ))]}"
        else
            continue
        fi
        [ "$region" = UTC ] && { tz_answer=UTC; break; }
        # 2. the city in that region (part of a name narrows the list)
        mapfile -t TZ_ALL <<< "$(cd "/usr/share/zoneinfo/$region" && find . -type f -o -type l | sed 's|^\./||' | grep -E '^[A-Za-z0-9_/+-]+$' | sort)"
        filter=""
        while true; do
            if [ -n "$filter" ]; then
                mapfile -t TZ_CITIES <<< "$(printf '%s\n' "${TZ_ALL[@]}" | grep -i -- "$filter")"
            else
                TZ_CITIES=("${TZ_ALL[@]}")
            fi
            [ -n "${TZ_CITIES[0]:-}" ] || TZ_CITIES=()
            ui_banner "Server: $(hostname)  -  $OS $VER $ARCH"
            ui_heading "The server's time zone: $region${filter:+ (matching \"$filter\")}"
            [ -z "$filter" ] && [ ${#TZ_CITIES[@]} -gt 30 ] && printf '  %sA long list: type part of the city'"'"'s name below to shorten it.%s\n\n' "$C_DIM" "$C_RESET"
            if [ ${#TZ_CITIES[@]} -gt 0 ]; then
                tz_columns "${TZ_CITIES[@]}"
            else
                ui_warn "Nothing in $region matches \"$filter\"."
            fi
            printf '\n  %sThe number of the city, part of a name to narrow the list, or 0 to go back.%s\n' "$C_DIM" "$C_RESET"
            ui_ask "City:" "" tz_pick
            if [ "$tz_pick" = 0 ]; then
                break
            elif [[ "$tz_pick" =~ ^[0-9]+$ ]] && [ "$tz_pick" -ge 1 ] && [ "$tz_pick" -le ${#TZ_CITIES[@]} ]; then
                tz_answer="$region/${TZ_CITIES[$(( tz_pick - 1 ))]}"
                break
            elif [[ "$tz_pick" =~ ^[A-Za-z_\ /+-]+$ ]]; then
                filter="${tz_pick// /_}"
            else
                filter=""
            fi
        done
    done
    if command -v timedatectl > /dev/null 2>&1; then
        timedatectl set-timezone "$tz_answer" > /dev/null 2>&1
    else
        ln -sf "/usr/share/zoneinfo/$tz_answer" /etc/localtime && echo "$tz_answer" > /etc/timezone
    fi
    tz=$(get_timezone)
    [ -n "$tz" ] || tz="$tz_answer"
    ui_ok "Time zone set to $tz ($(date '+%H:%M %Z'))"
    sleep 1
fi
# A time zone given with -t, or none: the system's own
[ -n "$tz" ] || tz=$(get_timezone)
[ -n "$tz" ] || tz=UTC

# A host name: letters, digits, dots and hyphens (it goes into every service's settings)
is_hostname() { [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ && "$1" != *..* && "$1" != *.-* && "$1" != *-.* ]]; }
is_email() { [[ "$1" =~ ^[^@[:space:]\'\"]+@[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?\.[A-Za-z]{2,63}$ ]]; }

# The panel's address and IP, checked against DNS; warnings are confirmed or changed
ask_server() {
    local confirm dns_panel_ip
    while true; do
        ui_banner "Server: $(hostname)  -  $OS $VER $ARCH"
        ui_heading "The panel's address"
        echo "  The panel gets a name of its own, for example panel.example.com: a sub-domain"
        echo "  (not your main domain) or this server's host name. Its DNS A record should"
        echo "  already point to this server's public IP address: the panel's address and its"
        echo "  Let's Encrypt certificate need it."
        ui_ask "The panel's sub-domain (for example panel.example.com):" "$PANEL_FQDN" PANEL_FQDN
        PANEL_FQDN=$(printf '%s' "$PANEL_FQDN" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
        if ! is_hostname "$PANEL_FQDN"; then
            ui_err "'$PANEL_FQDN' is not a valid name: letters, digits, dots and hyphens only."
            PANEL_FQDN="sentora${host_domain:+.$host_domain}"
            sleep 2; continue
        fi
        echo
        if [[ "$extern_ip" != "$local_ip" ]]; then
            printf '  %sThis server: public IP %s, local IP %s. A server on the internet uses the public one.%s\n' "$C_DIM" "${extern_ip:-unknown}" "${local_ip:-unknown}" "$C_RESET"
        fi
        ui_ask "This server's public IP address:" "$PUBLIC_IP" PUBLIC_IP
        PUBLIC_IP=$(printf '%s' "$PUBLIC_IP" | tr -d '[:space:]')
        if ! is_ipv4 "$PUBLIC_IP"; then
            ui_err "'$PUBLIC_IP' is not a valid IPv4 address."
            PUBLIC_IP=${extern_ip:-$local_ip}
            sleep 2; continue
        fi
        echo

        # Checks (dig asks DNS itself, it skips /etc/hosts where the installer's own entries go)
        confirm=""
        if [[ "$PANEL_FQDN" != *.*.* ]]; then
            ui_warn "$PANEL_FQDN is not a sub-domain (like panel.example.com)."
            confirm=1
        fi
        if command -v dig > /dev/null 2>&1; then
            dns_panel_ip=$(dig +short A "$PANEL_FQDN" 2> /dev/null | grep -E '^[0-9.]+$' | tail -1)
        else
            dns_panel_ip=$(getent ahostsv4 "$PANEL_FQDN" | awk 'NR == 1 {print $1}')
        fi
        if [[ -z "$dns_panel_ip" ]]; then
            ui_warn "$PANEL_FQDN is not in DNS yet."
            echo "         Add an A record for it pointing to $PUBLIC_IP (and wait for it to spread)."
            echo "         The panel can be installed now; set the DNS up as soon as you can."
            confirm=1
        elif [[ "$dns_panel_ip" != "$PUBLIC_IP" ]]; then
            ui_warn "$PANEL_FQDN points to $dns_panel_ip in DNS, not to $PUBLIC_IP."
            echo "         The panel will not be reachable at https://$PANEL_FQDN until it does."
            confirm=1
        else
            ui_ok "DNS: $PANEL_FQDN points to $PUBLIC_IP"
        fi
        if [[ "$PUBLIC_IP" != "$extern_ip" && "$PUBLIC_IP" != "$local_ip" ]]; then
            ui_warn "$PUBLIC_IP is not one of this server's addresses (${extern_ip:-?} or ${local_ip:-?})."
            confirm=1
        fi
        [ -z "$confirm" ] && { sleep 1; return; }
        printf '\n  %s%s%s\n' "$C_BOLD$C_YELLOW" "There are warnings above. Use these settings anyway?" "$C_RESET"
        read -r -e -p "  (y) yes, (n) change them, (q) quit > " yn || ui_no_input "Use these settings anyway?"
        case $yn in
            [Yy]*) return ;;
            [Qq]*) echo; exit 0 ;;
        esac
    done
}

# A question that needs an answer: ask_required "Question" VAR [check message]
ask_required() {
    while true; do
        ui_ask "$1" "${!2}" "$2"
        printf -v "$2" '%s' "$(printf '%s' "${!2}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
        if [ -z "${!2}" ]; then
            [ -t 0 ] || ui_no_input "$1"
            ui_warn "This one is needed."
        elif [ -n "${3:-}" ] && ! "$3" "${!2}"; then
