#--- Set some Sentora database entries using. setso and setzadmin (require PHP)
ui_step "Configuring Sentora"
# Fedora's commands, paths, services and users (the panel reads them from these settings: see
# dryden/sys/platform.class.php; setso adds a missing one before it sets it)
so() { $PANEL_PATH/panel/bin/setso --set "$1" "$2" > /dev/null; }
