# command line (where every process list shows it); the file goes when the installer ends
MYSQL_ROOT_CNF=$(mktemp /root/.sentora-install-mysql.XXXXXX)
printf '[client]\nuser=root\npassword="%s"\n' "$mysqlpassword" > "$MYSQL_ROOT_CNF"
sqlroot() { mysql --defaults-extra-file="$MYSQL_ROOT_CNF" "$@"; }
# a text for an SQL string between single quotes
sql_str() { printf '%s' "$1" | sed -e "s/\\\\/\\\\\\\\/g" -e "s/'/''/g"; }

# small cleaning of mysql access (no anonymous users or test database, checked anyway);
# mariadb.sys and mysql are MariaDB's own locked accounts
sqlroot -e "DELETE FROM mysql.global_priv WHERE User='root' AND Host != 'localhost'";
sqlroot -e "DELETE FROM mysql.global_priv WHERE User=''";
sqlroot -e "FLUSH PRIVILEGES";
sqlroot -e "DROP DATABASE IF EXISTS test";

