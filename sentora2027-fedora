# Wait until the user have read before restarts the server...
if [[ "$INSTALL" != "auto" ]] ; then
    while true; do
        ui_yesno "Restart the server now to complete the installation?"
        case $yn in
            [Yy]* ) break;;
            [Nn]* ) echo; echo "  Restart it yourself later: shutdown -r now"; echo; exit;
        esac
    done
    shutdown -r now
fi
