chmod 644 "$SSL_DIR/sentora.crt" "$SSL_DIR/sentora-chain.crt"

# Serve the panel (and webmail) over HTTPS; the daemon adds an http:// redirect
sqlroot -e "UPDATE sentora_core.x_settings SET so_value_tx='443' WHERE so_name_vc='sentora_port'"
sqlroot -e "UPDATE sentora_core.x_settings SET so_value_tx='SSLEngine On\nSSLCertificateFile $SSL_DIR/sentora.crt\nSSLCertificateKeyFile $SSL_DIR/sentora.key' WHERE so_name_vc='panel_ssl_tx'"

