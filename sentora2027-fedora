##
#--- SpamAssassin and ClamAV (Admin > SpamAV Admin, Mail > SpamAV)
##
# Postfix hands each message to clamav-milter and spamass-milter; the Sentora daemon
# writes their settings and starts what is switched on (dryden/sys/spamav.class.php).
ui_step "Installing SpamAssassin and ClamAV"
# (not sa-compile: compiling the rules is only a small speed-up, and its package setup
# compiles them at once, which takes minutes and fails on a server without rules yet)
install_available spamassassin spamass-milter spamass-milter-postfix perl-DBD-MariaDB clamav clamd clamav-milter clamav-freshclam
# SpamAssassin's children run as their own user (Fedora has none for it)
id spamd > /dev/null 2>&1 || useradd -r -d /var/lib/spamassassin -s /sbin/nologin -c "SpamAssassin" spamd
mkdir -p /var/lib/spamassassin; chown spamd:spamd /var/lib/spamassassin
for u in clamilt sa-milt; do
    id "$u" > /dev/null 2>&1 && usermod -aG postfix "$u"
done
# (ClamAV's socket folder, /run/clamd.scan, is for the group virusgroup)
id clamilt > /dev/null 2>&1 && getent group virusgroup > /dev/null && usermod -aG virusgroup clamilt
# The mail connections' sockets are where Fedora's packages and SELinux rules put them:
# /run/spamass-milter/postfix (spamass-milter-postfix, group postfix) and /run/clamav-milter
# (made at each boot; Sentora's daemon gives it the postfix group, so Postfix can reach the socket)
printf 'd /run/clamav-milter 0710 clamilt postfix\n' > /etc/tmpfiles.d/clamav-milter.conf
systemd-tmpfiles --create /etc/tmpfiles.d/clamav-milter.conf /usr/lib/tmpfiles.d/spamass-milter.conf \
    /usr/lib/tmpfiles.d/spamass-milter-postfix.conf > /dev/null 2>&1
mkdir -p $PANEL_DATA/sieve/spamav /var/log/clamav
chown vmail:mail $PANEL_DATA/sieve/spamav; chmod 750 $PANEL_DATA/sieve/spamav
chown clamscan:clamscan /var/log/clamav 2> /dev/null; chmod 775 /var/log/clamav
# The packages start with their own settings: stopped until the daemon has written Sentora's
systemctl stop clamav-milter clamd@scan spamass-milter spamassassin > /dev/null 2>&1
MEM_MB=$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo)
if [ "${MEM_MB:-0}" -lt 1900 ]; then
    echo " ClamAV left off: it needs about 1.5 GB of memory for its signatures, this server has ${MEM_MB} MB."
    echo " Switch it on in Admin > SpamAV Admin when the server has more memory."
    systemctl disable --now clamav-freshclam > /dev/null 2>&1
else
    # the first virus signatures, in the background (scanning starts when they are in)
    systemctl enable --now clamav-freshclam > /dev/null 2>&1
fi

##
#--- Apache server
##
ui_step "Installing and configuring Apache"
$PACKAGE_INSTALLER httpd mod_ssl mod_http2 mod_lua openssl
HTTP_CONF_PATH="/etc/httpd/conf/httpd.conf"
HTTP_SERVICE="httpd"
# (mod_rewrite, headers, lua, ssl, status, proxy_fcgi: installed and on with the packages above)
# ModSecurity (Apache's web application firewall, from Fedora's repositories): installed
# switched off; the Web Hardening add-on (Repo Browser) switches it on with Sentora's copy of the OWASP
# rules. Its own settings files stay empty (a package update keeps an emptied file).
$PACKAGE_INSTALLER mod_security > /dev/null 2>&1 \
    || echo "WARNING: ModSecurity did not install (dnf install mod_security); the Web Hardening add-on needs it"
MODSEC_OFF='for f in /etc/httpd/conf.modules.d/*mod_security*.conf /etc/httpd/conf.d/mod_security.conf; do if [ -s "$f" ]; then mv "$f" "$f.disabled-by-sentora"; : > "$f"; fi; done; true'
sh -c "$MODSEC_OFF"
mkdir -p "$PANEL_CONF/apache/modsecurity.d"

if ! grep -q "Include $PANEL_CONF/apache/httpd.conf" "$HTTP_CONF_PATH"; then
    echo "Include $PANEL_CONF/apache/httpd.conf" >> "$HTTP_CONF_PATH";
fi
add_local_domain "$(hostname)"

# Create root directory for public HTTP docs
mkdir -p $PANEL_DATA/hostdata/zadmin/public_html
chown -R $HTTP_USER:$HTTP_GROUP $PANEL_DATA/hostdata/
chmod -R 770 $PANEL_DATA/hostdata/

sqlroot -e "UPDATE sentora_core.x_settings SET so_value_tx='$HTTP_SERVICE' WHERE so_name_vc='httpd_exe'"
sqlroot -e "UPDATE sentora_core.x_settings SET so_value_tx='$HTTP_SERVICE' WHERE so_name_vc='apache_sn'"

#Set keepalive on (default is off)
sed -i "s|^KeepAlive Off|KeepAlive On|" "$HTTP_CONF_PATH"

# Sentora's vhosts file says which ports Apache listens on: Fedora's own Listen goes, and so do
# its stock pages (a welcome page, the test SSL site on 443 with a made-up certificate, user
# folders) and its PHP handler for every site (each site has its own PHP pool here)
sed -i "s|^Listen 80|# Listen 80   (Sentora: the ports are set in Sentora's vhosts file)|" "$HTTP_CONF_PATH"
for f in welcome.conf ssl.conf userdir.conf autoindex.conf php.conf; do
    [ -f "/etc/httpd/conf.d/$f" ] && mv "/etc/httpd/conf.d/$f" "/etc/httpd/conf.d/$f.disabled-by-sentora"
    # (an empty file in its place: a package update would bring the stock one back otherwise)
    : > "/etc/httpd/conf.d/$f"
done
# the SSL module's own settings that ssl.conf held (session cache, entropy)
cat > /etc/httpd/conf.d/00-sentora-ssl.conf <<'EOF_SSL'
# Sentora: the parts of Fedora's ssl.conf that are not a site (the test site on 443 is gone)
SSLPassPhraseDialog exec:/usr/libexec/httpd-ssl-pass-dialog
SSLSessionCache         shmcb:/run/httpd/sslcache(512000)
SSLSessionCacheTimeout  300
SSLCryptoDevice builtin
EOF_SSL
# the event engine (no mod_php here: PHP runs in PHP-FPM)
if [ -f /etc/httpd/conf.modules.d/00-mpm.conf ]; then
    sed -i -e 's|^LoadModule mpm_prefork_module|#LoadModule mpm_prefork_module|' -e 's|^LoadModule mpm_worker_module|#LoadModule mpm_worker_module|'         -e 's|^#LoadModule mpm_event_module|LoadModule mpm_event_module|' /etc/httpd/conf.modules.d/00-mpm.conf
fi

# adjustments for apache 2.4
# Order deny,allow / Deny from all   ->  Require all denied
sed -i 's|Order deny,allow|Require all denied|I'  $PANEL_CONF/apache/httpd.conf
sed -i '/Deny from all/d' $PANEL_CONF/apache/httpd.conf

# Order allow,deny / Allow from all  ->  Require all granted
sed -i 's|Order allow,deny|Require all granted|I' $PANEL_CONF/apache/httpd-vhosts.conf
sed -i '/Allow from all/d' $PANEL_CONF/apache/httpd-vhosts.conf

sed -i 's|Order allow,deny|Require all granted|I'  $PANEL_PATH/panel/modules/apache_admin/hooks/OnDaemonRun.hook.php
sed -i '/Allow from all/d' $PANEL_PATH/panel/modules/apache_admin/hooks/OnDaemonRun.hook.php

# Remove NameVirtualHost that is now without effect and generate warning.
sed -i '/^NameVirtualHost/d' $PANEL_CONF/apache/httpd-vhosts.conf
sed -i '/# NameVirtualHost is/ {N;N;N;N;N;d}' $PANEL_PATH/panel/modules/apache_admin/hooks/OnDaemonRun.hook.php

# Options must have ALL (or none) +/- prefix, disable listing directories
sed -i 's| FollowSymLinks [-]Indexes| +FollowSymLinks -Indexes|' $PANEL_PATH/panel/modules/apache_admin/hooks/OnDaemonRun.hook.php

##
#--- PHP (Fedora's own version, 8.3: the panel's, and the default for hosted sites)
##
ui_step "Installing PHP"
# (php-ldap: sites that log users in against Active Directory, such as Snipe-IT; php-process: posix)
install_available php php-fpm php-common php-bcmath php-cli php-mysqlnd php-gd php-pear php-pecl-imagick php-xml php-intl \
    php-mbstring php-devel php-pecl-zip php-ldap php-process php-soap php-sodium php-gmp
PHPVER=$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')
echo "Detected PHP: $PHPVER"
if [[ "$PHPVER" != 8.* ]]; then
    echo "ERROR: PHP 8 did not install (found: '${PHPVER:-none}'), so the installation can not continue."
    exit 1
fi
PHP_INI_PATH="/etc/php.ini"

# mcrypt (old sites still call it) from PECL, when the system still has libmcrypt
# (Fedora has no libmcrypt: then this is skipped quietly)
dnf -q repoquery --latest-limit=1 libmcrypt-devel 2> /dev/null | grep -q . && install_available libmcrypt-devel
mkdir -p /tmp/pear/cache
if inst libmcrypt-devel; then
    pecl channel-update pecl.php.net
    echo "Building PHP-mcrypt"
    echo | pecl install mcrypt
else
    echo "libmcrypt-devel is not available: no PHP-mcrypt"
fi
PHP_EXT_DIR=$(php -r 'echo ini_get("extension_dir");')
if [ -f "$PHP_EXT_DIR/mcrypt.so" ]; then
    echo 'extension=mcrypt.so' > /etc/php.d/40-mcrypt.ini
else
    echo "PHP-mcrypt was not built for PHP $PHPVER, it is not switched on."
fi

ui_step "Configuring PHP"
sed -i "s|memory_limit = .*|memory_limit = 256M|g" $PHP_INI_PATH

# Setup php upload dir
mkdir -p $PANEL_DATA/temp
chmod 1777 $PANEL_DATA/temp/
chown -R $HTTP_USER:$HTTP_GROUP $PANEL_DATA/temp/

# Setup php session save directory
mkdir "$PANEL_DATA/sessions"
chown $HTTP_USER:$HTTP_GROUP "$PANEL_DATA/sessions"
chmod 733 "$PANEL_DATA/sessions"
chmod +t "$PANEL_DATA/sessions"

sed -i "s|;session.save_path = .*|session.save_path = \"$PANEL_DATA/sessions\"|g" $PHP_INI_PATH

sed -i "/php_value/d" $PHP_INI_PATH
echo "session.save_path = $PANEL_DATA/sessions;" >> $PHP_INI_PATH

# setup timezone and upload temp dir
sed -i "s|;date.timezone =|date.timezone = $tz|g" $PHP_INI_PATH
sed -i "s|;upload_tmp_dir =|upload_tmp_dir = $PANEL_DATA/temp/|g" $PHP_INI_PATH

# Disable php signature in headers to hide it from hackers
sed -i 's|expose_php = On|expose_php = Off|g' $PHP_INI_PATH

# PCRE's JIT compiler is off, as on Ubuntu (where Apache's sandbox blocks it): the same
# behaviour for the sites on every system.
if grep -q "^;*pcre.jit" $PHP_INI_PATH; then
    sed -i "s|^;*pcre.jit *=.*|pcre.jit = 0|" $PHP_INI_PATH
else
    echo "pcre.jit = 0" >> $PHP_INI_PATH
fi

# The panel lives in /etc/sentora and writes its template cache and settings there, and reads
# /proc for uptime and system info: kept so should a package sandbox Apache later; and the umask
# the sites need (files they make are group-writable, so the panel's File Manager can edit them)
mkdir -p /etc/systemd/system/httpd.service.d
cat > /etc/systemd/system/httpd.service.d/sentora.conf <<EOF_UNIT
[Service]
ReadWritePaths=$PANEL_PATH
ProtectProc=default
ProcSubset=all
UMask=0002
EOF_UNIT
systemctl daemon-reload

#--- Every hosted account runs its PHP as its own Linux user (web<account id>), in
# its own PHP-FPM pool that the daemon creates; Apache does not run PHP itself
mkdir -p /var/lib/sentora/accounts
chmod 700 /var/lib/sentora/accounts

#--- The panel's PHP-FPM pool (PHP $PHPVER, runs as $PANEL_USER)
ui_step "Setting up the panel's own PHP-FPM pool"
# Only the panel's pool: no general-purpose pool for the web server user
[ -f /etc/php-fpm.d/www.conf ] && mv /etc/php-fpm.d/www.conf /etc/php-fpm.d/www.conf.disabled
: > /etc/php-fpm.d/www.conf   # (empty: a package update would bring the stock one back otherwise)
mkdir -p /run/php-fpm
cat > /etc/php-fpm.d/sentora.conf <<EOF_POOL
; The Sentora control panel (and phpMyAdmin, webmail) - never the hosted sites
[sentora]
user = $PANEL_USER
group = $HTTP_GROUP
listen = /run/php-fpm/sentora-panel.sock
listen.owner = $HTTP_USER
listen.group = $HTTP_GROUP
listen.mode = 0660
pm = ondemand
pm.max_children = 30
pm.process_idle_timeout = 60s
pm.max_requests = 500
request_terminate_timeout = 3600
security.limit_extensions = .php .phtml
; Sessions and uploads in folders only the panel can read
php_admin_value[session.save_path] = /var/lib/sentora/sessions
php_admin_value[upload_tmp_dir] = /var/lib/sentora/tmp
php_admin_value[sys_temp_dir] = /var/lib/sentora/tmp
php_admin_value[error_log] = $PANEL_DATA/logs/sentora-php.log
; Only the panel's own scripts may run in this pool (a hosted site's .htaccess could point at it)
php_admin_value[auto_prepend_file] = $PANEL_PATH/panel/inc/fpm_guard.php
EOF_POOL
touch "$PANEL_DATA/logs/sentora-php.log"; chown "$PANEL_USER" "$PANEL_DATA/logs/sentora-php.log"
mkdir -p /etc/systemd/system/php-fpm.service.d
cat > /etc/systemd/system/php-fpm.service.d/sentora.conf <<EOF_UNIT
[Service]
# Files the panel makes in hosting folders are group-writable for the sites and FTP
UMask=0002
EOF_UNIT
systemctl daemon-reload
systemctl enable php-fpm
systemctl restart php-fpm || echo -e "WARNING: php-fpm (the panel's PHP) did not start."

# Register apache(+php) services for autostart and start it
systemctl enable "$HTTP_SERVICE"
systemctl start "$HTTP_SERVICE"

##
#--- Extra PHP versions for hosted domains (PHP-FPM)
##
# The panel and every domain without a choice keep using Fedora's PHP 8.3
# (PHP-FPM). These versions are built for Fedora and hosted next
# to the other installer files; each runs as its own PHP-FPM service and is
# enabled or disabled in the panel's PHP Versions module.
PHP_EXTRA_VERSIONS="8.2 8.3 8.4"
# Only for moving websites from an old Sentora 2.0.2 server: installed switched OFF (no security
# fixes since 2019), switched on in PHP Versions for a move. Its bundle carries its own OpenSSL 1.1.
PHP_MIGRATION_VERSIONS="7.1"
ui_step "Installing extra PHP versions: $PHP_EXTRA_VERSIONS (and $PHP_MIGRATION_VERSIONS, switched off)"
# Libraries the builds link against (all part of Fedora)
PHP_BUNDLE_LIBS="libxml2 libcurl oniguruma libzip libicu libsodium libargon2 libxslt libwebp libjpeg-turbo freetype libpng gmp sqlite-libs openssl-libs openldap gnutls"
install_available $PHP_BUNDLE_LIBS
PHP_STAGE=$(mktemp -d /tmp/sentora-php.XXXXXX)
PHP_INSTALLED=""
PHP_MIGRATION_INSTALLED=""
for PV in $PHP_EXTRA_VERSIONS $PHP_MIGRATION_VERSIONS; do
    PHP_TAR="sentora-php-$PV-fedora45-amd64.tar.gz"
    if ! download_file "$PHP_TAR" "$PHP_STAGE/$PHP_TAR" "$SENTORA_INSTALLERS_REPO"; then
        echo "WARNING: PHP $PV skipped: $PHP_TAR could not be downloaded"
        continue
    fi
    # The archive holds opt/sentora-php/<version>/
    # -m: use the install time, the build machine clock may differ from this server
    tar -xzmf "$PHP_STAGE/$PHP_TAR" -C /
    PP="/opt/sentora-php/$PV"
    if ! "$PP/sbin/php-fpm" -v > /dev/null 2>&1; then
        echo -e "WARNING: PHP $PV does not run on this server, skipped."
        "$PP/sbin/php-fpm" -v 2>&1 | head -3
        continue
    fi

    # php.ini: PHP's production defaults with the same changes as the system PHP
    mkdir -p "$PP/etc/conf.d" "$PP/etc/php-fpm.d"
    cp "$PP/lib/php.ini-production" "$PP/etc/php.ini"
    sed -i "s|^memory_limit = .*|memory_limit = 256M|" "$PP/etc/php.ini"
    sed -i "s|^expose_php = .*|expose_php = Off|" "$PP/etc/php.ini"
    sed -i "s|^;date.timezone =.*|date.timezone = $tz|" "$PP/etc/php.ini"
    sed -i "s|^;upload_tmp_dir =.*|upload_tmp_dir = $PANEL_DATA/temp/|" "$PP/etc/php.ini"
    # These builds do not know Fedora's MariaDB socket path, so tell them
    sed -i "s|^mysqli.default_socket =.*|mysqli.default_socket = /var/lib/mysql/mysql.sock|" "$PP/etc/php.ini"
    sed -i "s|^pdo_mysql.default_socket *=.*|pdo_mysql.default_socket = /var/lib/mysql/mysql.sock|" "$PP/etc/php.ini"
    # (from PHP 8.5 opcache is part of PHP itself, with no opcache.so to load)
    if [ -f "$("$PP/bin/php-config" --extension-dir)/opcache.so" ]; then echo "zend_extension=opcache.so" > "$PP/etc/conf.d/10-opcache.ini"; else rm -f "$PP/etc/conf.d/10-opcache.ini"; fi
    # add-on extensions the bundle brings (PHP 7.1: apcu, redis, memcached, imagick, imap): only those that load
    [ -x "$PP/bin/sentora-php-addons" ] && "$PP/bin/sentora-php-addons"

    cat > "$PP/etc/php-fpm.conf" <<EOF_FPM
[global]
pid = /run/sentora-php/php$PV-fpm.pid
error_log = $PANEL_DATA/logs/php$PV-fpm.log
include = $PP/etc/php-fpm.d/*.conf
EOF_FPM
    # Accounts get their own pools here (web<id>.conf, written by the daemon).
    # PHP-FPM needs at least one pool to start, so a version nobody uses yet keeps
    # this idle one: no one can connect to it (root-only socket), and with
    # processes started on demand it costs only the small master process.
    cat > "$PP/etc/php-fpm.d/00-idle.conf" <<EOF_POOL
[sentora-idle]
user = nobody
group = nobody
listen = /run/sentora-php/php$PV-idle.sock
listen.owner = root
listen.group = root
listen.mode = 0600
pm = ondemand
pm.max_children = 1
EOF_POOL

    cat > "/etc/systemd/system/sentora-php$PV-fpm.service" <<EOF_UNIT
[Unit]
Description=PHP $PV FastCGI Process Manager for Sentora hosted domains
After=network.target

[Service]
Type=simple
RuntimeDirectory=sentora-php
RuntimeDirectoryPreserve=yes
ExecStartPre=$PP/sbin/php-fpm --test --fpm-config $PP/etc/php-fpm.conf
ExecStart=$PP/sbin/php-fpm --nodaemonize --fpm-config $PP/etc/php-fpm.conf
ExecReload=/bin/kill -USR2 \$MAINPID
Restart=on-failure
PrivateTmp=true
# as the system PHP: files the sites make are group-writable for the panel's File Manager
UMask=0002

[Install]
WantedBy=multi-user.target
EOF_UNIT
    touch "$PANEL_DATA/logs/php$PV-fpm.log"
    case " $PHP_MIGRATION_VERSIONS " in
        *" $PV "*) PHP_MIGRATION_INSTALLED="$PHP_MIGRATION_INSTALLED $PV" ;;   # stays off and stopped
        *) PHP_INSTALLED="$PHP_INSTALLED,$PV" ;;
    esac
done
rm -rf "$PHP_STAGE" "$REL_DIR"
systemctl daemon-reload
