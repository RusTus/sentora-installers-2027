##
#--- BIND
##
ui_step "Installing and configuring BIND"
install_available bind bind-utils
# (Fedora installs BIND's service as bind.service, with named.service only an alias that can not be
# switched on at boot: the real name, also for the panel's setting bind_service)
BIND_SERVICE=$(basename "$(readlink -f /usr/lib/systemd/system/named.service 2> /dev/null)" .service)
[ -n "$BIND_SERVICE" ] && [ "$BIND_SERVICE" != "." ] || BIND_SERVICE="named"
if ! command -v named-checkconf > /dev/null 2>&1; then
    echo -e "\nERROR: BIND (bind, bind-utils) did not install, so DNS will not work."
    echo "Run 'dnf install bind bind-utils' to see why, then run the installer again."
fi
# Fedora keeps BIND's main file at /etc/named.conf (and rndc's at /etc/rndc.*)
BIND_PATH="/etc/"
BIND_FILES="/etc"
BIND_USER="named"
sqlroot -e "UPDATE sentora_core.x_settings SET so_value_tx='/var/sentora/logs/bind/bind.log' WHERE so_name_vc='bind_log'"

sqlroot -e "UPDATE sentora_core.x_settings SET so_value_tx='$BIND_PATH' WHERE so_name_vc='bind_dir'"
sqlroot -e "UPDATE sentora_core.x_settings SET so_value_tx='$BIND_SERVICE' WHERE so_name_vc='bind_service'"

# Setup logging directory
mkdir -p $PANEL_DATA/logs/bind
touch $PANEL_DATA/logs/bind/bind.log $PANEL_DATA/logs/bind/debug.log
# BIND owns and writes the logs; the panel (in the bind group, see below) reads them.
# 640 keeps them unreadable to anyone else - the old "Set Permissions" button in
# DNS Admin used to chmod these 0777, which is why it is gone.
chown "$BIND_USER":"$BIND_USER" $PANEL_DATA/logs/bind/bind.log $PANEL_DATA/logs/bind/debug.log
chmod 640 $PANEL_DATA/logs/bind/bind.log $PANEL_DATA/logs/bind/debug.log
usermod -a -G "$BIND_USER" "$PANEL_USER"

mkdir -p /var/named/dynamic /var/named/data
touch /var/named/dynamic/managed-keys.bind
chown -R bind:bind /var/named/

# The check tools are in /usr/bin or /usr/sbin depending on the release,
# Sentora calls them by name, so make sure both locations work
for tool in named-checkconf named-checkzone named-compilezone; do
    [ -e /usr/bin/$tool ] || [ ! -e /usr/sbin/$tool ] || ln -s /usr/sbin/$tool /usr/bin/$tool
done

# Setup acl IP to forbid zone transfer
sed -i "s|!SERVER_IP!|$PUBLIC_IP|" $PANEL_CONF/bind/named.conf

# Build key and conf files
rm -rf $BIND_FILES/named.conf $BIND_FILES/rndc.conf $BIND_FILES/rndc.key
rndc-confgen -a -A hmac-sha256
cat $BIND_FILES/rndc.key $PANEL_CONF/bind/named.conf > $BIND_FILES/named.conf
cat $BIND_FILES/rndc.key $PANEL_CONF/bind/rndc.conf > $BIND_FILES/rndc.conf
rm -f $BIND_FILES/rndc.key

# (SELinux: Sentora's zone and log folders get BIND's labels further down)
chown root:"$BIND_USER" $BIND_FILES/named.conf $BIND_FILES/rndc.conf 2> /dev/null; chmod 640 $BIND_FILES/named.conf $BIND_FILES/rndc.conf 2> /dev/null

if named-checkconf $BIND_FILES/named.conf; then
    systemctl enable "$BIND_SERVICE"
    systemctl restart "$BIND_SERVICE"
else
    echo -e "\nWARNING: $BIND_FILES/named.conf did not pass named-checkconf, BIND was not started."
fi

