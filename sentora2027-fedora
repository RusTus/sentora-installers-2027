so package_install "dnf -y -q install"; so php_ext_package "php-{e}"
so php_bundle_tag fedora45; so php_bundle_libs "$PHP_BUNDLE_LIBS"
# ModSecurity (Web Hardening switches it on): package, module files, data folder, the folder Sentora's
# httpd.conf includes, and the command that keeps the system's own settings off
so modsec_package mod_security; so modsec_module /usr/lib64/httpd/modules/mod_security2.so
so modsec_unique_id_module /usr/lib64/httpd/modules/mod_unique_id.so; so modsec_data_dir /var/lib/mod_security
so modsec_conf_dir "$PANEL_CONF/apache/modsecurity.d"; so modsec_off_cmd "$MODSEC_OFF"
