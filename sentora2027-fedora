SSL_SAN="DNS:$PANEL_FQDN"
[[ "$PUBLIC_IP" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && SSL_SAN="$SSL_SAN,IP:$PUBLIC_IP"
