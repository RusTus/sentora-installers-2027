so dovecot_conf /etc/dovecot/dovecot.conf; so dovecot_service dovecot
so spamd_bin /usr/bin/spamd; so clamd_bin /usr/sbin/clamd; so sogo_bin /opt/sentora-sogo/sbin/sogod; so sogo_tool_dir /usr/local/sbin; so sogo_user sogo
so clamav_user clamscan; so clamd_conf /etc/clamd.d/scan.conf; so clamd_socket /run/clamd.scan/clamd.sock; so clamd_service clamd@scan
so clamav_milter_conf /etc/mail/clamav-milter.conf; so clamav_milter_pid /run/clamav-milter/clamav-milter.pid
so clamav_milter_service clamav-milter; so clamav_milter_user clamilt
so clamav_milter_socket /run/clamav-milter/clamav-milter.socket; so clamav_log_dir /var/log/clamav
so freshclam_conf /etc/freshclam.conf; so freshclam_service clamav-freshclam; so freshclam_user clamupdate
so spamd_user spamd; so spamassassin_dir /etc/mail/spamassassin; so spamd_defaults_file /etc/sysconfig/spamassassin
so spamd_defaults_template 'SPAMDOPTIONS="{options}"'; so spamd_service spamassassin; so spamd_maintenance_timer ""
so spamass_milter_socket /run/spamass-milter/postfix/sock
so spamass_milter_skip_auth_flag -a; so spamass_milter_user sa-milt; so spamass_milter_defaults_file /etc/sysconfig/spamass-milter; so spamass_milter_service spamass-milter
so spamass_milter_defaults_template 'EXTRA_FLAGS="{options}"
