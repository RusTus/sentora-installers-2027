# The package lists must be readable before anything is installed. A mirror (or something on the network
# in between) that answers with something else than its package list makes every install fail: first
# dnf's cache is cleared and it tries again; then the system's own repositories are switched from their
# mirror list (plain http mirrors) to the distribution's own server over HTTPS (the same signed packages:
# nothing in between can change them); then the installation stops, before anything was installed.
# Reads and rewrites "$logfile.apt" (dnf makecache's output).
https_repos() {
    local f
    for f in /etc/yum.repos.d/almalinux*.repo /etc/yum.repos.d/rocky*.repo; do
        [ -f "$f" ] || continue
        [ -f "$f.sentora-orig" ] || cp -p "$f" "$f.sentora-orig"
        sed -i -e 's|^mirrorlist=|#mirrorlist=|' \
            -e 's|^# *baseurl=https://repo.almalinux.org|baseurl=https://repo.almalinux.org|' \
            -e 's|^# *baseurl=http://dl.rockylinux.org|baseurl=https://dl.rockylinux.org|' "$f"
    done
}
package_lists_readable() {
    local try
    for try in 1 2 3; do
        grep -qiE "Failed to download metadata|parser error|Cannot download repomd|Curl error" "$logfile.apt" 2> /dev/null || return 0
        case $try in
            1) echo "The package lists could not be read: clearing dnf's cache and trying again" ;;
            2) echo "Still not readable: the system's repositories now use their distribution's own server over HTTPS"
               echo "(their files before: /etc/yum.repos.d/*.repo.sentora-orig)"
               https_repos ;;
            3) ui_err "The package lists could not be read (see above): nothing was installed."
               echo "  Check that this server reaches its package mirrors (dnf clean all; dnf makecache), then run the installer again."
               rm -f "$logfile.apt"
               exit 1 ;;
        esac
        dnf clean all > /dev/null 2>&1
        sleep 5
        dnf -y -q makecache 2>&1 | tee "$logfile.apt" || true
    done
}

