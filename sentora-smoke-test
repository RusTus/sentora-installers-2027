#!/bin/bash
# sentora-smoke-test: try the server the way a client uses it, end to end.
#
#   sentora-smoke-test           run every step, then remove everything it made
#   sentora-smoke-test --keep    leave the test client in place (to look at it)
#
# It makes a temporary client (smoketest<random>) with a domain, an FTP account, a
# mailbox, a database and a MySQL user through the panel's own pages, uses each of
# them for real (FTPS upload, the website, SMTP, IMAP, SOGo, MySQL, Show password,
# backup and restore, isolation from other accounts) and removes it all again.
#
# Every step prints PASS, FAIL or SKIP. The last lines say RESULT: PASSED or
# RESULT: FAILED with the failed steps and why. Exit code 0 = everything passed.
# The report is also saved in /var/sentora/logs/smoke-test.log.

PANEL=${SENTORA_PANEL:-/etc/sentora/panel}
LOG=${SENTORA_SMOKE_LOG:-/var/sentora/logs/smoke-test.log}
KEEP=0; [ "${1:-}" = "--keep" ] && KEEP=1

if [ -t 1 ]; then G=$'\e[1;32m'; Rd=$'\e[1;31m'; Y=$'\e[1;33m'; B=$'\e[1m'; N=$'\e[0m'; else G=""; Rd=""; Y=""; B=""; N=""; fi
PASSES=0; FAILS=0; SKIPS=0; STEP=0; TOTAL=26
FAILED_LIST=()
WHY=""

out()  { echo "$*"; echo "$*" | sed 's/\x1b\[[0-9;]*m//g' >> "$LOG"; }
step() { # step "Name" function: the function returns 0 (pass), 1 (fail, $WHY says why) or 2 (skip, $WHY says why)
    STEP=$((STEP + 1)); WHY=""
    local name="$1"; shift
    local line; line=$(printf "  [%2d/%d] %s " "$STEP" "$TOTAL" "$name")
    "$@"; local rc=$?
    WHY=$(printf '%s' "$WHY" | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//' | cut -c1-160)
    local dots; dots=$(printf '%*s' $((64 - ${#line})) '' | tr ' ' '.')
    case $rc in
        0) PASSES=$((PASSES + 1)); out "$line$dots ${G}PASS${N}" ;;
        2) SKIPS=$((SKIPS + 1)); out "$line$dots ${Y}SKIP${N}  $WHY" ;;
        *) FAILS=$((FAILS + 1)); FAILED_LIST+=("$name: ${WHY:-no reason given}"); out "$line$dots ${Rd}FAIL${N}  ${WHY:-no reason given}" ;;
    esac
    return $rc
}
need() { # need VAR "step it comes from": skip when an earlier step did not get that far
    [ -n "${!1:-}" ] && return 0
    WHY="needs: ${2:-an earlier step}"; return 2
}

[ "$(id -u)" -eq 0 ] || { echo "Run this as root."; exit 2; }
for t in curl php mysql setpriv; do command -v "$t" > /dev/null || { echo "$t is needed"; exit 2; }; done
mkdir -p "$(dirname "$LOG")"; : > "$LOG"

# --- what the test uses -----------------------------------------------------------------
val() { grep -o "\$$1 = '[^']*'" "$PANEL/cnf/db.php" | head -1 | cut -d"'" -f2; }
MYCNF=$(mktemp); chmod 600 "$MYCNF"
H=$(val host); printf '[client]\nuser=%s\npassword=%s\n' "$(val user)" "$(val pass)" > "$MYCNF"
case "$H" in *:*) printf 'host=%s\nport=%s\n' "${H%%:*}" "${H##*:}" >> "$MYCNF" ;; localhost|"") ;; *) echo "host=$H" >> "$MYCNF" ;; esac
q() { mysql --defaults-extra-file="$MYCNF" -N -B -e "$1" sentora_core 2> /dev/null; }
FQDN=$(q "SELECT so_value_tx FROM x_settings WHERE so_name_vc='sentora_domain'")
HOSTED=$(q "SELECT so_value_tx FROM x_settings WHERE so_name_vc='hosted_dir'"); HOSTED=${HOSTED%/}
RND=$(head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n')
U="smoketest$RND"; UPW="Sm0ke-$(head -c 9 /dev/urandom | od -An -tx1 | tr -d ' \n')"
DOM="smoke$RND.test"; MAILPW="Ma1l-$RND-$(head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n')"
FTPPW="Ftp-$RND-$(head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n')"
TMP=$(mktemp -d); CJ="$TMP/cookies"
ACC_ID=""; WEBU=""; FTPUSER=""; MAILADDR=""; DBNAME=""; MYUSER=""; MYPW=""; BACKUP=""

pcurl() { curl -sk --max-time 30 --resolve "$FQDN:443:127.0.0.1" -c "$CJ" -b "$CJ" "$@"; }
token() { pcurl "https://$FQDN/?module=$1" | grep -o 'name="csfr_token" value="[^"]*"' | head -1 | sed 's/.*value="//;s/"//'; }
php_panel() { # run PHP with the panel loaded, as the administrator (zadmin)
    ( cd "$PANEL" && php -r 'chdir("'"$PANEL"'"); require "dryden/loader.inc.php"; require "cnf/db.php"; require "inc/dbc.inc.php"; $_SESSION["zpuid"] = 1; '"$1" "${@:2}" 2>&1 )
}
daemon_run() { php "$PANEL/bin/daemon.php" > "$TMP/daemon.log" 2>&1; }

cleanup() {
    [ $KEEP -eq 1 ] && { out ""; out "  --keep: the test client $U (password $UPW) is left in place."; return; }
    [ -n "$ACC_ID" ] || return 0
    php_panel 'require "modules/manage_clients/code/controller.ext.php"; module_controller::ExecuteDeleteClient((int) $argv[1], 1);' "$ACC_ID" > /dev/null
    [ -n "$DBNAME" ] && q "DROP DATABASE IF EXISTS \`$DBNAME\`"
    [ -n "$MYUSER" ] && q "DROP USER IF EXISTS '$MYUSER'@'%'; DROP USER IF EXISTS '$MYUSER'@'localhost'"
    daemon_run
    rm -rf "${HOSTED:?}/$U"
    [ -n "$WEBU" ] && id "$WEBU" > /dev/null 2>&1 && userdel "$WEBU" > /dev/null 2>&1
    true
}
finish() {
    step "Remove everything the test made" s_cleanup
    rm -rf "$TMP" "$MYCNF"
    local result="PASSED"; local colour=$G; [ $FAILS -gt 0 ] && { result="FAILED"; colour=$Rd; }
    out ""
    out "=============================================================================="
    out " ${B}RESULT: ${colour}${result}${N}   $PASSES passed, $FAILS failed, $SKIPS skipped (of $STEP steps)"
    if [ $FAILS -gt 0 ]; then
        out " Failed:"
        for f in "${FAILED_LIST[@]}"; do out "   - $f"; done
    fi
    out " Report: $LOG"
    out "=============================================================================="
    [ $FAILS -eq 0 ]
}

# --- the steps --------------------------------------------------------------------------------
s_panel() {
    [ -n "$FQDN" ] || { WHY="could not read the panel's settings from MySQL"; return 1; }
    local c; c=$(pcurl -o /dev/null -w '%{http_code}' "https://$FQDN/")
    [ "$c" = 200 ] || { WHY="https://$FQDN/ answered $c"; return 1; }
}
s_client() {
    local r; r=$(php_panel 'require "modules/manage_clients/code/controller.ext.php";
        $pkg = (int) $zdbh->query("SELECT pk_id_pk FROM x_packages WHERE pk_reseller_fk = 1 AND pk_deleted_ts IS NULL ORDER BY pk_id_pk LIMIT 1")->fetchColumn();
        $ok = module_controller::ExecuteCreateClient(1, $argv[1], $pkg, 3, "Smoke Test", $argv[1] . "@example.invalid", "-", "-", "-", $argv[2], 0, "", "");
        echo $ok ? (int) $zdbh->query("SELECT ac_id_pk FROM x_accounts WHERE ac_user_vc = " . $zdbh->quote($argv[1]) . " AND ac_deleted_ts IS NULL")->fetchColumn() : "failed";' "$U" "$UPW" | tail -1)
    [[ "$r" =~ ^[0-9]+$ ]] && [ "$r" -gt 0 ] || { WHY="the panel did not create the client: $r"; return 1; }
    ACC_ID=$r; WEBU="web$r"
}
s_login() {
    need ACC_ID "Create a test client" || return $?
    pcurl -o "$TMP/p.html" "https://$FQDN/"
    local t; t=$(grep -o 'name="csfr_token" value="[^"]*"' "$TMP/p.html" | head -1 | sed 's/.*value="//;s/"//')
    pcurl -o /dev/null -d "inUsername=$U&inPassword=$UPW&csfr_token=$t" "https://$FQDN/"
    pcurl -o "$TMP/p.html" "https://$FQDN/?module=domains"
    grep -q 'name="inUsername"' "$TMP/p.html" && { WHY="the login was refused"; return 1; }
    grep -q 'name="inDomain"' "$TMP/p.html" || { WHY="the Domains page did not open after logging in"; return 1; }
    # shellcheck disable=SC2034  # read by need() through ${!v}
    LOGGED_IN=1
}
s_domain() {
    need LOGGED_IN "Log in to the panel as the client" || return $?
    pcurl -o "$TMP/p.html" -d "inDomain=$DOM&inDestination=&inAutoHome=1&csfr_token=$(token domains)" "https://$FQDN/?module=domains&action=CreateDomain"
    DOMDIR=$(q "SELECT vh_directory_vc FROM x_vhosts WHERE vh_name_vc='$DOM' AND vh_acc_fk=$ACC_ID AND vh_deleted_ts IS NULL")
    [ -n "$DOMDIR" ] || { WHY="the domain was not added: $(sed 's/<[^>]*>/ /g' "$TMP/p.html" | tr -s ' \n' | grep -io 'alert[^.]*\.\|error[^.]*\.' | head -1)"; return 1; }
}
s_daemon() {
    need DOMDIR "Add a domain" || return $?
    daemon_run || { WHY="the daemon run failed (see $TMP/daemon.log)"; return 1; }
    grep -q "Daemon run complete" "$TMP/daemon.log" || { WHY="the daemon run did not complete: $(grep -m1 -i 'error' "$TMP/daemon.log" | cut -c1-120)"; return 1; }
    grep -qE "PHP (Warning|Fatal)" "$TMP/daemon.log" && { WHY="PHP warnings in the daemon run: $(grep -m1 -E 'PHP (Warning|Fatal)' "$TMP/daemon.log" | cut -c1-120)"; return 1; }
    return 0
}
s_account() {
    need DOMDIR "Add a domain" || return $?
    id "$WEBU" > /dev/null 2>&1 || { WHY="no Linux user $WEBU"; return 1; }
    [ -d "$HOSTED/$U/public_html${DOMDIR}" ] || { WHY="no folder for the domain ($HOSTED/$U/public_html$DOMDIR)"; return 1; }
    [ "$(stat -c '%U' "$HOSTED/$U")" = "$WEBU" ] || { WHY="the account folder is not owned by $WEBU"; return 1; }
    local _
    # the system PHP's pools listen in /run/php, the extra versions' in /run/sentora-php
    # (each checked on its own: one missing must not hide the other)
    for _ in $(seq 1 30); do
        [ -S "/run/php/$WEBU.sock" ] && return 0
        [ -S "/run/sentora-php/$WEBU.sock" ] && return 0
        sleep 2
    done
    if grep -qs "^\[$WEBU\]" /etc/php/*/fpm/pool.d/*.conf /opt/sentora-php/*/etc/php-fpm.d/*.conf; then
        WHY="the pool for $WEBU is written but PHP-FPM has not opened its socket after 60 seconds (systemctl status php*-fpm sentora-php*-fpm)"
    else
        WHY="no PHP pool was written for $WEBU (the daemon makes it: see $TMP/daemon.log)"
    fi
    return 1
}
s_ftp_create() {
    need DOMDIR "Add a domain" || return $?
    pcurl -o "$TMP/p.html" -d "inFTPUsername=ftp&inPassword=$FTPPW&inAccess=RW&inAutoHome=2&inDestination=public_html${DOMDIR}&inDomainDestination=&inSubmit=1&csfr_token=$(token ftp_management)" "https://$FQDN/?module=ftp_management&action=CreateFTP"
    FTPUSER="${U}_ftp"
    local hash; hash=$(q "SELECT LEFT(passwd,3) FROM sentora_proftpd.ftpuser WHERE userid='$FTPUSER'")
    [ -n "$hash" ] || { FTPUSER=""; WHY="the FTP account was not made"; return 1; }
    [ "$hash" = '$6$' ] || { WHY="ProFTPD's password is not a SHA-512 hash"; return 1; }
}
s_ftp_upload() {
    need FTPUSER "Create an FTP account" || return $?
    printf '<?php $u = function_exists("posix_getpwuid") ? posix_getpwuid(posix_geteuid())["name"] : getmyuid(); echo "smoke-ok-%s " . $u;\n' "$RND" > "$TMP/index.php"
    local e; e=$(curl -sSk --max-time 30 --ssl-reqd -u "$FTPUSER:$FTPPW" -T "$TMP/index.php" "ftp://127.0.0.1/index.php" 2>&1) || { WHY="FTPS upload failed: $(echo "$e" | tail -1 | cut -c1-100)"; return 1; }
    [ -f "$HOSTED/$U/public_html${DOMDIR}/index.php" ] || { WHY="the uploaded file is not in the domain folder"; return 1; }
}
s_web() {
    need DOMDIR "Add a domain" || return $?
    [ -f "$HOSTED/$U/public_html${DOMDIR}/index.php" ] || cp "$TMP/index.php" "$HOSTED/$U/public_html${DOMDIR}/index.php"
    local page _
    for _ in $(seq 1 10); do
        page=$(curl -sSkL --max-time 20 --resolve "$DOM:80:127.0.0.1" --resolve "$DOM:443:127.0.0.1" "http://$DOM/index.php" 2>&1)
        echo "$page" | grep -q "smoke-ok-$RND" && { WEBOUT=$page; return 0; }
        sleep 2
    done
    WHY="http://$DOM/ did not return the page after 20 seconds (is Apache reloading?): $(echo "$page" | sed 's/<[^>]*>/ /g' | tr -s '[:space:]' ' ' | head -c 90)"; return 1
}
s_php_user() {
    need WEBOUT "Website serves the page" || return $?
    local who; who=$(echo "$WEBOUT" | grep -o "smoke-ok-$RND [^ <]*" | awk '{print $2}')
    [ "$who" = "$WEBU" ] || { WHY="PHP runs as '$who', not as $WEBU"; return 1; }
}
s_htaccess_guard() {
    need WEBOUT "Website serves the page" || return $?
    local d="$HOSTED/$U/public_html${DOMDIR}/smokeguard" out
    mkdir -p "$d/a" "$d/b"
    cp "$TMP/index.php" "$d/a/index.php"
    printf '<FilesMatch "\\.php$">\n    SetHandler "proxy:unix:/run/php/sentora-panel.sock|fcgi://localhost"\n</FilesMatch>\n' > "$d/a/.htaccess"
    printf 'RewriteEngine On\nRewriteRule ^ - [H=server-status]\n' > "$d/b/.htaccess"
    chown -R "$WEBU" "$d"
    out=$(curl -s --max-time 20 --resolve "$DOM:80:127.0.0.1" "http://$DOM/smokeguard/a/index.php")
    echo "$out" | grep -q "smoke-ok-$RND" && { rm -rf "$d"; WHY="a site's .htaccess ran its PHP in the panel's pool (as $(echo "$out" | grep -o "smoke-ok-$RND [^ <]*" | awk '{print $2}'))"; return 1; }
    out=$(curl -s --max-time 20 --resolve "$DOM:80:127.0.0.1" "http://$DOM/smokeguard/b/")
    rm -rf "$d"
    echo "$out" | grep -qi "Apache Server Status" && { WHY="a site's .htaccess showed the server's status page"; return 1; }
    return 0
}
s_mailbox() {
    need DOMDIR "Add a domain" || return $?
    pcurl -o "$TMP/p.html" -d "inAddress=box&inDomain=$DOM&inPassword=$MAILPW&inCreate=1&csfr_token=$(token mailboxes)" "https://$FQDN/?module=mailboxes&action=AddMailbox"
    local p; p=$(q "SELECT LEFT(password,14) FROM sentora_postfix.mailbox WHERE username='box@$DOM'")
    [ -n "$p" ] || { WHY="the mailbox was not made"; return 1; }
    MAILADDR="box@$DOM"
    [ "$p" = "{SHA512-CRYPT}" ] || { WHY="the mailbox password is not stored as SHA-512 crypt ($p)"; return 1; }
}
s_imap() {
    need MAILADDR "Create a mailbox" || return $?
    local e; e=$(curl -sSk --max-time 30 -u "$MAILADDR:$MAILPW" "imaps://127.0.0.1/INBOX" -X "EXAMINE INBOX" 2>&1) || { WHY="IMAP login on port 993 failed: $(echo "$e" | tail -1 | cut -c1-100)"; return 1; }
}
s_smtp() {
    need MAILADDR "Create a mailbox" || return $?
    printf 'From: %s\r\nTo: %s\r\nSubject: Sentora smoke test %s\r\n\r\nTest message.\r\n' "$MAILADDR" "$MAILADDR" "$RND" > "$TMP/mail.txt"
    local e; e=$(curl -sSk --max-time 30 --ssl-reqd -u "$MAILADDR:$MAILPW" --mail-from "$MAILADDR" --mail-rcpt "$MAILADDR" -T "$TMP/mail.txt" "smtp://127.0.0.1:587" 2>&1) \
        || { WHY="sending on port 587 failed: $(echo "$e" | tail -1 | cut -c1-100)"; return 1; }
    # shellcheck disable=SC2034  # read by need() through ${!v}
    SENT=1
}
s_delivered() {
    need SENT "Send mail with login" || return $?
    local _
    for _ in $(seq 1 30); do
        curl -sk --max-time 15 -u "$MAILADDR:$MAILPW" "imaps://127.0.0.1/INBOX" -X "SEARCH SUBJECT \"Sentora smoke test $RND\"" 2> /dev/null | grep -qE '^\* SEARCH [0-9]' && return 0
        sleep 2
    done
    WHY="the message did not arrive in the mailbox within 60 seconds (see /var/log/mail.log)"; return 1
}
# SpamAV: mail is scanned while the sender is connected (Admin > SpamAV Admin)
s_virus() {
    need MAILADDR "Create a mailbox" || return $?
    [ -x /usr/sbin/clamd ] || { WHY="ClamAV is not installed"; return 2; }
    postconf -h smtpd_milters 2> /dev/null | grep -q clamav || { WHY="virus scanning is off, or ClamAV is still waiting for its first signatures"; return 2; }
    # EICAR as an attachment with exactly its 68 bytes (ClamAV knows it as a file: pasted
    # into the text of a message, with a line break after it, it is not the same file)
    local b64; b64=$(printf '%s' 'X5O!P%@AP[4\PZX54(P^)7CC)7}$EICAR-STANDARD-ANTIVIRUS-TEST-FILE!$H+H*' | base64 -w0)
    printf 'From: virus-test@example.com\r\nTo: %s\r\nSubject: Sentora virus test %s\r\nMIME-Version: 1.0\r\nContent-Type: multipart/mixed; boundary="sentora-%s"\r\n\r\n--sentora-%s\r\nContent-Type: text/plain\r\n\r\nSentora virus test (EICAR test file attached).\r\n--sentora-%s\r\nContent-Type: application/octet-stream; name="eicar.com"\r\nContent-Disposition: attachment; filename="eicar.com"\r\nContent-Transfer-Encoding: base64\r\n\r\n%s\r\n--sentora-%s--\r\n' \
        "$MAILADDR" "$RND" "$RND" "$RND" "$RND" "$b64" "$RND" > "$TMP/eicar.txt"
    # -v: the server's replies (curl itself only says "Weird server reply" for a refusal)
    local e; e=$(curl -v -sS --max-time 60 --mail-from "virus-test@example.com" --mail-rcpt "$MAILADDR" -T "$TMP/eicar.txt" "smtp://127.0.0.1:25" 2>&1)
    echo "$e" | grep -qiE '^< 5[0-9][0-9].*virus' && return 0
    WHY="the EICAR test message was not refused as a virus (server: $(echo "$e" | grep -E '^< [245][0-9][0-9] ' | tail -1 | cut -c3-90))"; return 1
}
s_spam() {
    need MAILADDR "Create a mailbox" || return $?
    [ -x /usr/sbin/spamd ] || { WHY="SpamAssassin is not installed"; return 2; }
    postconf -h smtpd_milters 2> /dev/null | grep -q spamass || { WHY="spam filtering is off"; return 2; }
    grep -q -- ' -r ' /etc/default/spamass-milter 2> /dev/null || { WHY="no reject score is set (Reject at score is 0)"; return 2; }
    # from this server's own address: mail from 127.0.0.1 is not checked for spam (on purpose)
    local ip; ip=$(hostname -I 2> /dev/null | awk '{print $1}')
    [ -n "$ip" ] || { WHY="this server has no address other than 127.0.0.1"; return 2; }
    printf 'From: spam-test@example.com\r\nTo: %s\r\nSubject: Sentora spam test %s\r\n\r\n%s\r\n' "$MAILADDR" "$RND" 'XJS*C4JDBQADN1.NSBN3*2IDNEN*GTUBE-STANDARD-ANTI-UBE-TEST-EMAIL*C.34X' > "$TMP/gtube.txt"
    local e; e=$(curl -v -sS --max-time 90 --mail-from "spam-test@example.com" --mail-rcpt "$MAILADDR" -T "$TMP/gtube.txt" "smtp://$ip:25" 2>&1)
    echo "$e" | grep -qiE '^< 5[0-9][0-9].*spam' && return 0
    WHY="the GTUBE test message was not refused as spam (server: $(echo "$e" | grep -E '^< [245][0-9][0-9] ' | tail -1 | cut -c3-90))"; return 1
}
s_sogo() {
    need MAILADDR "Create a mailbox" || return $?
    [ -x /usr/sbin/sogod ] || { WHY="SOGo is not installed"; return 2; }
    local c; c=$(pcurl -o /dev/null -w '%{http_code}' -H 'Content-Type: application/json' -d "{\"userName\":\"$MAILADDR\",\"password\":\"$MAILPW\",\"rememberLogin\":0}" "https://$FQDN/SOGo/connect")
    [ "$c" = 200 ] || { WHY="SOGo answered $c to the login"; return 1; }
}
s_mysql_create() {
    need LOGGED_IN "Log in to the panel as the client" || return $?
    pcurl -o /dev/null -d "inDatabase=db&csfr_token=$(token mysql_databases)" "https://$FQDN/?module=mysql_databases&action=CreateDatabase"
    DBNAME="${U}_db"
    local dbid; dbid=$(q "SELECT my_id_pk FROM x_mysql_databases WHERE my_name_vc='$DBNAME' AND my_deleted_ts IS NULL")
    [ -n "$dbid" ] || { DBNAME=""; WHY="the database was not made"; return 1; }
    pcurl -o "$TMP/p.html" -d "inUserName=usr&inDatabase=$dbid&inAccess=1&csfr_token=$(token mysql_users)" "https://$FQDN/?module=mysql_users&action=CreateUser"
    MYUSER="${U}_usr"
    MYPW=$(grep -o '<code[^>]*>[^<]*</code>' "$TMP/p.html" | head -1 | sed 's/<[^>]*>//g')
    [ -n "$MYPW" ] || { WHY="the MySQL user was made but its password was not shown"; return 1; }
}
s_mysql_login() {
    need MYPW "Create a database and MySQL user" || return $?
    local c="$TMP/my.cnf"; printf '[client]\nuser=%s\npassword=%s\n' "$MYUSER" "$MYPW" > "$c"; chmod 600 "$c"
    case "$H" in *:*) printf 'host=%s\nport=%s\n' "${H%%:*}" "${H##*:}" >> "$c" ;; esac
    local r; r=$(mysql --defaults-extra-file="$c" -N -B "$DBNAME" -e "CREATE TABLE smoke (id INT PRIMARY KEY, v VARCHAR(20)); INSERT INTO smoke VALUES (1,'$RND'); SELECT v FROM smoke" 2>&1)
    [ "$r" = "$RND" ] || { WHY="MySQL login with the shown password: $(echo "$r" | tail -1 | cut -c1-100)"; return 1; }
}
show_pw() { # module action field -> the password Show password returns
    pcurl -o "$TMP/s.html" -d "$3=1&inConfirmPw=$UPW&csfr_token=$(token "$1")" "https://$FQDN/?module=$1&action=$2"
    grep -o '<code[^>]*>[^<]*</code>' "$TMP/s.html" | head -1 | sed 's/<[^>]*>//g'
}
s_show_mysql() {
    need MYPW "Create a database and MySQL user" || return $?
    local id; id=$(q "SELECT mu_id_pk FROM x_mysql_users WHERE mu_name_vc='$MYUSER' AND mu_deleted_ts IS NULL")
    [ "$(show_pw mysql_users EditUser "inShow_$id")" = "$MYPW" ] || { WHY="Show password did not return the MySQL password"; return 1; }
}
s_show_ftp() {
    need FTPUSER "Create an FTP account" || return $?
    local id; id=$(q "SELECT ft_id_pk FROM x_ftpaccounts WHERE ft_user_vc='$FTPUSER' AND ft_deleted_ts IS NULL")
    [ "$(show_pw ftp_management EditFTP "inShow_$id")" = "$FTPPW" ] || { WHY="Show password did not return the FTP password"; return 1; }
}
s_backup() {
    need DOMDIR "Add a domain" || return $?
    BACKUP=$(php_panel 'echo sys_backup::Create((int) $argv[1], $argv[2]);' "$ACC_ID" "$U" | tail -1)
    [ -f "$BACKUP" ] || { BACKUP=""; WHY="no backup was made"; return 1; }
    unzip -Z1 "$BACKUP" | grep -q "index.php" || { WHY="the backup has no web files"; return 1; }
    [ -z "$MYPW" ] || unzip -Z1 "$BACKUP" | grep -q "^${DBNAME}_.*\.sql$" || { WHY="the backup has no database dump"; return 1; }
    [ "$(stat -c '%U' "$BACKUP")" = "$WEBU" ] || { WHY="the backup is not owned by $WEBU (its FTP login could not download it)"; return 1; }
}
s_restore() {
    need BACKUP "Back up the account" || return $?
    [ -x "$PANEL/bin/sentora-restore" ] || { WHY="sentora-restore is not installed"; return 2; }
    rm -f "$HOSTED/$U/public_html${DOMDIR}/index.php"
    [ -n "$MYPW" ] && q "DELETE FROM \`$DBNAME\`.smoke"
    "$PANEL/bin/sentora-restore" "$U" "$BACKUP" --yes > "$TMP/restore.log" 2>&1 || { WHY="sentora-restore failed: $(tail -1 "$TMP/restore.log" | sed 's/\x1b\[[0-9;]*m//g' | cut -c1-100)"; return 1; }
    [ -f "$HOSTED/$U/public_html${DOMDIR}/index.php" ] || { WHY="the web file was not restored"; return 1; }
    [ -z "$MYPW" ] || [ "$(q "SELECT COUNT(*) FROM \`$DBNAME\`.smoke")" = 1 ] || { WHY="the database rows were not restored"; return 1; }
    [ "$(stat -c '%U' "$HOSTED/$U/public_html${DOMDIR}/index.php")" = "$WEBU" ] || { WHY="the restored file is not owned by $WEBU"; return 1; }
}
s_isolation() {
    need WEBU "Create a test client" || return $?
    local other; other=$(q "SELECT ac_user_vc FROM x_accounts WHERE ac_deleted_ts IS NULL AND ac_id_pk <> $ACC_ID ORDER BY ac_id_pk LIMIT 1")
    [ -n "$other" ] && [ -d "$HOSTED/$other" ] || { WHY="no other account folder to test against"; return 2; }
    as() { setpriv --reuid="$WEBU" --regid="$(id -g "$WEBU")" --init-groups ls "$1" > /dev/null 2>&1; }
    as "$HOSTED/$U" || { WHY="$WEBU can not open its own folder"; return 1; }
    as "$HOSTED/$other" && { WHY="$WEBU can read $other's folder"; return 1; }
    return 0
}
s_cleanup() {
    [ $KEEP -eq 1 ] && { cleanup; WHY="--keep given"; return 2; }
    cleanup
    [ -z "$ACC_ID" ] && return 0
    [ "$(q "SELECT COUNT(*) FROM x_accounts WHERE ac_id_pk=$ACC_ID AND ac_deleted_ts IS NULL")" = 0 ] || { WHY="the test client is still there"; return 1; }
    [ ! -d "$HOSTED/$U" ] || { WHY="$HOSTED/$U is still there"; return 1; }
}

# --- run ----------------------------------------------------------------------------------------
out "${B}Sentora smoke test${N}, $(date '+%Y-%m-%d %H:%M %Z') on ${FQDN:-?}: test client $U, domain $DOM"
out ""
trap 'echo; out "  Interrupted: removing what the test made"; KEEP=0; cleanup; exit 1' INT TERM
step "Panel answers over HTTPS" s_panel
step "Create a test client (panel code)" s_client
step "Log in to the panel as the client" s_login
step "Add a domain" s_domain
step "Daemon run completes without warnings" s_daemon
step "Account user, folder and PHP pool" s_account
step "Create an FTP account (hashed)" s_ftp_create
step "Upload a page over FTPS" s_ftp_upload
step "Website serves the page" s_web
step "PHP runs as the account's own user" s_php_user
step "Site .htaccess can not use the panel's PHP or status" s_htaccess_guard
step "Create a mailbox (SHA-512 crypt)" s_mailbox
step "IMAP login (993)" s_imap
step "Send mail with login (SMTP 587)" s_smtp
step "Mail delivered to the mailbox" s_delivered
step "A virus is refused (ClamAV)" s_virus
step "Obvious spam is refused (SpamAssassin)" s_spam
step "SOGo login" s_sogo
step "Create a database and MySQL user" s_mysql_create
step "MySQL login with the shown password" s_mysql_login
step "Show password: MySQL user" s_show_mysql
step "Show password: FTP account" s_show_ftp
step "Back up the account" s_backup
step "Restore the account from the backup" s_restore
step "Isolation from other accounts" s_isolation
trap - INT TERM
finish
